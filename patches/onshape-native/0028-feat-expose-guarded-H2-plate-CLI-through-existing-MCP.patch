+def test_configure_can_pin_existing_compatible_h2_python_without_changing_pairing(tmp_path, monkeypatch):
+    module = script("configure")
+    source = tmp_path / "native source"
+    (source / "extension").mkdir(parents=True)
+    default = venv_python(source / ".venv")
+    default.parent.mkdir(parents=True)
+    default.touch()
+    runtime = tmp_path / "private runtime"
+    first = module.configure(source, runtime=runtime)
+    token = json.loads((runtime / "bridge.json").read_text())["token"]
+    selected = tmp_path / "x64 h2" / "python.exe"
+    selected.parent.mkdir()
+    selected.touch()
+    seen = []
+    def probe(args, **kwargs):
+        seen.append(args)
+        return type("Result", (), {"returncode": 0})()
+    monkeypatch.setattr(module.subprocess, "run", probe)
+    changed = module.configure(source, runtime=runtime, mcp_python=selected)
+    assert changed["mcpServers"]["onshape_native"]["command"] == str(selected)
+    assert seen[0][0] == str(selected) and "OCP.BRepPrimAPI" in seen[0][2]
+    assert json.loads((runtime / "bridge.json").read_text())["token"] == token
+    assert first["mcpServers"]["onshape_native"]["command"] == str(default)
+    with pytest.raises(ValueError, match="absolute"):
+        module.configure(source, runtime=runtime, mcp_python=Path("relative/python.exe"))
+
