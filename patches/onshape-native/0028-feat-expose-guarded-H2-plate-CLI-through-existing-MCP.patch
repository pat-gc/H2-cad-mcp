@@ -0,0 +1,110 @@
+"""The experimental MCP entry point delegates to the installed H2 CLI once."""
+
+import json
+import pytest
+
+from onshape_native import server
+from onshape_native.client import OnshapeError
+
+
+URL = "https://cad.onshape.com/documents/4e078dec822b4e509616b1cb/w/af0627de07264acf086e646a/e/3a4e8933dde1c594115a657f"
+TARGET = {"did": "4e078dec822b4e509616b1cb", "wid": "af0627de07264acf086e646a",
+          "eid": "3a4e8933dde1c594115a657f"}
+VALID_RECEIPT = {"status": "native_definitions_observed", "target": TARGET,
+                 "local_validation": {"status": "passed"}, "begin_sketch": {},
+                 "sketch": {}, "begin_extrude": {}, "extrude": {}}
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("exit_code", [0, 1])
+async def test_h2_mcp_delegates_exact_target_to_one_existing_cli_command(tmp_path, monkeypatch, exit_code):
+    source = tmp_path / "plate.fs"
+    source.write_text("source is validated by H2")
+    journal = tmp_path / "intent.sqlite"
+    journal.touch()
+    monkeypatch.setattr(server, "native_target", lambda url: TARGET if url == URL else pytest.fail("wrong URL"))
+    monkeypatch.setattr(server, "load_config", lambda: {"h2cad_journal": str(journal)})
+    monkeypatch.setattr(server, "runtime_dir", lambda: tmp_path)
+    monkeypatch.setattr(server.importlib.util, "find_spec", lambda name: object() if name == "h2cad" else None)
+    calls = []
+
+    class Process:
+        returncode = exit_code
+
+        async def communicate(self):
+            return (json.dumps(VALID_RECEIPT).encode(),
+                    b"h2cad: operation outcome unknown; journal operation begin-sketch-test" if exit_code else b"")
+
+    async def launch(*args, **kwargs):
+        calls.append((args, kwargs))
+        return Process()
+
+    monkeypatch.setattr(server.asyncio, "create_subprocess_exec", launch)
+    result = json.loads(await server.experimental_h2_create_plate(URL, str(source), 17))
+    assert len(calls) == 1
+    args, kwargs = calls[0]
+    assert args == (server.sys.executable, "-m", "h2cad", "experimental-create-plate", str(source),
+                    "--did", TARGET["did"], "--wid", TARGET["wid"], "--eid", TARGET["eid"],
+                    "--tab-id", "17", "--bridge-config", str(tmp_path / "bridge.json"),
+                    "--journal", str(journal))
+    assert kwargs["stdout"] == kwargs["stderr"] == server.asyncio.subprocess.PIPE
+    if exit_code:
+        assert result["status"] == "needs_readback"
+        assert result["no_automatic_retry"] is True
+        assert "journal operation" in result["error"]
+    else:
+        assert result["status"] == "h2_command_completed"
+        assert result["result"]["status"] == "native_definitions_observed"
+        assert result["solid_geometry_verified"] is False
+        assert result["ui_editability_verified"] is False
+
+
+@pytest.mark.asyncio
+async def test_h2_mcp_rejects_missing_pinned_journal_before_launch(tmp_path, monkeypatch):
+    source = tmp_path / "plate.fs"
+    source.write_text("source")
+    monkeypatch.setattr(server, "native_target", lambda url: TARGET)
+    monkeypatch.setattr(server, "load_config", lambda: {})
+    async def forbidden(*args, **kwargs):
+        pytest.fail("no CLI or modeling send before journal preflight")
+    monkeypatch.setattr(server.asyncio, "create_subprocess_exec", forbidden)
+    with pytest.raises(OnshapeError, match="pin an existing H2 journal"):
+        await server.experimental_h2_create_plate(URL, str(source), 17)
+
+
+@pytest.mark.asyncio
+async def test_h2_mcp_refuses_relative_source_before_bridge_or_cli(monkeypatch):
+    monkeypatch.setattr(server, "native_target", lambda url: TARGET)
+    monkeypatch.setattr(server, "load_config", lambda: pytest.fail("no bridge configuration read"))
+    with pytest.raises(OnshapeError, match="existing local .fs file"):
+        await server.experimental_h2_create_plate(URL, "relative.fs", 17)
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("receipt", [b"not json", b"null", b"[]", b"{}",
+    b'{"status":"native_definitions_observed"}',
+    b'{"status":"failed","target":{}}',
+    json.dumps({**VALID_RECEIPT, "target": {**TARGET, "eid": "wrong"}}).encode(),
+    json.dumps({**VALID_RECEIPT, "status": "failed"}).encode()])
+async def test_h2_mcp_never_confirms_malformed_completion_or_replays(tmp_path, monkeypatch, receipt):
+    source = tmp_path / "plate.fs"
+    source.write_text("source")
+    journal = tmp_path / "intent.sqlite"
+    journal.touch()
+    monkeypatch.setattr(server, "native_target", lambda url: TARGET)
+    monkeypatch.setattr(server, "load_config", lambda: {"h2cad_journal": str(journal)})
+    monkeypatch.setattr(server, "runtime_dir", lambda: tmp_path)
+    monkeypatch.setattr(server.importlib.util, "find_spec", lambda name: object())
+    calls = []
+    class Process:
+        returncode = 0
+        async def communicate(self):
+            return receipt, b""
+    async def launch(*args, **kwargs):
+        calls.append(args)
+        return Process()
+    monkeypatch.setattr(server.asyncio, "create_subprocess_exec", launch)
+    result = json.loads(await server.experimental_h2_create_plate(URL, str(source), 17))
+    assert result["status"] == "needs_readback"
+    assert result["no_automatic_retry"] is True
+    assert len(calls) == 1
