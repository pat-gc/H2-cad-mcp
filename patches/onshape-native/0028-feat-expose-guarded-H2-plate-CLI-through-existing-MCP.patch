+@mcp.tool(structured_output=False, annotations=WRITE)
+async def experimental_h2_create_plate(url: str, source_path: str, tab_id: int) -> str:
+    """Experimental: run H2's local FSGen validation and guarded native Sketch/Extrude sequence once in an explicitly configured empty test Part Studio. Requires h2cad and FSGen in this MCP server's Python environment, a pinned H2 journal and create target in the paired bridge config. No REST fallback. A timeout or failed command requires journal/readback reconciliation before any new attempt; the result alone does not prove solid geometry or UI editability."""
+    target = native_target(url)
+    if type(tab_id) is not int or tab_id < 0:
+        raise OnshapeError("Supply the exact connected editor tab ID.")
+    try:
+        if not Path(source_path).is_absolute():
+            raise ValueError("source path is not absolute")
+        source = Path(source_path).resolve(strict=True)
+    except (OSError, ValueError) as exc:
+        raise OnshapeError("Source must be an existing local .fs file.") from exc
+    if not source.is_file() or source.suffix.lower() != ".fs" or source.stat().st_size > 1024 * 1024:
+        raise OnshapeError("Source must be a local .fs file no larger than 1 MiB.")
+    config = load_config()
+    journal_name = config.get("h2cad_journal")
+    if (not isinstance(journal_name, str) or not Path(journal_name).is_absolute()
+            or not Path(journal_name).is_file()):
+        raise OnshapeError("The paired bridge must pin an existing H2 journal before native creation.")
+    if importlib.util.find_spec("h2cad") is None:
+        raise OnshapeError("Install H2 CAD with pinned FSGen into this MCP server's Python environment.")
+    command = (sys.executable, "-m", "h2cad", "experimental-create-plate", str(source),
+               "--did", target["did"], "--wid", target["wid"], "--eid", target["eid"],
+               "--tab-id", str(tab_id), "--bridge-config", str(runtime_dir() / "bridge.json"),
+               "--journal", journal_name)
+    process = await asyncio.create_subprocess_exec(*command, stdout=asyncio.subprocess.PIPE,
+                                                   stderr=asyncio.subprocess.PIPE)
+    output, error = await process.communicate()
+    if process.returncode != 0:
+        return compact({"status": "needs_readback", "experimental": True,
+                        "exit_code": process.returncode,
+                        "error": error.decode("utf-8", "replace")[:2000],
+                        "no_automatic_retry": True})
+    try:
+        result = json.loads(output)
+    except (UnicodeDecodeError, json.JSONDecodeError):
+        return compact({"status": "needs_readback", "experimental": True,
+                        "reason": "H2 command completed without a valid JSON receipt",
+                        "no_automatic_retry": True})
+    if (not isinstance(result, dict) or result.get("status") != "native_definitions_observed"
+            or result.get("target") != target
+            or not isinstance(result.get("local_validation"), dict)
+            or result["local_validation"].get("status") != "passed"
+            or any(not isinstance(result.get(key), dict)
+                   for key in ("begin_sketch", "sketch", "begin_extrude", "extrude"))):
+        return compact({"status": "needs_readback", "experimental": True,
+                        "reason": "H2 command returned an unexpected completion receipt",
+                        "no_automatic_retry": True})
+    return compact({"status": "h2_command_completed", "experimental": True,
+                    "result": result, "solid_geometry_verified": False,
+                    "ui_editability_verified": False})
+
+
