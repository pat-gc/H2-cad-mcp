diff --git a/extension/connection.js b/extension/connection.js
index d67d5a0..3fab527 100644
--- a/extension/connection.js
+++ b/extension/connection.js
@@ -15,7 +15,11 @@ export function createConnection({browser, token, execute, Socket = WebSocket,
     job.target ? `target:${job.target.did}/${job.target.wid}/${job.target.eid}` : `kind:${job.kind}`;
   async function boundedRead(job) {
     const key = readKey(job);
-    const pending = Promise.resolve().then(() => execute(job));
+    let phase = 'extension_received';
+    const started = now();
+    const pending = Promise.resolve().then(() => execute(job, value => {
+      if (['tab_lookup', 'page_script', 'page_reply', 'response_transfer'].includes(value)) phase = value;
+    }));
     const timeoutMs = job.kind === 'editor_tab' ? 10000 + Math.min(30, job.wait_seconds || 0) * 1000 : 10000;
     let timer, timedOut = false, settled = false;
     pending.then(() => { settled = true; if (timedOut) orphanedReads.delete(key); },
@@ -27,7 +31,8 @@ export function createConnection({browser, token, execute, Socket = WebSocket,
         timedOut = true;
         if (!settled) orphanedReads.add(key);
         return {error:'Read-only editor command timed out. The original page task may still be running; no command was replayed.',
-          outcome:'Use another exact tab for read-only inspection. Writes remain paused until the page task settles or the extension is reloaded.'};
+          outcome:'Use another exact tab for read-only inspection. Writes remain paused until the page task settles or the extension is reloaded.',
+          read_phase:phase, elapsed_ms:Math.max(0, now() - started)};
       }
       return outcome.value;
     } finally { timers.clearTimeout(timer); }
diff --git a/extension/page-adapter.js b/extension/page-adapter.js
index 633fc68..a5ceebb 100644
--- a/extension/page-adapter.js
+++ b/extension/page-adapter.js
@@ -162,11 +162,19 @@ export async function pageCommand(job) {
   }
   // The serializer registry includes nested types absent from the public barrel,
   // e.g. partstudio.GBTPSOIdentity in material and assembly insertion payloads.
-  const registry = require(profile.registry)?.E15;
-  const constructors = new Map();
-  for (const value of [...Object.values(classes), ...Object.values(registry || {})]) {
-    if (typeof value !== "function" || typeof value.prototype?.getMessageName !== "function") continue;
-    try { constructors.set(value.prototype.getMessageName(), value); } catch { /* not a message */ }
+  let constructors;
+  function runtimeConstructors() {
+    if (constructors) return constructors;
+    // Native state/health needs the model tree, not serializer discovery. Keep
+    // registry access off those reads, especially while the editor reconnects.
+    const registry = require(profile.registry)?.E15;
+    const found = new Map();
+    for (const value of [...Object.values(classes), ...Object.values(registry || {})]) {
+      if (typeof value !== "function" || typeof value.prototype?.getMessageName !== "function") continue;
+      try { found.set(value.prototype.getMessageName(), value); } catch { /* not a message */ }
+    }
+    constructors = found;
+    return found;
   }
 
   function plain(value, seen = new WeakSet(), depth = 0, budget = null) {
@@ -196,7 +204,7 @@ export async function pageCommand(job) {
     if (Array.isArray(value)) return value.map(v => hydrate(v, depth + 1));
     let result = Object.create(null);
     if (value.$type) {
-      const Type = constructors.get(value.$type);
+      const Type = runtimeConstructors().get(value.$type);
       if (!Type) throw new Error(`Unknown native type: ${value.$type}`);
       result = new Type();
     }
@@ -321,7 +329,7 @@ export async function pageCommand(job) {
     return {dispatched:true, action:job.action, verification:"Inspect again; dispatch does not prove the application accepted a synthetic event."};
   }
   if (job.kind === "schema") {
-    const Type = constructors.get(job.name);
+    const Type = runtimeConstructors().get(job.name);
