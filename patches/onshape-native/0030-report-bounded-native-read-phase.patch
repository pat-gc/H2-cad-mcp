diff --git a/tests/test_read_phase.py b/tests/test_read_phase.py
new file mode 100644
index 0000000..aa2c816
--- /dev/null
+++ b/tests/test_read_phase.py
@@ -0,0 +1,23 @@
+"""Read timeout diagnostics retain only bounded extension phase metadata."""
+
+import httpx
+import pytest
+
+from onshape_native import client
+
+
+@pytest.mark.asyncio
+async def test_mcp_client_preserves_read_phase_without_repeating_command(monkeypatch, tmp_path):
+    monkeypatch.setattr(client, "load_config", lambda: {"port": 8766, "token": "x" * 32})
+    calls = []
+    def reply(request):
+        calls.append(request.url.path)
+        return httpx.Response(200, json={"error": "Read-only editor command timed out.",
+                                         "read_phase": "page_script", "elapsed_ms": 10000})
+    transport = client.Client(client.Settings(cache_dir=tmp_path), httpx.MockTransport(reply))
+    try:
+        with pytest.raises(client.OnshapeError, match=r"read_phase=page_script, elapsed_ms=10000"):
+            await transport.command({"kind": "state", "target": {"eid": "a" * 24}})
+    finally:
+        await transport.close()
+    assert calls == ["/command"]
