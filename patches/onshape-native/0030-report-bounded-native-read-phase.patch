     return bounded({name: job.name, defaults: plain(new Type()), classId: new Type().getClassId()});
   }
@@ -330,7 +338,7 @@ export async function pageCommand(job) {
     // enumeration hung in a live editor, so no controller traversal runs here.
     const constructorsToCheck = ["bsedit.GBTMSketch", "bsedit.GBTMFeature", "bsedit.GBTMParameterQueryList"];
     const generatedNodes = Object.fromEntries(constructorsToCheck.map(name => {
-      const Type = constructors.get(name);
+      const Type = runtimeConstructors().get(name);
       if (!Type) return [name, {available:false}];
       const first = new Type(), second = new Type();
       return [name, {available:true, unique_node_ids:typeof first.nodeId === "string" &&
@@ -957,7 +965,7 @@ export async function pageCommand(job) {
     "ui.assembly.GBTUiAssemblyTreeItemDefinitionRequest"]);
   // Additional commands are allowed only when exported by the captured client
   // schema and present in the running serializer. Catalog labels them untested.
-  if (!allowed.has(job.command) && (!job.command.includes("GBTUi") || !constructors.has(job.command) || /Response|Notification|DisplayData|ComputedData/.test(job.command))) {
+  if (!allowed.has(job.command) && (!job.command.includes("GBTUi") || !runtimeConstructors().has(job.command) || /Response|Notification|DisplayData|ComputedData/.test(job.command))) {
     throw new Error("Native command is absent from the runtime schema.");
   }
   const revisionMatches = job.expected_element_microversion
@@ -968,7 +976,7 @@ export async function pageCommand(job) {
   }
   if (job.body?.elementId && job.body.elementId !== target.eid) throw new Error("Body elementId differs from target.");
   if (controller.connection?.isClosed?.() === true) throw new Error("Onshape editor is disconnected. Reconnect the exact tab before sending native commands; nothing was sent.");
-  const Type = constructors.get(job.command);
+  const Type = runtimeConstructors().get(job.command);
   if (!Type) throw new Error("Native command type unavailable.");
   const typedBody = {...job.body, $type: job.command};
   if (Object.hasOwn(new Type(), "elementId")) typedBody.elementId = target.eid;
diff --git a/extension/worker.js b/extension/worker.js
index 2f56008..bc69f55 100644
--- a/extension/worker.js
+++ b/extension/worker.js
@@ -26,19 +26,23 @@ async function resolveTab(job) {
   return loadedSessionTab(tabs, job.tab_id);
 }
 
-async function execute(job) {
+async function execute(job, reportPhase = () => {}) {
   if (job.kind === "rest" && job.method === "GET") return restGet(job);
   if (job.kind === "open") return editors.open(job);
   if (job.kind === "editor_tab") return editors.control(job);
   if (job.kind === "tabs") {
     return tabContext(chrome);
   }
+  reportPhase('tab_lookup');
   const tab = await resolveTab(job);
+  reportPhase('page_script');
   const results = await chrome.scripting.executeScript({target: {tabId: tab.id}, world: "MAIN",
     func: job.kind === "viewer_mesh" ? viewerMesh : job.kind === "display" ? displayCommand : pageCommand, args: [{...job, chunk_response:true}]});
+  reportPhase('page_reply');
   if (results.length !== 1 || results[0].result === undefined) throw new Error("Page command failed or tab navigated; inspect state before retrying.");
   let result = results[0].result;
   if (result.response_transfer) {
+    reportPhase('response_transfer');
     if (!Number.isSafeInteger(result.length) || result.length < 0 || result.length > 512 * 1024 * 1024)
       throw new Error('Invalid response transfer size.');
     const chunks = []; let offset = 0;
