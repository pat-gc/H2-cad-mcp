+import copy
+import json
+import sqlite3
+from pathlib import Path
+
+import httpx
+import pytest
+from onshape_native.source_sketch import verify_saved_sketch
+from onshape_native.bridge import create_app
+
+TARGET={"did":"4e078dec822b4e509616b1cb","wid":"af0627de07264acf086e646a","eid":"e"*24}
+OP="source-sketch-"+"a"*32
+PLANS=json.loads((Path(__file__).parent/"fixtures/source_sketch_plans.json").read_text())
+
+
+def states(name="Chassis sketch"):
+    plan=copy.deepcopy(PLANS[name])
+    before={"target":TARGET,"connected":True,"editingFeatureId":"sketch_0","element_microversion":"a"*24,
+            "tree":{"$type":"bsedit.GBTMModel","children":[{"featureType":"cPlane","featureId":"plane_0","nodeId":"plane-node"},
+                {"featureType":"newSketch","featureId":"sketch_0","nodeId":"sketch-node","parameters":[{"parameterId":"sketchPlane","value":"bound-plane"}],"entities":[],"constraints":[]},
+                {"nodeId":"rollback"}]}}
+    after=copy.deepcopy(before);after.update(editingFeatureId=None,element_microversion="b"*24)
+    number=0
+    def allocate(x):
+        nonlocal number
+        if isinstance(x,list):return [allocate(v) for v in x]
+        if not isinstance(x,dict):return x
+        out={k:allocate(v) for k,v in x.items()}
+        if str(x.get("$type","")).startswith("bsedit.GBTM"):
+            number+=1;out["nodeId"]=f"fresh-{number}"
+        if str(x.get("$type","")).startswith("bsedit.GBTMSketch"):out["index"]=number
+        return out
+    after["tree"]["children"][1].update(entities=allocate(plan["entities"]),constraints=allocate(plan["constraints"]))
+    graph={"$type":"ui.sketch.GBTUiSketchGetConstraintGraphResponse","worstSolveStatus":1,"sketchError":{"statusEnum":0},"constraints":{},"references":{}}
+    for ident,c in plan["graph_constraints"].items():graph["constraints"][ident]={"type":c["type"],"status":4,"displayStatus":1,"isExternal":False,"driven":False,"referenceIds":c["references"]}
+    for ident,xyz in plan["graph_anchors"].items():graph["references"][ident]={"isSketchEntity":True,"worstSolveStatus":1,"anchorX":xyz[0],"anchorY":xyz[1],"anchorZ":xyz[2]}
+    for c in plan["graph_circles"]:
+        center=graph["references"][c["center_id"]]
+        graph["references"][c["entity_id"]]={**center,"anchorX":center["anchorX"]-c["radius"]}
+    receipt={"op_id":OP,"feature_id":"sketch_0","definition_candidate":True,"active_constraint_graph":graph}
+    return before,after,plan,receipt
+
+
+@pytest.mark.parametrize("name",list(PLANS))
+@pytest.mark.parametrize("fault",[None,"coordinates","expression","entity_type","reused_id","missing_id","duplicate_id","unrelated","plane","busy","stale","constraint","graph_refs"])
+def test_source_sketch_proof_requires_geometry_definition_identity_and_graph(name,fault):
+    before,after,plan,receipt=states(name)
+    node=after["tree"]["children"][1]
+    if fault=="coordinates":receipt["active_constraint_graph"]["references"]["h2.localOrigin"]["anchorX"]=1
+    if fault=="expression":next(p for c in node["constraints"] for p in c["parameters"] if p["parameterId"]=="length")["expression"]="999 mm"
+    if fault=="entity_type":node["entities"][0]["$type"]="bsedit.GBTMSketchCurve"
+    if fault=="reused_id":node["entities"][0]["nodeId"]="sketch-node"
+    if fault=="missing_id":del node["entities"][0]["nodeId"]
+    if fault=="duplicate_id":node["entities"][1]["nodeId"]=node["entities"][0]["nodeId"]
+    if fault=="unrelated":after["tree"]["children"][-1]["nodeId"]="changed"
+    if fault=="plane":node["parameters"][0]["value"]="another-plane"
+    if fault=="busy":after["editingFeatureId"]="sketch_0"
+    if fault=="stale":after["element_microversion"]=before["element_microversion"]
+    if fault=="constraint":node["constraints"][0]["constraintType"]=1
+    if fault=="graph_refs":receipt["active_constraint_graph"]["constraints"]["h2.fixedOrigin"]["referenceIds"]=["other"]
+    if fault:
+        with pytest.raises(ValueError):verify_saved_sketch(before,after,TARGET,plan,receipt)
+    else:
+        proof=verify_saved_sketch(before,after,TARGET,plan,receipt)
+        assert proof["constraint_graph_verified"] and proof["saved_feature"]==node
+        assert proof["generated_node_ids"]
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("fault",[None,"graph","unrelated","other_pending","retirement","unstable"])
+async def test_source_sketch_reconciliation_retains_barrier_until_exact_proof(tmp_path,fault):
+    before,after,plan,receipt=states()
+    if fault=="graph":receipt["active_constraint_graph"]["references"]["h2.localOrigin"]["anchorX"]=1
+    if fault=="unrelated":after["tree"]["children"][-1]["nodeId"]="changed"
+    journal=tmp_path/"intent.sqlite"
+    intent={"before_state":before,"plan":plan,"source_feature":{"name":plan["logical_id"]},"plane_op_id":"plane-op","variable_op_ids":{}}
+    with sqlite3.connect(journal) as db:
+        db.execute("CREATE TABLE writes(op_id TEXT,target TEXT,expected_revision TEXT,action TEXT,logical_id TEXT,intent TEXT,state TEXT,receipt TEXT,observation TEXT,error TEXT,updated_at TEXT)")
+        db.execute("INSERT INTO writes(op_id,target,action,logical_id,state)VALUES(?,?,?,?,?)",("plane-op","/".join(TARGET.values()),"experimental_plane_populate",plan["plane_logical_id"],"observed"))
+        db.execute("INSERT INTO writes(op_id,target,expected_revision,action,logical_id,intent,state,receipt)VALUES(?,?,?,?,?,?,?,?)",(OP,"/".join(TARGET.values()),before["element_microversion"],"experimental_source_sketch_populate",plan["logical_id"],json.dumps(intent),"sent",json.dumps(receipt)))
+        if fault=="other_pending":db.execute("INSERT INTO writes(op_id,state)VALUES('other','unknown')")
+    token="a"*32
+    app=create_app({"token":token,"port":8766,"h2cad_journal":str(journal),"h2cad_create_target":TARGET})
+    broker=app.state.broker;broker.unknown_write=True;broker.extension=object();broker.extension_info={"capabilities":["h2_source_sketch_page_v1"]}
+    calls=[]
+    async def dispatch(job):
+        assert job["kind"]=="state";calls.append(job);live=copy.deepcopy(after)
+        if job.get("retire_acknowledged_op_id"):
+            live["marker_retirement"]={"op_id":OP,"status":"blocked" if fault=="retirement" else "absent"}
+            if fault=="unstable":live["element_microversion"]="c"*24
+        return live
+    broker.dispatch=dispatch
+    async with httpx.AsyncClient(transport=httpx.ASGITransport(app),base_url="http://127.0.0.1:8766",headers={"Authorization":"Bearer "+token}) as client:
+        response=await client.post("/local/reconcile_saved_source_sketch",json={"op_id":OP,"tab_id":7})
+    assert response.status_code==(409 if fault else 200),response.text
+    assert broker.unknown_write is bool(fault)
+    if fault in {"graph","unrelated","other_pending"}:assert len(calls)==1
+    with sqlite3.connect(journal) as db:assert db.execute("SELECT state FROM writes WHERE op_id=?",(OP,)).fetchone()[0]==("sent" if fault else "observed")
