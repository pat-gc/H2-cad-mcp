diff --git a/onshape_native/source_sketch.py b/onshape_native/source_sketch.py
new file mode 100644
index 0000000..4c4c37f
--- /dev/null
+++ b/onshape_native/source_sketch.py
@@ -0,0 +1,105 @@
+"""Independent proof for source-driven native sketches, never a write transport."""
+import copy
+import math
+import re
+
+
+def same_definition(actual, expected):
+    if isinstance(expected, dict):
+        return isinstance(actual, dict) and actual.keys() == expected.keys() and all(same_definition(actual[k], v) for k,v in expected.items())
+    if isinstance(expected, list):
+        return isinstance(actual, list) and len(actual) == len(expected) and all(same_definition(a,b) for a,b in zip(actual,expected))
+    if type(expected) in (int, float):
+        return type(actual) in (int, float) and math.isfinite(actual) and math.isclose(actual, expected, rel_tol=0, abs_tol=1e-10)
+    return type(actual) is type(expected) and actual == expected
+
+
+def _generated_definition(value, ids):
+    if isinstance(value, list):
+        return [_generated_definition(v, ids) for v in value]
+    if not isinstance(value, dict):
+        return value
+    node_id = value.get("nodeId")
+    if str(value.get("$type", "")).startswith("bsedit.GBTM") and not node_id:
+        raise ValueError("Generated native sketch node identity missing")
+    if "nodeId" in value:
+        if not isinstance(node_id, str) or not node_id or node_id in ids:
+            raise ValueError("Generated sketch node identities are absent or duplicated")
+        ids.add(node_id)
+    ignored = {"nodeId"}
+    if value.get("$type") in {"bsedit.GBTMSketchPoint", "bsedit.GBTMSketchCurve",
+                              "bsedit.GBTMSketchCurveSegment", "bsedit.GBTMSketchConstraint"}:
+        ignored.add("index")  # Observed solver-assigned display numbering.
+    return {k:_generated_definition(v,ids) for k,v in value.items() if k not in ignored}
+
+
+def verify_graph(graph, plan):
+    actual = graph.get("constraints", {})
+    if (graph.get("$type") != "ui.sketch.GBTUiSketchGetConstraintGraphResponse"
+            or graph.get("worstSolveStatus") != 1 or graph.get("sketchError", {}).get("statusEnum") != 0
+            or not isinstance(actual, dict) or set(actual) != set(plan["graph_constraints"])):
+        raise ValueError("Active sketch solver graph incomplete")
+    for ident, wanted in plan["graph_constraints"].items():
+        node = actual[ident]
+        if (node.get("type") != wanted["type"] or node.get("status") != 4 or node.get("displayStatus") != 1
+                or node.get("isExternal") is not False or node.get("driven") is not False
+                or sorted(node.get("referenceIds", [])) != sorted(wanted["references"])):
+            raise ValueError("Active sketch constraint status or references differ")
+    refs = graph.get("references", {})
+    for ident, expected in plan["graph_anchors"].items():
+        node = refs.get(ident, {})
+        if node.get("isSketchEntity") is not True or node.get("worstSolveStatus") != 1:
+            raise ValueError("Source sketch point is not fully solved")
+        for key, value in zip(("anchorX","anchorY","anchorZ"), expected):
+            if type(node.get(key)) not in (int,float) or not math.isclose(node[key], value, rel_tol=0, abs_tol=1e-8):
+                raise ValueError("Solved sketch point differs from source coordinates")
+    for circle in plan["graph_circles"]:
+        node, center = refs.get(circle["entity_id"], {}), refs[circle["center_id"]]
+        if (node.get("isSketchEntity") is not True or node.get("worstSolveStatus") != 1
+                or any(type(node.get(k)) not in (int,float) for k in ("anchorX","anchorY","anchorZ"))
+                or not math.isclose(math.dist([node[k] for k in ("anchorX","anchorY","anchorZ")],
+                                              [center[k] for k in ("anchorX","anchorY","anchorZ")]),
+                                    circle["radius"], rel_tol=0, abs_tol=1e-8)):
+            raise ValueError("Solved circle radius differs from source")
+
+
+def verify_saved_sketch(before, after, target, plan, receipt):
+    from .bridge import _tab_tolerance_node_normalized
+    fid = before.get("editingFeatureId")
+    if (before.get("target") != target or after.get("target") != target or not fid
+            or before.get("connected") is not True or after.get("connected") is not True
+            or after.get("editingFeatureId") is not None
+            or not re.fullmatch(r"[a-f0-9]{24}", str(after.get("element_microversion", "")))
+            or after.get("element_microversion") == before.get("element_microversion")):
+        raise ValueError("Exact saved idle source sketch required")
+    old = [n for n in before["tree"]["children"] if n.get("featureId") == fid]
+    new = [n for n in after["tree"]["children"] if n.get("featureId") == fid]
+    if (len(old) != 1 or len(new) != 1 or old[0].get("featureType") != "newSketch"
+            or old[0].get("entities") != [] or old[0].get("constraints") != []
+            or new[0].get("nodeId") != old[0].get("nodeId")):
+        raise ValueError("Source sketch allocation identity changed")
+    ids = set()
+    for field in ("entities", "constraints"):
+        if not same_definition(_generated_definition(new[0].get(field), ids), plan[field]):
+            raise ValueError("Saved source sketch definition differs")
+    def collect(value):
+        if isinstance(value, dict):
+            if value.get("nodeId"): yield value["nodeId"]
+            for v in value.values(): yield from collect(v)
+        elif isinstance(value, list):
+            for v in value: yield from collect(v)
+    if ids.intersection(collect(before["tree"])):
+        raise ValueError("Generated sketch reused an existing native node identity")
+    expected = copy.deepcopy(before["tree"])
+    expected["children"][before["tree"]["children"].index(old[0])] = {
+        **old[0], "entities": new[0]["entities"], "constraints": new[0]["constraints"]}
+    if _tab_tolerance_node_normalized(expected) != _tab_tolerance_node_normalized(after["tree"]):
+        raise ValueError("Source sketch metadata, plane or unrelated feature tree changed")
+    if receipt.get("feature_id") != fid or receipt.get("definition_candidate") is not True:
+        raise ValueError("Matching source sketch receipt required")
+    verify_graph(receipt.get("active_constraint_graph", {}), plan)
+    return {"feature_id": fid, "node_id": new[0]["nodeId"], "logical_id": plan["logical_id"],
+            "revision_before": before["element_microversion"], "revision_after": after["element_microversion"],
+            "definition_observed": True, "constraint_graph_verified": True, "origin_verified": True,
+            "solid_geometry_verified": False, "ui_editability_verified": False,
+            "generated_node_ids": sorted(ids), "saved_feature": copy.deepcopy(new[0])}
diff --git a/skills/onshape-native-modeling/SKILL.md b/skills/onshape-native-modeling/SKILL.md
index 593a766..08341a1 100644
--- a/skills/onshape-native-modeling/SKILL.md
+++ b/skills/onshape-native-modeling/SKILL.md
@@ -231,3 +231,9 @@ Run `h2cad experimental-populate-variable SOURCE --logical-id '#length'` with th
 A candidate receipt or Save invocation is not completion. Require independent exact saved-idle readback and an observed journal operation before allocating the next variable. If pending, inspect the exact target with Browser and complete only through normal controls when available; then run `experimental-reconcile-saved-source-variable OP_ID` with the same pinned config/journal and exact current tab. If a fresh same-target tab is needed to observe saved state, do not replay the write or alter the original pending draft. Reconciliation is read-only and retains the barrier on mismatch.
 
 Record normal UI error presentation separately. `regeneration_verified: false` is deliberate: definition readback does not prove dependent expression evaluation. Later dependent planes/sketches must establish it. This is Browser plus CLI skill orchestration, not autonomous standalone allocation. H2 has no REST write fallback.
+
+### H2 source rectangles and circles (solver-gated writer)
+
+Use `experimental-populate-source-sketch SOURCE --logical-id "Chassis sketch"` with exact target/config/tab/pinned journal, `--baseline SAVED_IDLE_STATE.json`, `--plane-op-id OBSERVED_SOURCE_PLANE_OP`, and `--variable-operations VARIABLE_OP_MAP.json`. The variable map contains exactly the source sketch's variable names and observed operation IDs. Capture the saved-idle baseline before normal Browser allocation of one blank sketch on the exact observed source plane. No canvas drawing is required. Native constructors allocate all new node IDs; the UI owns the sketch feature and plane selection.
+
+The writer uses a local numeric origin point with Fix, source expressions and native constraints. It verifies the actual active solver graph, every constrained point and circle radius before Commit. Negative-Y alignment is an inferred candidate checked against source coordinates; failure stops before Commit and retains uncertainty rather than retrying. After Commit, independent saved definition, new identities, unchanged plane/unrelated tree and recorded solver evidence are required. Save invocation alone is not completion. Pending completion uses `experimental-reconcile-saved-source-sketch OP_ID` with the same journal/config and exact tab; if graph evidence was lost, the operation remains unresolved and must not be replayed. Only advance after observed saved state and confirmed marker retirement. Solid/assembly geometry remains a separate gate.
