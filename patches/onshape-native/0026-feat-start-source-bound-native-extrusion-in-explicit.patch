+          nodes[0].classList.contains("disabled"))
+        throw new Error("Expected one enabled source Extrude editor control.");
+      return nodes[0];
+    };
+    const row = unique(`div.os-list-item[feature-id="${sketchId}"][feature-type="newSketch"]`);
+    const toolbar = unique('div.tool[command-id="extrude"]');
+    row.click();
+    for (let attempt=0;attempt<20 && !row.classList.contains("selected");attempt++)
+      await new Promise(resolve=>setTimeout(resolve,100));
+    if (!row.classList.contains("selected") ||
