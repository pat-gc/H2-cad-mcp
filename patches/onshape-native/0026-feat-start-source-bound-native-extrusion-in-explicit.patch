+        return {op_id:job.op_id,feature_id:editing,feature_node_id:feature.nodeId,sketch_feature_id:sketchId,
+          region_query_ids:region.deterministicIds,initiation_candidate:true,
+          region_source_verified:true,element_microversion_before:job.expected_element_microversion,
+          element_microversion_after:getElementMicroversion(),
+          verification:"Independent active editor tree and source-region check required"};
+      }
+      await new Promise(resolve=>setTimeout(resolve,100));
+    }
+    throw new Error("Extrude action may have created an incomplete draft; source region remains unconfirmed.");
