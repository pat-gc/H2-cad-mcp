 class BridgeError(Exception):
     pass
 
 
+def configured_create_target(config):
+    target = config.get("h2cad_create_target", CREATE_LEGACY_TARGET)
+    if (not isinstance(target, dict) or set(target) != {"did", "wid", "eid"}
+            or {key: target[key] for key in ("did", "wid")} != CREATE_PROJECT
+            or not isinstance(target["eid"], str) or not re.fullmatch(r"[a-f0-9]{24}", target["eid"])
+            or target["eid"] in PRESERVED_CREATE_EIDS):
+        raise BridgeError("Native creation requires an explicit test Part Studio in the authorized project")
+    return dict(target)
+
+
+def is_create_project_target(target):
+    return (isinstance(target, dict) and set(target) == {"did", "wid", "eid"}
+            and {key: target[key] for key in ("did", "wid")} == CREATE_PROJECT
+            and isinstance(target["eid"], str) and bool(re.fullmatch(r"[a-f0-9]{24}", target["eid"]))
+            and target["eid"] not in PRESERVED_CREATE_EIDS)
+
+
