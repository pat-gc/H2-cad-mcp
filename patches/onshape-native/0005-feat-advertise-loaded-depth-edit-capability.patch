     current.onmessage = async event => {
diff --git a/extension/page-adapter.js b/extension/page-adapter.js
index 56dbaad..0c92c93 100644
--- a/extension/page-adapter.js
+++ b/extension/page-adapter.js
@@ -262,6 +262,7 @@ export async function pageCommand(job) {
       candidateNodes, visitedCount, truncated};
     return bounded({target, microversion: getMicroversion(), element_microversion:getElementMicroversion(), connected:controller.connection?.isClosed?.() === false,
       editingFeatureId: elementModel?.get("idEditingFeature") || null,
