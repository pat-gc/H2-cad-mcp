diff --git a/tests/test_bridge.py b/tests/test_bridge.py
index abcd70d..a35d353 100644
--- a/tests/test_bridge.py
+++ b/tests/test_bridge.py
@@ -21,6 +21,29 @@ def test_disposable_depth_edit_validation_is_exact_and_finite():
                 {**job, "depth_edit": {**job["depth_edit"], "to_mm": True}}):
         with pytest.raises(BridgeError):
             validate_job(bad)
+
+
+@pytest.mark.asyncio
+async def test_depth_edit_broker_rejects_old_loaded_extension_without_sending():
+    broker = Broker({"token": "x" * 32})
+    class Connection:
+        sent = []
+        async def send_json(self, data): self.sent.append(data)
+    broker.extension = Connection()
+    broker.extension_info = {"capabilities": ["element_revision_v1"]}
+    job = {"kind": "partstudio_depth_edit",
+           "target": {"did": "f5a8353dc826a9ec52106138", "wid": "a3baadfcc7e36a50134951d6", "eid": "a2761fa52794bee99354ae96"},
+           "expected_element_microversion": "a" * 24,
+           "depth_edit": {"feature_id": "saved-extrude", "from_mm": 25, "to_mm": 5}}
+    with pytest.raises(BridgeError, match="h2_depth_edit_page_v1"):
+        await broker.dispatch(job)
+    assert not broker.extension.sent and not broker.pending
+
+
+def test_bridge_health_advertises_depth_edit_server_support():
+    with TestClient(create_app(CONFIG), base_url="http://127.0.0.1:8766") as client:
+        health = client.get("/health", headers=AUTH).json()
+        assert "h2_depth_edit_server_v1" in health["capabilities"]
 from onshape_native.native_catalog import catalog
 
 CONFIG = {"host": "127.0.0.1", "port": 8766, "token": "test-" * 10}
