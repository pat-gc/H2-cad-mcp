+test('native variable populates only fresh LENGTH defaults and keeps pending until readback', async()=>{
+  const temp={did:'4e078dec822b4e509616b1cb',wid:'af0627de07264acf086e646a',eid:'e'.repeat(24)};
+  const fixture=JSON.parse(readFileSync(new URL('./fixtures/native_variable_default.json',import.meta.url),'utf8'));
+  const specs={};
+  function collect(x){
+    if(!x || typeof x!=='object') return;
+    if(x.$type) specs[x.$type]={...(specs[x.$type]||{}),...Object.fromEntries(Object.entries(x).filter(([k])=>k!=='$type'))};
+    for(const v of Object.values(x))collect(v);
+  }
+  collect(fixture);
+  Object.assign(specs,{'diff.GBTTreeEditChange':{oldNode:null,newNode:null},
+    'ui.GBTUiSpecifyFeature':{elementId:'',featureNodeId:'',featureChange:null,sequenceId:0,selectionMicroversion:null,inContextEntitiesToAdd:null,editDescription:''},
+    'ui.GBTUiCommit':{elementId:'',featureNodeId:'',editDescription:''}});
+  const types={};
+  for(const [name,defaults] of Object.entries(specs)) types[name]=class {
+    constructor(){Object.assign(this,structuredClone(defaults));}
+    getMessageName(){return name;} getClassId(){return 1;}
+  };
+  function typed(x){
+    if(!x || typeof x!=='object')return x;
+    if(Array.isArray(x))return x.map(typed);
+    const out=x.$type?new types[x.$type]():{};
+    for(const [k,v]of Object.entries(x))if(k!=='$type')out[k]=typed(v);
+    return out;
+  }
+  for(const fault of [null,'named','ANY','stale','rpc-error','editor-switch','disabled-save']){
+    let feature=typed(fixture),revision='a'.repeat(24),editing=fixture.featureId,clicks=0;
+    const param=id=>feature.parameters.find(p=>p.parameterId===id);
+    if(fault==='named')param('name').value='preserve';
+    if(fault==='ANY')param('variableType').value='ANY';
+    const root={children:[feature,{nodeId:'rollback'}]};
+    const modules=setup(undefined,false,revision,root,types,m=>{
+      if(fault==='rpc-error')return {errorEnum:1};
+      if(m.getMessageName()==='ui.GBTUiSpecifyFeature'){feature=m.featureChange.newNode;root.children[0]=feature;if(fault==='editor-switch')editing='other';}
+      if(m.getMessageName()==='ui.GBTUiCommit')revision='b'.repeat(24);
+      return {errorEnum:0};
+    },temp);
+    modules.__controller.documentModel.get=k=>k==='microversionId'?{theId:micro}:{get:x=>x==='microversionId'?revision:x==='idEditingFeature'?editing:null};
+    globalThis.document={querySelectorAll:()=>[{getClientRects:()=>[1],getAttribute:()=>null,
+      classList:{contains:()=>fault==='disabled-save'},click:()=>{clicks++;editing=null;}}]};
+    const result=await pageCommand({kind:'partstudio_populate_variable',target:temp,op_id:'variable-'+'a'.repeat(32),
+      expected_element_microversion:(fault==='stale'?'c':'a').repeat(24),
+      variable_edit:{feature_id:fixture.featureId,name:'length',expression:'180 mm'}});
+    if(['named','ANY','stale'].includes(fault)){
+      assert.ok(result.error);assert.equal(result.write_stage,'pre_dispatch');assert.equal(sent.length,0);
+    }else if(fault==='rpc-error'||fault==='editor-switch'){
+      assert.ok(result.error);assert.notEqual(result.write_stage,'pre_dispatch');assert.equal(sent.length,1);
+    }else{
+      assert.equal(result.definition_candidate,true,JSON.stringify(result));assert.equal(result.completion_pending,true);
+      assert.equal(result.regeneration_verified,false);assert.equal(sent.length,2);
+      assert.equal(clicks,fault==='disabled-save'?0:1);
+      assert.equal(param('name').value,'length');assert.equal(param('lengthValue').expression,'180 mm');
+      assert.equal(param('value').expression,'180 mm');assert.equal(param('conversionFactor').value,0);
+      assert.equal(root.children[1].nodeId,'rollback');
+      assert.equal(modules.__controller.__onshapeNativeIncompleteFeatureEdit.stage,'await-saved-readback');
+    }
+  }
+});
