diff --git a/extension/page-adapter.js b/extension/page-adapter.js
index 733ae12..92bfedf 100644
--- a/extension/page-adapter.js
+++ b/extension/page-adapter.js
@@ -172,7 +172,7 @@ export async function pageCommand(job) {
     const markerTarget = marker?.target;
     const markerInfo = marker ? {
       stage: typeof marker.stage === "string" && /^[a-z][a-z0-9-]{0,63}$/.test(marker.stage) ? marker.stage : null,
-      op_id: typeof marker.op_id === "string" && /^(?:begin-sketch|begin-extrude|sketch|extrude)-[a-f0-9]{32}$/.test(marker.op_id) ? marker.op_id : null,
+      op_id: typeof marker.op_id === "string" && /^(?:begin-sketch|begin-extrude|sketch|extrude|variable)-[a-f0-9]{32}$/.test(marker.op_id) ? marker.op_id : null,
       target: markerTarget && ['did','wid','eid'].every(k=>typeof markerTarget[k] === "string" && /^[a-f0-9]{24}$/.test(markerTarget[k]))
         ? {did:markerTarget.did,wid:markerTarget.wid,eid:markerTarget.eid} : null
     } : null;
@@ -763,6 +763,101 @@ export async function pageCommand(job) {
     }
     throw new Error("Sketch command acknowledged but saved definition/idle state is unconfirmed; outcome unknown.");
   }
+  if (job.kind === "partstudio_populate_variable") {
+    const edit = job.variable_edit;
+    if (!/^variable-[a-f0-9]{32}$/.test(job.op_id || "") ||
+        target.did !== "4e078dec822b4e509616b1cb" || target.wid !== "af0627de07264acf086e646a" ||
+        !/^[a-f0-9]{24}$/.test(target.eid) || ["45730d1931712e2c548fae00","39a2e2afc5bc43eea167e938"].includes(target.eid))
+      throw new Error("Journaled variable in authorized temporary studio required.");
+    if (!/^[A-Za-z][A-Za-z0-9_]*$/.test(edit?.name || "") ||
+        typeof edit?.expression !== "string" || !/^[+-]?(?:\d+(?:\.\d*)?|\.\d+)\s*mm$/.test(edit.expression.trim()))
+      throw new Error("Named literal millimeter variable required.");
+    const value = Number(edit.expression.trim().slice(0,-2));
+    if (!Number.isFinite(value)) throw new Error("Finite variable required.");
+    const root = () => controller.documentClientCache?.getModelTreeState(target.eid)?.diffableModelTree?.getRoot();
+    const exactEditor = () => controller.connection?.isClosed?.() === false &&
+      controller.getActiveElementTabId() === target.eid &&
+      location.pathname === `/documents/${target.did}/w/${target.wid}/e/${target.eid}`;
+    if (!exactEditor() || controller.__onshapeNativeIncompleteFeatureEdit ||
+        elementModel?.get("idEditingFeature") !== edit.feature_id ||
+        !job.expected_element_microversion || getElementMicroversion() !== job.expected_element_microversion)
+      throw new Error("Exact fresh variable editor unavailable.");
+    const matches = root()?.children?.filter(n=>n?.featureId===edit.feature_id && n.featureType==="assignVariable");
+    if (matches?.length!==1 || !matches[0].nodeId || matches[0].suppressed!==false)
+      throw new Error("One active unsuppressed variable required.");
+    const feature = matches[0];
+    const params = feature.parameters;
+    const byId = id => params?.filter(p=>p?.parameterId===id);
+    for (const [id,type,expected] of [["mode","GBTMParameterEnum","ASSIGNED"],
+      ["variableType","GBTMParameterEnum","LENGTH"],["measurementMode","GBTMParameterEnum","DISTANCE"],
+      ["name","GBTMParameterString",""]]) {
+      const p = byId(id);
+      if (p?.length!==1 || p[0].getMessageName?.()!==`bsedit.${type}` || !p[0].nodeId || p[0].value!==expected)
+        throw new Error("Blank ASSIGNED/LENGTH variable draft required.");
+    }
+    for (const id of ["lengthValue","value"]) {
+      const p = byId(id);
+      if (p?.length!==1 || p[0].getMessageName?.()!=="bsedit.GBTMParameterQuantity" || !p[0].nodeId ||
+          p[0].value!==0 || p[0].expression!=="0 mm" || p[0].units!=="millimeter")
+        throw new Error("Blank literal length parameters required.");
+    }
+    if (root().children.some(n=>n!==feature && n.featureType==="assignVariable" &&
+        n.parameters?.some(p=>p.parameterId==="name" && p.value===edit.name)))
+      throw new Error("Source variable already exists; reconcile instead of replay.");
+    const expected = plain(root());
+    const newFeature = expected.children.find(n=>n.featureId===edit.feature_id);
+    for (const p of newFeature.parameters) {
+      if (p.parameterId==="name") p.value=edit.name;
+      if (["lengthValue","value"].includes(p.parameterId)) { p.value=value; p.expression=edit.expression; }
+    }
+    const make = (name,fields={}) => hydrate({$type:name,...plain(fields)});
+    const specify = make("ui.GBTUiSpecifyFeature",{elementId:target.eid,featureNodeId:feature.nodeId,
+      featureChange:make("diff.GBTTreeEditChange",{oldNode:make("tree.GBTNodeReference",{nodeId:feature.nodeId}),newNode:hydrate(newFeature)}),
+      sequenceId:1,selectionMicroversion:null,inContextEntitiesToAdd:null,editDescription:"Set H2 source variable"});
+    const commit = make("ui.GBTUiCommit",{elementId:target.eid,featureNodeId:feature.nodeId,editDescription:"Insert feature : H2 source variable"});
+    if (typeof controller.elementConnection?.callAndPromise!=="function") throw new Error("Native editor connection unavailable.");
+    if (!exactEditor() || elementModel?.get("idEditingFeature")!==edit.feature_id ||
+        getElementMicroversion()!==job.expected_element_microversion)
+      throw new Error("Variable editor changed before dispatch.");
+    controller.__onshapeNativeIncompleteFeatureEdit={node_id:feature.nodeId,feature_id:edit.feature_id,target:{...target},
+      expected_revision:job.expected_element_microversion,op_id:job.op_id,stage:"prepared"};
+    for (const [i,command] of [specify,commit].entries()) {
+      if (!exactEditor() || elementModel?.get("idEditingFeature")!==edit.feature_id)
+        throw new Error("Variable editor changed; outcome unknown.");
+      controller.__onshapeNativeIncompleteFeatureEdit.stage=i===0?"specify":"commit";
+      h2CadRpcSent=true;
+      const response=await controller.elementConnection.callAndPromise(command);
+      if (response?.error || response?.errorCode || response?.errorEnum) throw new Error("Variable command rejected; inspect before another mutation.");
+    }
+    // A candidate is not a saved result. The broker retains its journal barrier
+    // until independent stable idle readback proves this exact whole tree.
+    const stable = x => Array.isArray(x) ? x.map(stable) : x && typeof x === "object"
+      ? Object.fromEntries(Object.keys(x).sort().map(k=>[k,stable(x[k])])) : x;
+    const expectedJSON = JSON.stringify(stable(expected));
+    let candidate=false;
+    for (let attempt=0;attempt<30;attempt++) {
+      if (!exactEditor()) break;
+      if (JSON.stringify(stable(plain(root())))===expectedJSON && getElementMicroversion()!==job.expected_element_microversion) {
+        candidate=true; break;
+      }
+      await new Promise(resolve=>setTimeout(resolve,100));
+    }
+    if (!candidate)
+      throw new Error("Variable saved definition unconfirmed; outcome unknown.");
+    let invoked=false;
+    if (elementModel?.get("idEditingFeature")===edit.feature_id) {
+      const buttons=[...document.querySelectorAll('.feature-dialog .ns-dialog-button-ok')]
+        .filter(n=>n.getClientRects().length>0 && featureSaveEnabled(n));
+      if (buttons.length===1) {
+        if (!exactEditor() || elementModel?.get("idEditingFeature")!==edit.feature_id)
+          throw new Error("Variable editor changed before Save; outcome unknown.");
+        buttons[0].click(); invoked=true;
+      }
+    }
+    controller.__onshapeNativeIncompleteFeatureEdit.stage="await-saved-readback";
+    return {op_id:job.op_id,feature_id:edit.feature_id,definition_candidate:true,
+      completion_pending:true,...saveInvocation(invoked),regeneration_verified:false};
+  }
   if (job.kind === "partstudio_populate_extrude") {
     const edit = job.extrude_edit;
     if (!/^extrude-[a-f0-9]{32}$/.test(job.op_id || ""))
@@ -1042,7 +1137,7 @@ export async function pageCommand(job) {
     // Chrome discards a rejected executeScript promise's exception details.
     // Return a bounded diagnostic, never a stack or the request object.
     return {error: String(error?.message || error?.errorMessage || error?.getMessageName?.() || "Onshape page command rejected").slice(0,500),
-      ...(["partstudio_begin_top_sketch", "partstudio_begin_source_extrude", "partstudio_populate_sketch", "partstudio_populate_extrude"].includes(job.kind)
+      ...(["partstudio_begin_top_sketch", "partstudio_begin_source_extrude", "partstudio_populate_sketch", "partstudio_populate_extrude", "partstudio_populate_variable"].includes(job.kind)
         ? {write_stage: h2CadRpcSent ? "submitted_or_uncertain" : "pre_dispatch"} : {}),
       outcome: "Inspect current state before retrying a mutation."};
   }
