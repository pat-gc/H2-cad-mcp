+"""Native variable saved-state contract and journal barrier tests."""
+import copy
+import json
+import sqlite3
+from pathlib import Path
+
+import httpx
+import pytest
+from onshape_native.bridge import create_app, validate_job, BridgeError, verify_saved_source_variable
+
+TARGET = {"did": "4e078dec822b4e509616b1cb", "wid": "af0627de07264acf086e646a", "eid": "e" * 24}
+TOKEN = "test-variable-token-" + "a" * 32
+OP = "variable-" + "a" * 32
+
+
+def states():
+    feature = json.loads((Path(__file__).parent / "fixtures/native_variable_default.json").read_text())
+    before = {"target": TARGET, "connected": True, "editingFeatureId": feature["featureId"],
+              "element_microversion": "a" * 24,
+              "tree": {"children": [feature, {"nodeId": "unrelated"}]}}
+    stage = {"logical_id": "#length", "name": "length", "expression": "180 mm",
+             "source_template": {"parameters": [{"parameterId": "name", "value": "length"},
+                 {"parameterId": "lengthValue", "expression": "180 mm"},
+                 {"parameterId": "value", "expression": "180 mm"}]}}
+    expected = copy.deepcopy(before["tree"])
+    for p in expected["children"][0]["parameters"]:
+        if p["parameterId"] == "name": p["value"] = "length"
+        if p["parameterId"] in {"lengthValue", "value"}: p.update(value=180, expression="180 mm")
+    after = {**before, "tree": copy.deepcopy(expected), "editingFeatureId": None, "element_microversion": "b" * 24}
+    return before, expected, after, stage
+
+
+@pytest.mark.parametrize("fault", [None, "busy", "revision", "target", "unrelated", "expression", "source"])
+def test_exact_saved_variable_proof(fault):
+    before, expected, after, stage = states()
+    if fault == "busy": after["editingFeatureId"] = before["editingFeatureId"]
+    if fault == "revision": after["element_microversion"] = before["element_microversion"]
+    if fault == "target": after["target"] = {**TARGET, "eid": "f" * 24}
+    if fault == "unrelated": after["tree"]["children"][-1]["nodeId"] = "changed"
+    if fault == "expression": after["tree"]["children"][0]["parameters"][5]["expression"] = "181 mm"
+    if fault == "source": stage["source_template"]["parameters"][2]["expression"] = "181 mm"
+    if fault:
+        with pytest.raises(ValueError): verify_saved_source_variable(before, expected, after, TARGET, stage)
+    else:
+        proof = verify_saved_source_variable(before, expected, after, TARGET, stage)
+        assert proof["definition_observed"] and proof["regeneration_verified"] is False
+        assert proof["feature_id"] == before["editingFeatureId"]
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("fault", [None, "unstable", "busy", "changed", "other_pending", "source", "expected", "wrong_row"])
+async def test_variable_reconcile_is_read_only_and_preserves_unknown_on_mismatch(tmp_path, fault):
+    before, expected, after, stage = states()
+    journal = tmp_path / "journal.sqlite"
+    intent = {"before_state": before, "expected_tree": expected, "source_stages": [stage],
+              "source_index": 0, "identity_map": {}, "previous_op_ids": []}
+    with sqlite3.connect(journal) as db:
+        db.execute("CREATE TABLE writes(op_id TEXT,target TEXT,expected_revision TEXT,action TEXT,logical_id TEXT,intent TEXT,state TEXT,receipt TEXT,observation TEXT,error TEXT,updated_at TEXT)")
+        db.execute("INSERT INTO writes(op_id,target,expected_revision,action,logical_id,intent,state) VALUES(?,?,?,?,?,?,?)",
+                   (OP, "/".join(TARGET.values()), before["element_microversion"], "experimental_variable_populate", "#length", json.dumps(intent), "unknown"))
+        if fault == "other_pending":
+            db.execute("INSERT INTO writes(op_id,state) VALUES('other','sent')")
+    if fault in {"source", "expected", "wrong_row"}:
+        if fault == "source": intent["source_stages"][0]["source_template"]["parameters"][2]["expression"] = "181 mm"
+        if fault == "expected": intent["expected_tree"]["children"][-1]["nodeId"] = "changed"
+        with sqlite3.connect(journal) as db:
+            db.execute("UPDATE writes SET intent=?", (json.dumps(intent),))
+            if fault == "wrong_row": db.execute("UPDATE writes SET action='other'")
+    app = create_app({"token": TOKEN, "port": 8766, "h2cad_journal": str(journal), "h2cad_create_target": TARGET})
+    broker = app.state.broker
+    broker.unknown_write = True
+    broker.extension = object()
+    broker.extension_info = {"capabilities": ["h2_native_variable_populate_page_v1"]}
+    dispatched = []
+    async def dispatch(job):
+        dispatched.append(job)
+        assert job["kind"] == "state"
+        live = copy.deepcopy(after)
+        if fault == "busy": live["editingFeatureId"] = before["editingFeatureId"]
+        if fault == "changed": live["tree"]["children"][-1]["nodeId"] = "changed"
+        if fault == "unstable" and len(dispatched) == 2: live["element_microversion"] = "c" * 24
+        return live
+    broker.dispatch = dispatch
+    async with httpx.AsyncClient(transport=httpx.ASGITransport(app), base_url="http://127.0.0.1:8766", headers={"Authorization": "Bearer " + TOKEN}) as client:
+        response = await client.post("/local/reconcile_saved_source_variable", json={"op_id": OP, "tab_id": 7})
+    assert response.status_code == (409 if fault else 200), response.text
+    assert len(dispatched) == 2
+    assert broker.unknown_write is bool(fault)
+    with sqlite3.connect(journal) as db:
+        assert db.execute("SELECT state FROM writes WHERE op_id=?", (OP,)).fetchone()[0] == ("unknown" if fault else "observed")
+
+
+def test_variable_job_validation():
+    job = {"kind": "partstudio_populate_variable", "target": TARGET, "op_id": OP,
+           "expected_element_microversion": "a" * 24,
+           "variable_edit": {"feature_id": "freshVariable_0", "name": "length", "expression": "180 mm"}}
+    assert validate_job(job) == job
+    for field, value in [("expression", "#other"), ("feature_id", ""), ("name", "bad name")]:
+        with pytest.raises(BridgeError): validate_job({**job, "variable_edit": {**job["variable_edit"], field: value}})
+
+
+def test_only_observed_per_tab_tolerance_identity_is_normalized():
+    before, expected, after, stage = states()
+    for tree in (before["tree"], expected, after["tree"]):
+        tree["modelAnnotations"] = {"toleranceSchemaForParts": {"nodeId": "old", "value": 1}}
+    after["tree"]["modelAnnotations"]["toleranceSchemaForParts"]["nodeId"] = "new-tab"
+    assert verify_saved_source_variable(before, expected, after, TARGET, stage)["definition_observed"]
+    after["tree"]["modelAnnotations"]["toleranceSchemaForParts"]["value"] = 2
+    with pytest.raises(ValueError): verify_saved_source_variable(before, expected, after, TARGET, stage)
