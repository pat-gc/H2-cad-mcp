+def verify_saved_source_variable(before, expected_tree, after, target, stage):
+    """Prove a blank draft changed only its source name and literal quantities."""
+    fid = before.get("editingFeatureId")
+    if (before.get("target") != target or after.get("target") != target
+            or before.get("connected") is not True or after.get("connected") is not True
+            or not fid or after.get("editingFeatureId") is not None
+            or not re.fullmatch(r"[a-f0-9]{24}", str(after.get("element_microversion", "")))
+            or after.get("element_microversion") == before.get("element_microversion")):
+        raise ValueError("Variable saved idle target or revision unconfirmed")
+    expected = copy.deepcopy(before["tree"])
+    matches = [n for n in expected["children"] if n.get("featureId") == fid]
+    if len(matches) != 1 or matches[0].get("featureType") != "assignVariable" or not matches[0].get("nodeId"):
+        raise ValueError("Exact allocated variable identity unavailable")
+    params = matches[0]["parameters"]
+    by_id = {p["parameterId"]: p for p in params}
+    if len(by_id) != len(params):
+        raise ValueError("Duplicate variable parameters")
+    for name, value in (("mode", "ASSIGNED"), ("variableType", "LENGTH"), ("measurementMode", "DISTANCE")):
+        if by_id[name].get("$type") != "bsedit.GBTMParameterEnum" or by_id[name].get("value") != value:
+            raise ValueError("Variable mode differs")
+    expression, name = stage.get("expression"), stage.get("name")
+    if (not isinstance(expression, str) or not re.fullmatch(r"[+-]?(?:\d+(?:\.\d*)?|\.\d+)\s*mm", expression.strip())
+            or not isinstance(name, str) or not re.fullmatch(r"[A-Za-z][A-Za-z0-9_]*", name)
+            or stage.get("logical_id") != "#" + name):
+        raise ValueError("Source literal differs")
+    source = {p["parameterId"]: p for p in stage["source_template"]["parameters"]}
+    if source["name"].get("value") != name or any(source[k].get("expression") != expression for k in ("lengthValue", "value")):
+        raise ValueError("Source expression provenance differs")
+    value = float(expression.strip()[:-2])
+    if not math.isfinite(value) or by_id["name"].get("$type") != "bsedit.GBTMParameterString" or by_id["name"].get("value") != "":
+        raise ValueError("Named or nonliteral draft cannot be overwritten")
+    by_id["name"]["value"] = name
+    for key in ("lengthValue", "value"):
+        p = by_id[key]
+        if (p.get("$type") != "bsedit.GBTMParameterQuantity" or not p.get("nodeId")
+                or p.get("units") != "millimeter" or p.get("value") != 0 or p.get("expression") != "0 mm"):
+            raise ValueError("Blank native length draft required")
+        p.update(expression=expression, value=value)
+    if (expected != expected_tree or not isinstance(after.get("tree"), dict)
+            or _tab_tolerance_node_normalized(after["tree"]) != _tab_tolerance_node_normalized(expected)):
+        raise ValueError("Variable source definition or unrelated tree differs")
+    return {"feature_id": fid, "node_id": matches[0]["nodeId"], "logical_id": stage["logical_id"],
+            "name": name, "expression": expression, "definition_observed": True,
+            "revision_before": before["element_microversion"], "revision_after": after["element_microversion"],
+            "regeneration_verified": False, "ui_editability_verified": False}
+
