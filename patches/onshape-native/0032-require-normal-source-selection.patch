+for (const selection of ['missing','wrong','multiple','stale','revision']) {
+test(`source Extrude rejects ${selection} selection without toolbar action`,async()=>{
+  const temp={did:'4e078dec822b4e509616b1cb',wid:'af0627de07264acf086e646a',eid:'1926791d173990d5d45f70ef'};
+  const sketchId='sourceSketch_0';
+  const root={children:[{featureId:sketchId,featureType:'newSketch',nodeId:'sketch-node',
+    entities:[{},{},{},{}],constraints:Array.from({length:11},()=>({}))},{$type:'bsedit.GBTMRollback'}]};
+  setup(undefined,false,'a'.repeat(24),root,{},null,temp);
+  let clicks=0;
+  const row={getClientRects:()=>[1],getAttribute:()=>null,
+    classList:{contains:name=>name==='selected'},click:()=>clicks++};
+  const other={...row};
+  const selected=selection==='missing'?[]:selection==='multiple'?[row,other]:
+    selection==='wrong'||selection==='stale'?[other]:[row];
+  globalThis.document={querySelectorAll:selector=>
+    selector===`div.os-list-item[feature-id="${sketchId}"][feature-type="newSketch"]`?[row]:
+    selector==='div.os-list-item.selected[feature-id]'?selected:
+    selector==='div.tool[command-id="extrude"]'?[{...row,classList:{contains:()=>false}}]:[]};
+  const result=await pageCommand({kind:'partstudio_begin_source_extrude',
+    op_id:'begin-extrude-'+'a'.repeat(32),target:temp,
+    expected_element_microversion:(selection==='revision'?'b':'a').repeat(24),sketch_feature_id:sketchId});
+  assert.equal(result.write_stage,'pre_dispatch');
+  if(selection!=='revision') assert.equal(result.reason,'source_sketch_selection_required');
+  assert.equal(clicks,0);
+  assert.equal(sent.length,0);
+});
