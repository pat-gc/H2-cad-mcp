diff --git a/tests/test_extension_reload.py b/tests/test_extension_reload.py
new file mode 100644
index 0000000..d3eaeef
--- /dev/null
+++ b/tests/test_extension_reload.py
@@ -0,0 +1,237 @@
+"""Offline reload protocol tests; no browser or Onshape document is used."""
+import asyncio
+import json
+import sqlite3
+
+import pytest
+from starlette.testclient import TestClient
+from starlette.websockets import WebSocketDisconnect
+
+from onshape_native.bridge import Broker, create_app, is_cad_read, shared_journal_clear, RELOAD_BUILD, RELOAD_CAPABILITY, RELOAD_VERSION
+
+TOKEN = "test-pairing-" * 4
+IDENTITY = "a" * 32
+OTHER = "b" * 32
+CONFIG = {"host": "127.0.0.1", "port": 8766, "token": TOKEN, "extension_id": IDENTITY}
+
+
+def new_broker(tmp_path):
+    path = tmp_path / "shared.sqlite"
+    with sqlite3.connect(path) as db:
+        db.execute("CREATE TABLE IF NOT EXISTS writes (state TEXT NOT NULL)")
+    return Broker({**CONFIG, "h2cad_journal": str(path)})
+
+
+class Socket:
+    def __init__(self, identity=IDENTITY, token=TOKEN, instance="1" * 36, *, runtime_id=None, version=RELOAD_VERSION,
+                 build=RELOAD_BUILD, capabilities=None):
+        self.headers = {"origin": "chrome-extension://" + identity}
+        self.hello = {"type": "hello", "token": token, "runtime_id": runtime_id or identity,
+                      "instance_id": instance, "version": version, "build": build,
+                      "capabilities": capabilities if capabilities is not None else [RELOAD_CAPABILITY]}
+        self.incoming = asyncio.Queue()
+        self.sent = []
+        self.accepted = False
+        self.closed = False
+
+    async def accept(self):
+        self.accepted = True
+
+    async def close(self, code=1000):
+        self.closed = True
+
+    async def receive_json(self):
+        return self.hello
+
+    async def receive_text(self):
+        value = await self.incoming.get()
+        if value is None:
+            raise WebSocketDisconnect()
+        return json.dumps(value)
+
+    async def send_json(self, value):
+        self.sent.append(value)
+
+    def reply(self, value):
+        self.incoming.put_nowait(value)
+
+    def drop(self):
+        self.incoming.put_nowait(None)
+
+
+async def connected(broker, **kwargs):
+    ws = Socket(**kwargs)
+    task = asyncio.create_task(broker.websocket(ws))
+    for _ in range(100):
+        if broker.extension is ws or ws.closed:
+            break
+        await asyncio.sleep(0)
+    return ws, task
+
+
+async def request_started(broker):
+    task = asyncio.create_task(broker.reload_extension(timeout=.05))
+    for _ in range(100):
+        if broker.reload_record:
+            break
+        await asyncio.sleep(0)
+    return task, broker.reload_record["request_id"]
+
+
+@pytest.mark.asyncio
+async def test_reloads_once_only_after_new_matching_runtime_handshake(tmp_path):
+    broker = new_broker(tmp_path)
+    old, old_task = await connected(broker)
+    request, request_id = await request_started(broker)
+    assert old.sent[-1] == {"type": "command", "id": request_id,
+                            "job": {"kind": "extension_reload", "request_id": request_id}}
+    old.reply({"type": "result", "id": request_id,
+               "result": {"accepted": True, "request_id": request_id, "phase": "acknowledged"}})
+    await asyncio.sleep(0)
+    old.drop(); await old_task
+    new, new_task = await connected(broker, instance="2" * 36)
+    result = await request
+    assert result == {"request_id": request_id, "phase": "new_handshake_verified", "status": "reconnected"}
+    assert len([x for x in old.sent if x.get("job", {}).get("kind") == "extension_reload"]) == 1
+    assert new.sent[0]["type"] == "ready"
+    new.drop(); await new_task
+
+
+@pytest.mark.asyncio
+async def test_old_worker_needs_manual_bootstrap_and_sends_no_command(tmp_path):
+    broker = new_broker(tmp_path)
+    old, task = await connected(broker, capabilities=[])
+    assert (await broker.reload_extension())["status"] == "needs_manual_bootstrap"
+    assert not [x for x in old.sent if x.get("type") == "command"]
+    old.drop(); await task
+
+
+@pytest.mark.asyncio
+async def test_wrong_origin_identity_or_token_cannot_trigger_reload(tmp_path):
+    for kwargs in ({"identity": OTHER}, {"identity": IDENTITY, "token": "wrong"},
+                   {"identity": IDENTITY, "runtime_id": OTHER}):
+        broker = new_broker(tmp_path)
+        ws, task = await connected(broker, **kwargs)
+        assert ws.closed
+        assert (await broker.reload_extension())["status"] == "disconnected"
+        await task
+
+
+@pytest.mark.asyncio
+async def test_pending_or_unknown_write_blocks_reload(tmp_path):
+    broker = new_broker(tmp_path)
+    old, task = await connected(broker)
+    broker.pending["write"] = asyncio.get_running_loop().create_future()
+    assert (await broker.reload_extension())["status"] == "blocked"
+    broker.pending.clear()
+    broker.unknown_write = True
+    assert (await broker.reload_extension())["status"] == "blocked"
+    assert not [x for x in old.sent if x.get("type") == "command"]
+    old.drop(); await task
+
+
+@pytest.mark.asyncio
+async def test_active_read_blocks_reload_and_unknown_write_is_latched(tmp_path):
+    broker = new_broker(tmp_path)
+    old, task = await connected(broker)
+    read = asyncio.create_task(broker.dispatch({"kind": "tabs"}, timeout=.03))
+    for _ in range(100):
+        if any(x.get("type") == "command" for x in old.sent):
+            break
+        await asyncio.sleep(0)
+    assert (await broker.reload_extension())["status"] == "busy"
+    from onshape_native.bridge import BridgeError
+    with pytest.raises(BridgeError, match="outcome unknown"):
+        await read
+    assert broker.unknown_write is False
+    write = asyncio.create_task(broker.dispatch({"kind": "rest", "method": "POST", "path": "/api/v1/documents"}, timeout=.03))
+    with pytest.raises(BridgeError, match="outcome unknown"):
+        await write
+    assert broker.unknown_write is True
+    assert (await broker.reload_extension())["status"] == "blocked"
+    old.drop(); await task
+
+
+def test_read_classifier_fails_closed_for_unrecognized_mutations():
+    assert is_cad_read({"kind": "rest", "method": "GET"})
+    assert is_cad_read({"kind": "state"})
+    for job in ({"kind": "rest", "method": "POST"}, {"kind": "native", "command": "ui.GBTUiCommit"},
+                {"kind": "partstudio_depth_edit"}, {"kind": "display", "operation": "feature"},
+                {"kind": "editor_tab", "action": "refresh"}, {"kind": "unknown"}):
+        assert not is_cad_read(job)
+
+
+@pytest.mark.asyncio
+async def test_disconnect_after_ack_is_uncertain_and_never_retried(tmp_path):
+    broker = new_broker(tmp_path)
+    old, task = await connected(broker)
+    request, request_id = await request_started(broker)
+    old.reply({"type": "result", "id": request_id,
+               "result": {"accepted": True, "request_id": request_id, "phase": "acknowledged"}})
+    await asyncio.sleep(0)
+    old.drop(); await task
+    assert (await request)["status"] == "uncertain"
+    assert (await broker.reload_extension())["status"] == "blocked"
+    assert len([x for x in old.sent if x.get("type") == "command"]) == 1
+
+
+@pytest.mark.asyncio
+async def test_stale_instance_or_wrong_build_cannot_prove_reload(tmp_path):
+    for kwargs, expected in (({"instance": "1" * 36}, "timeout"),
+                             ({"instance": "2" * 36, "build": "wrong"}, "needs_manual_bootstrap")):
+        broker = new_broker(tmp_path)
+        old, old_task = await connected(broker)
+        request, request_id = await request_started(broker)
+        old.reply({"type": "result", "id": request_id,
+                   "result": {"accepted": True, "request_id": request_id, "phase": "acknowledged"}})
+        await asyncio.sleep(0)
+        old.drop(); await old_task
+        new, new_task = await connected(broker, **kwargs)
+        assert (await request)["status"] == expected
+        new.drop(); await new_task
+
+
+def test_authenticated_route_has_no_job_passthrough():
+    with TestClient(create_app(CONFIG), base_url="http://127.0.0.1:8766") as client:
+        auth = {"Authorization": "Bearer " + TOKEN}
+        assert client.post("/local/extension_reload").status_code == 401
+        assert client.post("/local/extension_reload", headers={**auth, "Origin": "https://evil.example"}).status_code == 403
+        assert client.post("/local/extension_reload", headers=auth, json={"kind": "native"}).status_code == 400
+        assert client.post("/local/extension_reload", headers=auth).json()["status"] == "disconnected"
+
+
+def test_shared_journal_missing_or_unresolved_blocks_without_mutation(tmp_path):
+    broker = new_broker(tmp_path)
+    path = broker.config["h2cad_journal"]
+    assert shared_journal_clear(broker.config)
+    with sqlite3.connect(path) as db:
+        db.execute("INSERT INTO writes VALUES ('prepared')")
+    assert not shared_journal_clear(broker.config)
+    assert not shared_journal_clear({**broker.config, "h2cad_journal": str(tmp_path / "absent.sqlite")})
+    assert not shared_journal_clear({**broker.config, "h2cad_journal": None})
+    with sqlite3.connect(path) as db:
+        assert db.execute("SELECT state FROM writes").fetchone()[0] == "prepared"
+
+
+def test_configure_pins_existing_journal_without_rotating_pairing(tmp_path, monkeypatch):
+    import importlib.util
+    import sys
+    from onshape_native.config import load_config
+    monkeypatch.setenv("ONSHAPE_NATIVE_RUNTIME", str(tmp_path / "runtime"))
+    before = load_config()
+    root = tmp_path / "source"
+    (root / "extension").mkdir(parents=True)
+    (root / ".venv" / ("Scripts" if sys.platform == "win32" else "bin")).mkdir(parents=True)
+    python = root / ".venv" / ("Scripts/python.exe" if sys.platform == "win32" else "bin/python")
+    python.touch()
+    journal = tmp_path / "intent.sqlite"
+    with sqlite3.connect(journal) as db:
+        db.execute("CREATE TABLE writes (state TEXT NOT NULL)")
+    module_path = __import__("pathlib").Path(__file__).resolve().parents[1] / "scripts/configure.py"
+    spec = importlib.util.spec_from_file_location("native_configure_test", module_path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    module.configure(root=root, runtime=tmp_path / "runtime", h2cad_journal=journal)
+    after = load_config()
+    assert after["token"] == before["token"]
+    assert after["h2cad_journal"] == str(journal)
