+def is_cad_read(job):
+    """An exhaustive read allowlist; unknown jobs are treated as mutations."""
+    kind = job.get("kind")
+    return (kind in {"state", "schema", "tabs", "ui_inspect", "viewer_mesh"}
+            or kind == "rest" and job.get("method") == "GET"
+            or kind == "native" and job.get("command") in READS
+            or kind == "editor_tab" and job.get("action") == "status")
+
+
+def shared_journal_clear(config):
+    """Read the configured H2 intent ledger without creating or altering it."""
+    path = config.get("h2cad_journal")
+    if not isinstance(path, str) or not path:
+        return False
+    try:
+        file = Path(path).resolve(strict=True)
+        if not file.is_file():
+            return False
+        uri = "file:" + quote(file.as_posix(), safe="/:" ) + "?mode=ro"
+        with sqlite3.connect(uri, uri=True, timeout=.2) as db:
+            db.execute("PRAGMA query_only=ON")
+            return db.execute("SELECT count(*) FROM writes WHERE state IN ('prepared','sent','unknown')").fetchone()[0] == 0
+    except (OSError, ValueError, sqlite3.Error):
+        return False
+
