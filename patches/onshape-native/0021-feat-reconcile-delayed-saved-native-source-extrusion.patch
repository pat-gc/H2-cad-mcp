+def verify_saved_source_extrude(before, expected_tree, after, query_response,
+                                target, sketch_id, source_depth_mm):
+    """Verify delayed saved native definition against one durable source intent."""
+    if (not isinstance(before, dict) or not isinstance(after, dict)
+            or before.get("target") != target or after.get("target") != target
+            or before.get("connected") is not True or after.get("connected") is not True
+            or not isinstance(before.get("editingFeatureId"), str)
+            or after.get("editingFeatureId") is not None
+            or not before.get("element_microversion")
+            or after.get("element_microversion") == before["element_microversion"]
+            or not isinstance(expected_tree, dict) or after.get("tree") != expected_tree):
+        raise ValueError("Saved extrusion differs from exact journaled target or expected tree")
+    prior = before.get("tree")
+    if (not isinstance(prior, dict) or prior.get("$type") != "bsedit.GBTMModel"
+            or expected_tree.get("$type") != "bsedit.GBTMModel"):
+        raise ValueError("Native extrusion history unavailable")
+    previous = prior.get("children")
+    current = expected_tree.get("children")
+    feature_id = before["editingFeatureId"]
+    if (not isinstance(previous, list) or not isinstance(current, list)
+            or len(previous) != len(current)
+            or any(a != b for a, b in zip(previous, current) if a.get("featureId") != feature_id)
+            or {k: v for k, v in prior.items() if k != "children"}
+               != {k: v for k, v in expected_tree.items() if k != "children"}):
+        raise ValueError("Extrusion changed unrelated feature history or metadata")
+    old = [node for node in previous if node.get("featureId") == feature_id]
+    new = [node for node in current if node.get("featureId") == feature_id]
+    sketch = [node for node in current if node.get("featureId") == sketch_id]
+    if (len(old) != 1 or len(new) != 1 or len(sketch) != 1
+            or old[0].get("featureType") != "extrude" or new[0].get("featureType") != "extrude"
+            or old[0].get("nodeId") != new[0].get("nodeId")
+            or sketch[0].get("featureType") != "newSketch"):
+        raise ValueError("Extrusion or source sketch identity differs")
+    old_params = old[0].get("parameters")
+    new_params = new[0].get("parameters")
+    if (not isinstance(old_params, list) or not isinstance(new_params, list)
+            or len(old_params) != len(new_params)):
+        raise ValueError("Extrusion parameter set unavailable")
+    old_depth = [p for p in old_params if p.get("parameterId") == "depth"]
+    new_depth = [p for p in new_params if p.get("parameterId") == "depth"]
+    if (len(old_depth) != 1 or len(new_depth) != 1
+            or new_depth[0].get("$type") != "bsedit.GBTMParameterQuantity"
+            or type(source_depth_mm) not in (int, float) or not math.isfinite(source_depth_mm)
+            or source_depth_mm <= 0 or source_depth_mm > 1000
+            or new_depth[0].get("value") != source_depth_mm
+            or new_depth[0].get("units") != "millimeter"
+            or new_depth[0].get("expression") != f"{source_depth_mm:g} mm"):
+        raise ValueError("Saved extrusion does not have exact source depth")
+    restored = json.loads(json.dumps(new[0]))
+    restored["parameters"] = [old_depth[0] if p.get("parameterId") == "depth" else p
+                              for p in restored["parameters"]]
+    if restored != old[0]:
+        raise ValueError("Extrusion changed fields other than source depth")
+    params = {p.get("parameterId"): p for p in new_params}
+    if (len(params) != len(new_params)
+            or any(params.get(key, {}).get("value") != value for key, value in
+                   (("bodyType", "SOLID"), ("operationType", "NEW"), ("endBound", "BLIND")))):
+        raise ValueError("Extrusion mode differs from source plan")
+    regions = params.get("entities", {}).get("queries")
+    if (not isinstance(regions, list) or len(regions) != 1
+            or not regions[0].get("deterministicIds")):
+        raise ValueError("Extrusion region query unavailable")
+    result = query_response.get("result") if isinstance(query_response, dict) else None
+    data = result.get("queryData") if isinstance(result, dict) else None
+    if (not isinstance(data, list) or len(data) != 1 or not isinstance(data[0], dict)
+            or data[0].get("deterministicIds") != regions[0]["deterministicIds"]
+            or data[0].get("featureId") != sketch_id
+            or data[0].get("selectionName") != "Face"
+            or data[0].get("evaluationDetails", {}).get("fullOperationId") != f"{sketch_id}.imprint"
+            or data[0]["evaluationDetails"].get("entityType") != 2
+            or data[0]["evaluationDetails"].get("status") != 0
+            or data[0].get("hasErrorEntity") is not False):
+        raise ValueError("Saved extrusion region does not resolve to source sketch")
+    return {"feature_id": feature_id, "sketch_feature_id": sketch_id,
+            "revision_before": before["element_microversion"],
+            "revision_after": after["element_microversion"],
+            "depth_mm": source_depth_mm, "definition_observed": True,
+            "region_source_verified": True, "unrelated_tree_preserved": True,
+            "completion_timing": "saved_idle_observed_after_page_final_poll_timeout",
+            "solid_geometry_verified": False, "ui_editability_verified": False}
+
+
 def shared_journal_clear(config):
     """Read the configured H2 intent ledger without creating or altering it."""
     path = config.get("h2cad_journal")
@@ -958,6 +1040,101 @@ def create_app(config=None):
             return JSONResponse({"status": "observed_manual_source_completion", "op_id": body["op_id"],
                                  "evidence": evidence})
 
+    async def reconcile_saved_source_extrude(request):
+        """Confirm an eventually saved extrusion without replaying editor commands."""
+        denied = await auth(request)
+        if denied is not None:
+            return denied
+        try:
+            body = await read_body(request)
+        except (ValueError, BridgeError):
+            return JSONResponse({"status": "blocked", "reason": "Invalid extrusion reconciliation request"}, 400)
+        target = {"did": "4e078dec822b4e509616b1cb", "wid": "af0627de07264acf086e646a", "eid": "9a062f0eef8bb961f8c84f8e"}
+        if (not isinstance(body, dict) or set(body) != {"op_id", "tab_id"}
+                or not isinstance(body["op_id"], str)
+                or not re.fullmatch(r"extrude-[a-f0-9]{32}", body["op_id"])
+                or type(body["tab_id"]) is not int or body["tab_id"] < 0):
+            return JSONResponse({"status": "blocked", "reason": "Invalid extrusion operation or exact tab"}, 400)
+        if (not broker.unknown_write or broker.guard_invalid or broker.pending or broker.extension is None
+                or "h2_native_extrude_recheck_page_v1" not in (broker.extension_info or {}).get("capabilities", [])):
+            return JSONResponse({"status": "blocked", "reason": "Versioned bridge safety state differs"}, 409)
+        path = config.get("h2cad_journal")
+        if not isinstance(path, str) or not Path(path).is_absolute():
+            return JSONResponse({"status": "blocked", "reason": "Pinned journal unavailable"}, 409)
+        try:
+            first = await broker.dispatch({"kind": "state", "target": target, "tab_id": body["tab_id"]})
+            extrudes = [node for node in first["tree"]["children"] if node.get("featureType") == "extrude"]
+            if len(extrudes) != 1:
+                raise ValueError("Expected one saved source extrusion")
+            entities = [item for item in extrudes[0]["parameters"] if item.get("parameterId") == "entities"]
+            if len(entities) != 1 or len(entities[0].get("queries", [])) != 1:
+                raise ValueError("Saved source region query unavailable")
+            resolved = await broker.dispatch({"kind": "native", "target": target, "tab_id": body["tab_id"],
+                                              "command": "ui.GBTUiGetQueryDataCall",
+                                              "body": {"elementId": target["eid"],
+                                                       "queries": entities[0]["queries"], "qFunction": "",
+                                                       "additionalArguments": [],
+                                                       "queryNodeIdToInContextNodeId": {}}})
+            live = await broker.dispatch({"kind": "state", "target": target, "tab_id": body["tab_id"]})
+            if (first.get("element_microversion") != live.get("element_microversion")
+                    or first.get("editingFeatureId") != live.get("editingFeatureId")
+                    or first.get("tree") != live.get("tree")):
+                raise ValueError("Editor changed during read-only extrusion reconciliation")
+        except (BridgeError, ValueError, KeyError, TypeError, AttributeError, IndexError) as error:
+            return JSONResponse({"status": "blocked", "reason": f"Read-only extrusion state unavailable: {error}"}, 409)
+        async with broker.command_lock:
+            if (not broker.unknown_write or broker.guard_invalid or broker.pending or broker.extension is None
+                    or "h2_native_extrude_recheck_page_v1" not in (broker.extension_info or {}).get("capabilities", [])):
+                return JSONResponse({"status": "blocked", "reason": "Bridge safety state changed"}, 409)
+            try:
+                with sqlite3.connect(path, timeout=2, isolation_level=None) as db:
+                    db.execute("PRAGMA synchronous=FULL")
+                    db.execute("BEGIN IMMEDIATE")
+                    db.row_factory = sqlite3.Row
+                    rows = db.execute("SELECT * FROM writes WHERE state IN ('prepared','sent','unknown')").fetchall()
+                    row = db.execute("SELECT * FROM writes WHERE op_id=?", (body["op_id"],)).fetchone()
+                    if row is None or (row["state"] == "unknown" and (len(rows) != 1 or rows[0]["op_id"] != body["op_id"])):
+                        raise ValueError("Journal has another unresolved operation")
+                    intent = json.loads(row["intent"])
+                    before = intent.get("before_state")
+                    source_row = db.execute("SELECT * FROM writes WHERE op_id=?", (intent.get("sketch_op_id"),)).fetchone()
+                    source_intent = json.loads(source_row["intent"]) if source_row is not None else {}
+                    source_observation = json.loads(source_row["observation"] or "{}") if source_row is not None else {}
+                    if (row["action"] != "experimental_extrude_populate"
+                            or row["state"] not in {"unknown", "observed"}
+                            or row["target"] != "/".join(target.values())
+                            or row["error"] != "Extrusion command acknowledged but saved definition/idle state is unconfirmed; outcome unknown."
+                            or row["receipt"] is not None or not isinstance(before, dict)
+                            or before.get("element_microversion") != row["expected_revision"]
+                            or source_row is None or source_row["state"] != "observed"
+                            or source_row["action"] != "experimental_sketch_populate"
+                            or source_row["target"] != row["target"]
+                            or source_observation.get("feature_id") != intent.get("sketch_feature_id")
+                            or source_observation.get("origin_verified") is not True
+                            or source_observation.get("constraint_graph_verified") is not True):
+                        raise ValueError("Journal intent is not this unresolved source extrusion")
+                    blueprint = source_intent.get("blueprint")
+                    depth = blueprint.get("depth_mm") if isinstance(blueprint, dict) else None
+                    evidence = verify_saved_source_extrude(before, intent.get("expected_tree"), live,
+                                                           resolved, target, intent.get("sketch_feature_id"), depth)
+                    evidence["op_id"] = body["op_id"]
+                    if row["state"] == "unknown":
+                        db.execute("UPDATE writes SET state='observed', observation=?, updated_at=CURRENT_TIMESTAMP WHERE op_id=? AND state='unknown'",
+                                   (json.dumps(evidence, sort_keys=True), body["op_id"]))
+                    elif rows or json.loads(row["observation"] or "{}") != evidence:
+                        raise ValueError("Previously observed extrusion or another journal write differs")
+                    db.execute("COMMIT")
+            except (OSError, sqlite3.Error, ValueError, KeyError, TypeError, AttributeError) as error:
+                return JSONResponse({"status": "blocked", "reason": str(error)}, 409)
+            broker.unknown_write = False
+            try:
+                broker.save_guard()
+            except BridgeError as error:
+                broker.unknown_write = True
+                return JSONResponse({"status": "blocked", "reason": str(error)}, 409)
+            return JSONResponse({"status": "observed_delayed_source_extrusion", "op_id": body["op_id"],
+                                 "evidence": evidence})
+
