+def source_extrude_states():
+    target = {"did": "4e078dec822b4e509616b1cb", "wid": "af0627de07264acf086e646a", "eid": "9a062f0eef8bb961f8c84f8e"}
+    sketch = {"featureId": "source_0", "featureType": "newSketch", "nodeId": "sketch-node"}
+    region = {"$type": "bsedit.GBTMParameterQueryList", "parameterId": "entities",
+              "queries": [{"$type": "bsedit.GBTMIndividualQuery", "deterministicIds": ["live-region"]}]}
+    depth = {"$type": "bsedit.GBTMParameterQuantity", "parameterId": "depth",
+             "value": 25, "units": "millimeter", "expression": "25 mm", "nodeId": "depth-node"}
+    extrusion = {"featureId": "extrude_0", "featureType": "extrude", "nodeId": "extrude-node",
+                 "parameters": [{"parameterId": "bodyType", "value": "SOLID"},
+                                {"parameterId": "operationType", "value": "NEW"},
+                                {"parameterId": "endBound", "value": "BLIND"}, region, depth]}
+    rollback = {"$type": "bsedit.GBTMRollback", "nodeId": "rollback"}
+    before = {"target": target, "connected": True, "editingFeatureId": "extrude_0",
+              "element_microversion": "a" * 24,
+              "tree": {"$type": "bsedit.GBTMModel", "children": [sketch, extrusion, rollback]}}
+    expected = json.loads(json.dumps(before["tree"]))
+    expected_depth = expected["children"][1]["parameters"][-1]
+    expected_depth["value"] = 5
+    expected_depth["expression"] = "5 mm"
+    after = {"target": target, "connected": True, "editingFeatureId": None,
+             "element_microversion": "b" * 24, "tree": json.loads(json.dumps(expected))}
+    query = {"result": {"$type": "ui.GBTUiGetQueryDataResponse", "queryData": [
+        {"deterministicIds": ["live-region"], "featureId": "source_0", "selectionName": "Face",
+         "evaluationDetails": {"fullOperationId": "source_0.imprint", "entityType": 2, "status": 0},
+         "hasErrorEntity": False}]}}
+    return target, before, expected, after, query
+
+
+@pytest.mark.parametrize("fault", [None, "active", "wrong_region", "wrong_depth", "unrelated", "same_revision"])
+def test_saved_source_extrusion_verifier_preserves_exact_tree_and_region(fault):
+    target, before, expected, after, query = source_extrude_states()
+    if fault == "active": after["editingFeatureId"] = "extrude_0"
+    if fault == "wrong_region": query["result"]["queryData"][0]["featureId"] = "other_0"
+    if fault == "wrong_depth": after["tree"]["children"][1]["parameters"][-1]["value"] = 6
+    if fault == "unrelated": after["tree"]["children"][0]["nodeId"] = "changed"
+    if fault == "same_revision": after["element_microversion"] = before["element_microversion"]
+    if fault is None:
+        evidence = verify_saved_source_extrude(before, expected, after, query, target, "source_0", 5)
+        assert evidence["definition_observed"] and evidence["region_source_verified"]
+        assert evidence["solid_geometry_verified"] is False
+    else:
+        with pytest.raises(ValueError):
+            verify_saved_source_extrude(before, expected, after, query, target, "source_0", 5)
+
+
+@pytest.mark.asyncio
+async def test_delayed_saved_extrusion_reconciles_one_journaled_intent(tmp_path):
+    target, before, expected, after, query = source_extrude_states()
+    source_op, extrude_op = "sketch-" + "1" * 32, "extrude-" + "2" * 32
+    journal = tmp_path / "intent.sqlite"
+    with sqlite3.connect(journal) as db:
+        db.execute("CREATE TABLE writes(op_id TEXT,target TEXT,expected_revision TEXT,action TEXT,logical_id TEXT,intent TEXT,state TEXT,receipt TEXT,observation TEXT,error TEXT,updated_at TEXT)")
+        db.execute("INSERT INTO writes(op_id,target,expected_revision,action,logical_id,intent,state,observation) VALUES(?,?,?,?,?,?,?,?)",
+                   (source_op, "/".join(target.values()), "c" * 24, "experimental_sketch_populate", "Outline",
+                    json.dumps({"blueprint": {"depth_mm": 5}}), "observed",
+                    json.dumps({"feature_id": "source_0", "origin_verified": True, "constraint_graph_verified": True})))
+        db.execute("INSERT INTO writes(op_id,target,expected_revision,action,logical_id,intent,state,error) VALUES(?,?,?,?,?,?,?,?)",
+                   (extrude_op, "/".join(target.values()), before["element_microversion"],
+                    "experimental_extrude_populate", "Solid",
+                    json.dumps({"before_state": before, "expected_tree": expected, "sketch_op_id": source_op,
+                                "sketch_feature_id": "source_0"}), "unknown",
+                    "Extrusion command acknowledged but saved definition/idle state is unconfirmed; outcome unknown."))
+    app = create_app({**CONFIG, "h2cad_journal": str(journal)})
+    broker = app.state.broker
+    broker.unknown_write = True
+    broker.save_guard()
+    broker.extension = object()
+    broker.extension_info = {"capabilities": ["h2_native_extrude_recheck_page_v1"]}
+    async def dispatch(job):
+        if job["kind"] == "state": return json.loads(json.dumps(after))
+        assert job["kind"] == "native" and job["body"]["queries"] == expected["children"][1]["parameters"][-2]["queries"]
+        return query
+    broker.dispatch = dispatch
+    async with httpx.AsyncClient(transport=httpx.ASGITransport(app), base_url="http://127.0.0.1:8766", headers=AUTH) as client:
+        response = await client.post("/local/reconcile_saved_source_extrude", json={"op_id": extrude_op, "tab_id": 17})
+    assert response.status_code == 200, response.text
+    assert response.json()["evidence"]["completion_timing"] == "saved_idle_observed_after_page_final_poll_timeout"
+    with sqlite3.connect(journal) as db:
+        state = db.execute("SELECT state FROM writes WHERE op_id=?", (extrude_op,)).fetchone()[0]
+    assert state == "observed" and broker.unknown_write is False
+
