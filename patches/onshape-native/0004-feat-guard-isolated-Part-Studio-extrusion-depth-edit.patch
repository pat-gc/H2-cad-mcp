 import {pageCommand} from '../extension/page-adapter.js';
 
-const target = {did:'a'.repeat(24),wid:'b'.repeat(24),eid:'c'.repeat(24)};
+const target = {did:'f5a8353dc826a9ec52106138',wid:'a3baadfcc7e36a50134951d6',eid:'a2761fa52794bee99354ae96'};
 const micro = 'd'.repeat(24);
 test('UI export jobs refuse public API paths in both browser transports', async () => {
   const {restGet} = await import('../extension/rest-get.js');
@@ -28,15 +28,17 @@ class Location {
   getMessageName(){return 'tree.GBTInsertionLocation';}
 }
 let sent=[];
-function setup(definition, current=false, elementMicro=null, root={children:[]}){
+function setup(definition, current=false, elementMicro=null, root={children:[]}, extraTypes={}, onCall=null){
   globalThis.crypto ||= webcrypto;
   globalThis.location = {origin:'https://cad.onshape.com',pathname:`/documents/${target.did}/w/${target.wid}/e/${target.eid}`};
   sent=[];
   const controller = {getActiveElementTabId:()=>target.eid,
+    connection:{isClosed:()=>false},
     documentModel:{get:k=>k==='microversionId'?{theId:micro}:{get:k=>k==='microversionId'?elementMicro:null,definition}},
     documentClientCache:{getModelTreeState:()=>({diffableModelTree:{getRoot:()=>root}})},
-    elementConnection:{callAndPromise:async m=>{sent.push(m);return {errorEnum:0};}}};
-  const modules = {27940:{CJP:()=>{},D0n:()=>{},Folder,Location},3392:{GI:{getOpenDocumentController:()=>controller}}};
+    elementConnection:{callAndPromise:async m=>{sent.push(m);return onCall ? onCall(m,controller) : {errorEnum:0};}}};
+  const modules = {27940:{CJP:()=>{},D0n:()=>{},Folder,Location,...extraTypes},3392:{GI:{getOpenDocumentController:()=>controller}}};
+  modules.__controller=controller;
   if (current === '1.223') {
     modules[58519]=modules[27940]; modules[94403]=modules[3392];
     modules[17722]={E15:{Location}}; delete modules[58519].Location;
@@ -66,6 +68,62 @@ test('state returns the native tree and microversion without HTTP',async()=>{
   setup();const state=await pageCommand({kind:'state',target});assert.equal(state.microversion,micro);assert.deepEqual(state.tree,{children:[]});assert.equal(sent.length,0);
 });
 
+test('isolated native extrusion depth edit preserves exact feature identities and definition',async()=>{
+  const Type=(name,defaults)=>class {
+    constructor(){Object.assign(this,defaults);}
+    getMessageName(){return name;}
+    getClassId(){return 1;}
+  };
+  const Quantity=Type('bsedit.GBTMParameterQuantity',{nodeId:'depth-node',parameterId:'depth',
+    units:'millimeter',expression:'25 mm',value:25});
+  const Begin=Type('ui.GBTUiBeginEdit',{elementId:'',messageId:'',nodeId:'',rollbackState:0});
+  const Specify=Type('ui.GBTUiSpecifyFeature',{elementId:'',messageId:'',featureNodeId:'',featureChange:null,
+    sequenceId:0,selectionMicroversion:null,inContextEntitiesToAdd:null,editDescription:''});
+  const Commit=Type('ui.GBTUiCommit',{elementId:'',messageId:'',featureNodeId:'',editDescription:''});
+  const Change=Type('diff.GBTTreeEditChange',{oldNode:null,newNode:null});
+  const Reference=Type('tree.GBTNodeReference',{nodeId:''});
+  const depth=new Quantity();
+  const feature={featureId:'live-extrude',featureType:'extrude',nodeId:'feature-node',name:'Extrude 1',
+    parameters:[{parameterId:'bodyType',value:'SOLID'},{parameterId:'operationType',value:'NEW'},
+      {parameterId:'endBound',value:'BLIND'},{parameterId:'entities',queries:[{deterministicIds:['opaque']} ]},depth],
+    getMessageName(){return 'bsedit.GBTMFeature';}};
+  const sibling={featureId:'live-sketch',featureType:'newSketch',nodeId:'sketch-node',name:'Sketch 1',parameters:[]};
+  const root={children:[sibling,feature]};
+  const types={Quantity,Begin,Specify,Commit,Change,Reference};
+  setup(undefined,false,'e'.repeat(24),root,types,m=>{
+    if(m.getMessageName()==='ui.GBTUiCommit') {depth.expression='5 mm';depth.value=5;}
+    return {errorEnum:0};
+  });
+  const job={kind:'partstudio_depth_edit',target,expected_element_microversion:'e'.repeat(24),
+    depth_edit:{feature_id:'live-extrude',from_mm:25,to_mm:5}};
+  const result=await pageCommand(job);
+  assert.equal(result.definition_verified,true,JSON.stringify(result));
+  assert.equal(result.depth_after_mm,5);
+  assert.deepEqual(sent.map(m=>m.getMessageName()),['ui.GBTUiBeginEdit','ui.GBTUiSpecifyFeature','ui.GBTUiCommit']);
+  assert.equal(sent[1].featureChange.newNode.parameterId,'depth');
+  assert.equal(sent[1].featureChange.newNode.nodeId,'depth-node');
+  assert.equal(sent[1].featureChange.newNode.expression,'5 mm');
+  assert.equal(root.children[0].featureId,'live-sketch');
+});
+
+test('native extrusion depth edit rejects stale revision before sending',async()=>{
+  setup(undefined,false,'e'.repeat(24));
+  const result=await pageCommand({kind:'partstudio_depth_edit',target,expected_element_microversion:'f'.repeat(24),
+    depth_edit:{feature_id:'live-extrude',from_mm:25,to_mm:5}});
+  assert.match(result.error,/revision changed/);
+  assert.equal(sent.length,0);
+});
+
+test('experimental depth edit refuses another target before any editor call',async()=>{
+  setup(undefined,false,'e'.repeat(24));
+  const result=await pageCommand({kind:'partstudio_depth_edit',
+    target:{did:'a'.repeat(24),wid:'b'.repeat(24),eid:'c'.repeat(24)},
+    expected_element_microversion:'e'.repeat(24),
+    depth_edit:{feature_id:'live-extrude',from_mm:25,to_mm:5}});
+  assert.match(result.error,/navigated|authorized disposable/);
+  assert.equal(sent.length,0);
+});
+
 test('H2 readback probe identifies candidates but never claims complete semantics',async()=>{
   const root={children:[{featureId:'fresh-feature',nodeId:'fresh-node',featureType:'extrude',
     name:'Extrude 1',parameters:[{parameterId:'depth',expression:'5 mm'}]}]};
