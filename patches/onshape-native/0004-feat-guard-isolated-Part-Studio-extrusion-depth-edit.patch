+def test_disposable_depth_edit_validation_is_exact_and_finite():
+    target = {"did": "f5a8353dc826a9ec52106138", "wid": "a3baadfcc7e36a50134951d6", "eid": "a2761fa52794bee99354ae96"}
+    job = {"kind": "partstudio_depth_edit", "target": target,
+           "expected_element_microversion": "a" * 24,
+           "depth_edit": {"feature_id": "saved-extrude", "from_mm": 25, "to_mm": 5}}
+    assert validate_job(job) == job
+    for bad in ({**job, "target": TARGET},
+                {**job, "expected_element_microversion": "old"},
+                {**job, "depth_edit": {**job["depth_edit"], "to_mm": float("nan")}},
+                {**job, "depth_edit": {**job["depth_edit"], "to_mm": True}}):
+        with pytest.raises(BridgeError):
+            validate_job(bad)
