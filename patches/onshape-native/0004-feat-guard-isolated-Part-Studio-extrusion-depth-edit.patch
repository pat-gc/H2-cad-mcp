From: patcybermind <pato.gonzalezcabrera@gmail.com>
Date: Wed, 11 Nov 2026 21:58:24 -0500
Subject: [PATCH] feat: guard isolated Part Studio extrusion depth edit

---
 extension/page-adapter.js | 87 +++++++++++++++++++++++++++++++++++++++
 onshape_native/bridge.py  | 15 ++++++-
 tests/adapter.test.mjs    | 66 +++++++++++++++++++++++++++--
 tests/test_bridge.py      | 14 +++++++
 4 files changed, 176 insertions(+), 6 deletions(-)

diff --git a/extension/page-adapter.js b/extension/page-adapter.js
index fea8be6..56dbaad 100644
--- a/extension/page-adapter.js
+++ b/extension/page-adapter.js
@@ -305,6 +305,93 @@ export async function pageCommand(job) {
     if (!Type) throw new Error("Unknown native message type.");
     return bounded({name: job.name, defaults: plain(new Type()), classId: new Type().getClassId()});
   }
+  if (job.kind === "partstudio_depth_edit") {
+    // Experimental isolated-target operation. Keep the whole native edit
+    // lifecycle inside one editor invocation so no bridge call can interleave.
+    const edit = job.depth_edit;
+    if (target.did !== "f5a8353dc826a9ec52106138" ||
+        target.wid !== "a3baadfcc7e36a50134951d6" ||
+        target.eid !== "a2761fa52794bee99354ae96")
+      throw new Error("Experimental depth edit is limited to the authorized disposable Part Studio.");
+    if (!edit || typeof edit.feature_id !== "string" || !edit.feature_id ||
+        !Number.isFinite(edit.from_mm) || !Number.isFinite(edit.to_mm) ||
+        edit.from_mm <= 0 || edit.to_mm <= 0 || edit.from_mm === edit.to_mm)
+      throw new Error("Expected a bounded extrusion depth edit with positive millimeters.");
+    if (!job.expected_element_microversion || getElementMicroversion() !== job.expected_element_microversion)
+      throw new Error("Native element revision changed. Read state again.");
+    if (controller.connection?.isClosed?.() !== false || controller.__onshapeNativeIncompleteFeatureEdit || elementModel?.get("idEditingFeature"))
+      throw new Error("Editor is disconnected, busy, or has an incomplete feature edit.");
+    const cache = controller.documentClientCache;
+    const root = () => cache?.getModelTreeState(target.eid)?.diffableModelTree?.getRoot();
+    const features = tree => {
+      const out = []; let count = 0; const deadline = Date.now() + 1500;
+      const seen = new WeakSet();
+      const walk = node => {
+        if (!node || typeof node !== "object" || seen.has(node)) return;
+        if (++count > 100000 || Date.now() > deadline) throw new Error("Model tree exceeds depth-edit inspection limit.");
+        seen.add(node);
+        if (typeof node.featureId === "string" && node.featureId && typeof node.featureType === "string") out.push(node);
+        for (const value of Object.values(node)) if (value && typeof value === "object") {
+          if (Array.isArray(value)) for (const item of value) walk(item);
+          else walk(value);
+        }
+      };
+      walk(tree);
+      return out;
+    };
+    const baseline = features(root());
+    const matches = baseline.filter(node => node.featureId === edit.feature_id && node.featureType === "extrude");
+    if (matches.length !== 1 || !matches[0].nodeId) throw new Error("Extrusion feature identity absent or ambiguous.");
+    const feature = matches[0];
+    const params = Array.isArray(feature.parameters) ? feature.parameters : [];
+    const depth = params.filter(p => p.parameterId === "depth" && p.getMessageName?.() === "bsedit.GBTMParameterQuantity");
+    if (depth.length !== 1 || !depth[0].nodeId || depth[0].units !== "millimeter" ||
+        depth[0].expression !== `${edit.from_mm} mm` || depth[0].value !== edit.from_mm)
+      throw new Error("Live extrusion depth differs from expected value or type.");
+    const mode = name => params.find(p => p.parameterId === name)?.value;
+    if (mode("bodyType") !== "SOLID" || mode("operationType") !== "NEW" || mode("endBound") !== "BLIND" ||
+        params.find(p => p.parameterId === "entities")?.queries?.length !== 1)
+      throw new Error("Extrusion is not one solid/new/blind sketch-region operation.");
+    const before = baseline.map(node => plain(node));
+    const expected = before.map(node => node.featureId === edit.feature_id ?
+      {...node, parameters:node.parameters.map(p => p.parameterId === "depth" ? {...p, expression:`${edit.to_mm} mm`, value:edit.to_mm} : p)} : node);
+    const make = (name, fields) => hydrate({$type:name, ...fields});
+    const change = make("diff.GBTTreeEditChange", {
+      oldNode:make("tree.GBTNodeReference", {nodeId:depth[0].nodeId}),
+      newNode:hydrate({...plain(depth[0]), expression:`${edit.to_mm} mm`, value:edit.to_mm})});
+    const messages = [
+      make("ui.GBTUiBeginEdit", {elementId:target.eid, nodeId:feature.nodeId, rollbackState:1}),
+      make("ui.GBTUiSpecifyFeature", {elementId:target.eid, featureNodeId:feature.nodeId,
+        featureChange:change, sequenceId:1, selectionMicroversion:null, inContextEntitiesToAdd:null,
+        editDescription:"Edit extrusion depth"}),
+      make("ui.GBTUiCommit", {elementId:target.eid, featureNodeId:feature.nodeId,
+        editDescription:"Edit extrusion depth"})];
+    const connection = controller.elementConnection;
+    if (typeof connection?.callAndPromise !== "function") throw new Error("Native editor connection unavailable.");
+    controller.__onshapeNativeIncompleteFeatureEdit = {node_id:feature.nodeId, stage:"prepared"};
+    for (const [index, message] of messages.entries()) {
+      if (controller.connection?.isClosed?.() !== false || controller.getActiveElementTabId() !== target.eid ||
+          location.pathname !== `/documents/${target.did}/w/${target.wid}/e/${target.eid}`)
+        throw new Error("Editor target or connection changed during depth edit; outcome unknown.");
+      controller.__onshapeNativeIncompleteFeatureEdit.stage = ["begin", "specify", "commit"][index];
+      const response = await connection.callAndPromise(message);
+      if (response?.error || response?.errorCode || response?.errorEnum)
+        throw new Error("Native depth edit rejected; inspect state before any retry.");
+    }
+    for (let attempt = 0; attempt < 10; attempt++) {
+      const after = features(root()).map(node => plain(node));
+      if (JSON.stringify(after) === JSON.stringify(expected)) {
+        delete controller.__onshapeNativeIncompleteFeatureEdit;
+        return {definition_verified:true, feature_id:edit.feature_id, feature_node_id:feature.nodeId,
+          depth_before_mm:edit.from_mm, depth_after_mm:edit.to_mm,
+          element_microversion_before:job.expected_element_microversion,
+          element_microversion_after:getElementMicroversion(),
+          verification:"native feature definition only; inspect solid regeneration and editability separately"};
+      }
+      await new Promise(resolve => setTimeout(resolve, 100));
+    }
+    throw new Error("Native edit acknowledged but complete feature definition readback differs; outcome unknown.");
+  }
   if (job.kind !== "native") throw new Error("Unknown page command.");
   // A second allowlist travels in the extension bundle, never supplied by HTTP callers.
   const allowed = new Set([
diff --git a/onshape_native/bridge.py b/onshape_native/bridge.py
index f2df4b3..1d5b7f8 100644
--- a/onshape_native/bridge.py
+++ b/onshape_native/bridge.py
@@ -33,7 +33,7 @@ def validate_job(job):
     if not isinstance(job, dict):
         raise BridgeError("Expected a JSON object.")
     kind = job.get("kind")
-    if not isinstance(kind, str) or kind not in {"rest", "native", "state", "schema", "tabs", "open", "editor_tab", "ui_inspect", "ui_action", "display", "viewer_mesh"}:
+    if not isinstance(kind, str) or kind not in {"rest", "native", "state", "schema", "tabs", "open", "editor_tab", "ui_inspect", "ui_action", "display", "viewer_mesh", "partstudio_depth_edit"}:
         raise BridgeError("Unknown command kind.")
     if kind == "rest":
         path = job.get("path", "")
@@ -78,7 +78,7 @@ def validate_job(job):
         if args["action"] == "read" and any(not isinstance(args.get(k), str) for k in
                 ("expected_microversion", "full_element_id", "occurrence_path", "body_id")):
             raise BridgeError("Viewer mesh read requires exact part reference and revision.")
-    if kind in {"native", "state", "schema", "open", "editor_tab", "ui_inspect", "ui_action", "display", "viewer_mesh"}:
+    if kind in {"native", "state", "schema", "open", "editor_tab", "ui_inspect", "ui_action", "display", "viewer_mesh", "partstudio_depth_edit"}:
         target = job.get("target", {})
         if not isinstance(target, dict) or set(target) != {"did", "wid", "eid"} or any(not isinstance(x, str) or not re.fullmatch(r"[a-f0-9]{24}", x) for x in target.values()):
             raise BridgeError("Native commands require exact did, wid, eid target IDs.")
@@ -128,6 +128,17 @@ def validate_job(job):
             raise BridgeError("Invalid expected_element_microversion.")
         if name not in READS and not re.fullmatch(r"[a-f0-9]{24}", str(job.get("expected_element_microversion") or job.get("expected_microversion", ""))):
             raise BridgeError("Native writes require expected_microversion from native_state (preflight check, not an atomic lock).")
+    if kind == "partstudio_depth_edit":
+        if target != {"did": "f5a8353dc826a9ec52106138", "wid": "a3baadfcc7e36a50134951d6", "eid": "a2761fa52794bee99354ae96"}:
+            raise BridgeError("Experimental depth edit is limited to the authorized disposable Part Studio.")
+        if not re.fullmatch(r"[a-f0-9]{24}", str(job.get("expected_element_microversion", ""))):
+            raise BridgeError("Depth edit requires an exact fresh element revision.")
+        edit = job.get("depth_edit")
+        if (not isinstance(edit, dict) or set(edit) != {"feature_id", "from_mm", "to_mm"}
+                or not isinstance(edit["feature_id"], str) or not 1 <= len(edit["feature_id"]) <= 80
+                or any(type(edit[key]) not in (int, float) or not __import__("math").isfinite(edit[key]) or not 0 < edit[key] <= 1000 for key in ("from_mm", "to_mm"))
+                or edit["from_mm"] == edit["to_mm"]):
+            raise BridgeError("Depth edit requires one exact feature ID and positive bounded millimeter values.")
     return job
 
 
diff --git a/tests/adapter.test.mjs b/tests/adapter.test.mjs
