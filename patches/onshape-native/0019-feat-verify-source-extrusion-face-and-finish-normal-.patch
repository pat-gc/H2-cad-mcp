-          verification:"Independent tree, regenerated solid, and editable UI inspection required"};
+          getElementMicroversion()!==job.expected_element_microversion) {
+        if (elementModel?.get("idEditingFeature")==null) {
+          delete controller.__onshapeNativeIncompleteFeatureEdit;
+          return {feature_id:edit.feature_id,sketch_feature_id:edit.sketch_feature_id,
+            element_microversion_before:job.expected_element_microversion,
+            element_microversion_after:getElementMicroversion(),definition_candidate:true,
+            region_source_verified:true,normal_ui_finish:saveClicked,
+            verification:"Independent tree, regenerated solid, and editable UI inspection required"};
+        }
+        if (!saveClicked && elementModel?.get("idEditingFeature")===edit.feature_id) {
+          const buttons = [...document.querySelectorAll('.feature-dialog .ns-dialog-button-ok')]
+            .filter(node=>node.getClientRects().length>0 && !node.disabled &&
+              node.getAttribute("aria-disabled")!=="true");
+          if (buttons.length===1) {
+            controller.__onshapeNativeIncompleteFeatureEdit.stage="normal-ui-finish";
+            buttons[0].click();
+            saveClicked=true;
+          }
+        }
       }
       await new Promise(resolve=>setTimeout(resolve,100));
     }
