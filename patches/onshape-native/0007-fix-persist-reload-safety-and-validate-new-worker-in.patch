+@pytest.mark.asyncio
+async def test_new_handshake_before_ack_waiter_resumes_keeps_verified_phase(tmp_path, monkeypatch):
+    broker = new_broker(tmp_path)
+    old, old_task = await connected(broker)
+    gate = asyncio.Event()
+    original_wait_for = asyncio.wait_for
+    async def delayed_ack(awaitable, timeout):
+        result = await original_wait_for(awaitable, timeout)
+        if isinstance(awaitable, asyncio.Future) and timeout == .05:
+            await gate.wait()
+        return result
+    monkeypatch.setattr("onshape_native.bridge.asyncio.wait_for", delayed_ack)
+    request, request_id = await request_started(broker)
+    old.reply({"type": "result", "id": request_id,
+               "result": {"accepted": True, "request_id": request_id, "phase": "acknowledged"}})
+    await asyncio.sleep(0)
+    old.drop(); await old_task
+    new, new_task = await connected(broker, instance=NEW_INSTANCE)
+    assert broker.reload_record["phase"] == "new_handshake_verified"
+    gate.set()
+    assert (await request)["phase"] == "new_handshake_verified"
+    new.drop(); await new_task
