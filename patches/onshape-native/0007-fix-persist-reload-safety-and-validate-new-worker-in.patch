+    restarted = new_broker(tmp_path)
+    assert restarted.reload_record["request_id"] == request_id
+    fresh, task = await connected(restarted, instance=NEW_INSTANCE)
+    assert (await restarted.reload_extension())["status"] == "blocked"
+    with pytest.raises(BridgeError, match="reload has no verified outcome"):
+        await restarted.dispatch({"kind": "rest", "method": "POST", "path": "/api/v1/documents"})
