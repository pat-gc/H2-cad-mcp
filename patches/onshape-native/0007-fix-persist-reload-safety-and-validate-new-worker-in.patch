+    def save_guard(self):
+        if not self.guard_path or self.guard_invalid:
+            raise BridgeError("Shared reload safety record unavailable; no operation sent.")
+        payload = {"schema": 1, "unknown_write": self.unknown_write, "reload": self.reload_record}
+        temporary = self.guard_path.with_name(self.guard_path.name + "." + secrets.token_hex(8) + ".pending")
+        try:
+            fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
+            with os.fdopen(fd, "w", encoding="utf-8") as stream:
+                json.dump(payload, stream, sort_keys=True)
+                stream.write("\n")
+                stream.flush()
+                os.fsync(stream.fileno())
+            os.replace(temporary, self.guard_path)
+        except OSError:
+            self.guard_invalid = True
+            raise BridgeError("Shared reload safety record unavailable; no operation sent.") from None
+        finally:
+            temporary.unlink(missing_ok=True)
+
+    def record_reload(self, status, phase):
+        self.reload_record.update(status=status, phase=phase)
+        try:
+            self.save_guard()
+        except BridgeError:
+            self.reload_record.update(status="uncertain", phase="safety_record_unavailable")
+        return dict(self.reload_record)
 
