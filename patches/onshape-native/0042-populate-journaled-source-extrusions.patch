diff --git a/onshape_native/source_extrusion.py b/onshape_native/source_extrusion.py
new file mode 100644
index 0000000..75db3fc
--- /dev/null
+++ b/onshape_native/source_extrusion.py
@@ -0,0 +1,107 @@
+"""Source journal checks for the existing depth-only native editor operation."""
+import copy
+import json
+import math
+import re
+
+
+def validate_source_extrusion_intent(intent, target, lookup):
+    before, baseline, stage = intent["before_state"], intent["baseline"], intent["source_stage"]
+    fid, sid = before["editingFeatureId"], intent["sketch_feature_id"]
+    if (before.get("target") != target or baseline.get("target") != target
+            or before.get("connected") is not True or baseline.get("connected") is not True
+            or baseline.get("editingFeatureId", "missing") is not None
+            or not re.fullmatch(r"[a-f0-9]{24}", str(baseline.get("element_microversion", "")))
+            or baseline.get("element_microversion") == before.get("element_microversion")):
+        raise ValueError("Exact extrusion pre-allocation baseline required")
+    stripped = copy.deepcopy(before["tree"])
+    stripped["children"] = [n for n in stripped["children"] if n.get("featureId") != fid]
+    if stripped != baseline["tree"] or any(n.get("featureId") == fid for n in baseline["tree"]["children"]):
+        raise ValueError("Extrusion allocation changed unrelated tree")
+    key = "/".join(target[k] for k in ("did", "wid", "eid"))
+    def observed(op_id, action, logical_id):
+        row = lookup(op_id)
+        if (not row or row["state"] != "observed" or row["target"] != key
+                or row["action"] != action or row["logical_id"] != logical_id):
+            raise ValueError("Matching observed source operation required")
+        si, so = json.loads(row["intent"]), json.loads(row["observation"] or "{}")
+        if so.get("definition_observed") is not True or so.get("feature_id") != si["before_state"].get("editingFeatureId"):
+            raise ValueError("Observed source identity differs")
+        return si, so
+    si, so = observed(intent["sketch_op_id"], "experimental_source_sketch_populate", stage["sketch_logical_id"])
+    sketch = so.get("saved_feature")
+    if (so.get("feature_id") != sid or so.get("origin_verified") is not True
+            or so.get("constraint_graph_verified") is not True or not isinstance(sketch, dict)
+            or sketch.get("featureId") != sid or sketch.get("nodeId") != so.get("node_id")
+            or si.get("source_feature") != intent["sketch_source_feature"]
+            or sketch != intent["saved_sketch_definition"]
+            or [n for n in before["tree"]["children"] if n.get("featureId") == sid] != [sketch]):
+        raise ValueError("Exact graph-verified saved source sketch required")
+    raw = intent["source_feature"]
+    if (raw != stage["source_template"] or raw.get("featureType") != "extrude"
+            or raw.get("name") != stage["logical_id"] or raw.get("btType") != "BTMFeature-134"):
+        raise ValueError("Extrusion source provenance differs")
+    source = {p["parameterId"]: p for p in raw["parameters"]}
+    if len(source) != len(raw["parameters"]):
+        raise ValueError("Duplicate source extrusion parameter")
+    if any(source.get(k,{}).get("value")!=v for k,v in (
+            ("domain","MODEL"),("bodyType","SOLID"),("operationType","NEW"),("endBound","BLIND"),
+            ("midplane",False),("oppositeDirection",False),("hasOffset",False),("hasExtrudeDirection",False),
+            ("startOffset",False),("symmetric",False),("hasDraft",False),("hasSecondDirection",False))):
+        raise ValueError("Only source MODEL/SOLID/NEW/BLIND without direction modifiers is supported")
+    if source["entities"].get("queries") != [{"btType": "BTMIndividualQuery-138",
+            "queryString": 'query=qSketchRegion(makeId("' + stage["sketch_logical_id"] + '"));'}]:
+        raise ValueError("Whole source sketch query required")
+    expression, value = stage["depth_expression"], stage["depth_seed_mm"]
+    if (source["depth"].get("expression") != expression or type(value) not in (int,float)
+            or not math.isfinite(value) or not 0 < value <= 1000):
+        raise ValueError("Source depth differs")
+    if stage["variable"] is None:
+        if (not re.fullmatch(r"[+]?(?:\d+(?:\.\d*)?|\.\d+)\s*mm", expression.strip())
+                or float(expression.strip()[:-2]) != value or intent["variable_op_id"] is not None
+                or intent["variable_feature_id"] is not None):
+            raise ValueError("Literal source depth differs")
+    else:
+        if not re.fullmatch(r"#[A-Za-z][A-Za-z0-9_]*", expression):
+            raise ValueError("Direct source length variable required")
+        vi, vo = observed(intent["variable_op_id"], "experimental_variable_populate", expression)
+        index = vi["source_index"]
+        if (type(index) is not int or not 0 <= index < len(vi["source_stages"])
+                or vi["source_stages"][index] != stage["variable"]
+                or float(stage["variable"]["expression"].strip()[:-2]) != value
+                or vo["feature_id"] != intent["variable_feature_id"]):
+            raise ValueError("Depth variable source identity differs")
+        expected_variable = [n for n in vi["expected_tree"]["children"] if n.get("featureId") == vo["feature_id"]]
+        if len(expected_variable) != 1 or expected_variable != [n for n in before["tree"]["children"] if n.get("featureId") == vo["feature_id"]]:
+            raise ValueError("Live source depth variable changed")
+    nodes = [n for n in before["tree"]["children"] if n.get("featureId") == fid]
+    if len(nodes) != 1 or nodes[0].get("featureType") != "extrude" or nodes[0].get("suppressed") is not False:
+        raise ValueError("One active extrusion required")
+    order=[n.get("featureId") for n in before["tree"]["children"]]
+    if order.index(sid)>=order.index(fid) or (intent["variable_feature_id"] and order.index(intent["variable_feature_id"])>=order.index(fid)):
+        raise ValueError("Source definitions must precede extrusion")
+    params = nodes[0]["parameters"]
+    by_id = {p["parameterId"]: p for p in params}
+    if len(by_id) != len(params) or set(by_id) != set(source):
+        raise ValueError("Source extrusion schema differs")
+    for key,p in source.items():
+        live = by_id[key]
+        if live.get("$type") != "bsedit.G" + p["btType"].split("-")[0] or not live.get("nodeId"):
+            raise ValueError("Typed extrusion parameter identity differs")
+        if key not in ("entities", "depth") and any(live.get(k) != p[k] for k in ("value","expression","enumName","queries") if k in p):
+            raise ValueError("Extrusion defaults differ from source")
+    depth = by_id["depth"]
+    if (depth.get("value") != intent["from_mm"] or depth.get("expression") != f'{intent["from_mm"]:g} mm'
+            or depth.get("units") != "millimeter"):
+        raise ValueError("Fresh literal extrusion depth required")
+    query = by_id["entities"].get("queries")
+    if (not isinstance(query,list) or len(query)!=1 or query[0].get("$type") != "bsedit.GBTMIndividualSketchRegionQuery"
+            or query[0].get("featureId") != sid or query[0].get("filterInnerLoops") is not True):
+        raise ValueError("Exact whole sketch region required")
+    expected = copy.deepcopy(before["tree"])
+    new = next(n for n in expected["children"] if n.get("featureId") == fid)
+    next(p for p in new["parameters"] if p["parameterId"] == "depth").update(expression=expression,value=value)
+    if expected != intent["expected_tree"]:
+        raise ValueError("Extrusion changes unrelated fields")
+    return {"depth_expression": expression, "before_tree": before["tree"], "expected_tree": expected,
+            "sketch_definition": sketch}
