@@ -0,0 +1,134 @@
+import copy
+import json
+import sqlite3
+from pathlib import Path
+
+import httpx
+import pytest
+
+from onshape_native.bridge import create_app, verify_saved_source_extrude
+from onshape_native.source_extrusion import validate_source_extrusion_intent
+
+FIXTURE = Path(__file__).parent / "fixtures/source_extrusion_intents.json"
+OP = "extrude-" + "c"*32
+TOKEN = "test-source-extrusion-" + "a"*32
+
+
+def scenario(index=0):
+    case = json.loads(FIXTURE.read_text())[index]
+    intent, rows = case["intent"], case["rows"]
+    before = intent["before_state"]
+    fid, sid = before["editingFeatureId"], intent["sketch_feature_id"]
+    intent["baseline"] = {**copy.deepcopy(before), "editingFeatureId": None, "element_microversion": "f"*24}
+    intent["baseline"]["tree"]["children"] = [n for n in intent["baseline"]["tree"]["children"] if n.get("featureId") != fid]
+    intent["expected_tree"] = copy.deepcopy(before["tree"])
+    depth = next(p for n in intent["expected_tree"]["children"] if n.get("featureId") == fid
+                 for p in n["parameters"] if p["parameterId"] == "depth")
+    depth.update(expression=intent["source_stage"]["depth_expression"],value=intent["source_stage"]["depth_seed_mm"])
+    intent["source_feature"] = copy.deepcopy(intent["source_stage"]["source_template"])
+    sketch = next(n for n in before["tree"]["children"] if n.get("featureId") == sid)
+    intent["saved_sketch_definition"] = copy.deepcopy(sketch)
+    intent["sketch_source_feature"] = copy.deepcopy(rows[intent["sketch_op_id"]]["intent"]["source_feature"])
+    rows[intent["sketch_op_id"]]["observation"]["saved_feature"] = copy.deepcopy(sketch)
+    if intent["variable_op_id"]:
+        vi = rows[intent["variable_op_id"]]["intent"]
+        vi["source_stages"][vi["source_index"]] = copy.deepcopy(intent["source_stage"]["variable"])
+        vi["expected_tree"] = {"children": [copy.deepcopy(next(n for n in before["tree"]["children"]
+            if n.get("featureId") == intent["variable_feature_id"]))]}
+    for row in rows.values():
+        row["intent"], row["observation"] = json.dumps(row["intent"]), json.dumps(row["observation"])
+    after = {**copy.deepcopy(before), "editingFeatureId": None, "element_microversion": "1"*24,
+             "tree": copy.deepcopy(intent["expected_tree"])}
+    return intent, rows, before["target"], after
+
+
+@pytest.mark.parametrize("index", [0,1])
+def test_literal_and_variable_multi_region_use_observed_sketch_definition(index):
+    intent, rows, target, after = scenario(index)
+    edit = validate_source_extrusion_intent(intent,target,rows.get)
+    stage = intent["source_stage"]
+    evidence = verify_saved_source_extrude(intent["before_state"],intent["expected_tree"],after,
+        intent["region_query_evidence"],target,intent["sketch_feature_id"],stage["depth_seed_mm"],
+        source_expression=stage["depth_expression"],source_sketch_definition=intent["saved_sketch_definition"])
+    assert evidence["definition_observed"] and not evidence["solid_geometry_verified"]
+    assert edit["depth_expression"] == ("8 mm" if index==0 else "#wheelThickness")
+
+
+@pytest.mark.parametrize("fault", ["sketch_source", "sketch_graph", "sketch_saved", "variable_source", "variable_live",
+                                   "baseline", "expected", "depth_expression", "source_region"])
+def test_source_intent_rejects_changes(fault):
+    intent,rows,target,_=scenario(1)
+    if fault=="sketch_source":intent["sketch_source_feature"]["name"]="other"
+    if fault in ("sketch_graph","sketch_saved"):
+        row=rows[intent["sketch_op_id"]];o=json.loads(row["observation"])
+        if fault=="sketch_graph":o["constraint_graph_verified"]=False
+        else:o["saved_feature"]["nodeId"]="wrong"
+        row["observation"]=json.dumps(o)
+    if fault=="variable_source":intent["source_stage"]["variable"]["expression"]="13 mm"
+    if fault=="variable_live":
+        for tree in (intent["baseline"]["tree"],intent["before_state"]["tree"]):tree["children"][0]["name"]="changed"
+    if fault=="baseline":intent["baseline"]["tree"]["children"][1]["nodeId"]="changed"
+    if fault=="expected":intent["expected_tree"]["children"][1]["nodeId"]="changed"
+    if fault=="depth_expression":intent["source_stage"]["depth_expression"]="12 mm"
+    if fault=="source_region":intent["source_feature"]["parameters"][0]["parameterId"]="other"
+    with pytest.raises((ValueError,KeyError)):validate_source_extrusion_intent(intent,target,rows.get)
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("index",[0,1])
+@pytest.mark.parametrize("fault",[None,"busy","changed","unstable","marker","source_journal","other_pending","persist"])
+async def test_source_reconcile_requires_saved_tree_and_marker_before_guard_release(tmp_path,index,fault):
+    intent,rows,target,after=scenario(index)
+    journal=tmp_path/"journal.sqlite"
+    if fault=="source_journal":rows[intent["sketch_op_id"]]["state"]="unknown"
+    with sqlite3.connect(journal) as db:
+        db.execute("CREATE TABLE writes(op_id TEXT,target TEXT,expected_revision TEXT,action TEXT,logical_id TEXT,intent TEXT,state TEXT,receipt TEXT,observation TEXT,error TEXT,updated_at TEXT)")
+        for row in rows.values():
+            db.execute("INSERT INTO writes(op_id,target,action,logical_id,intent,state,observation) VALUES(?,?,?,?,?,?,?)",
+                       tuple(row[k] for k in ("op_id","target","action","logical_id","intent","state","observation")))
+        db.execute("INSERT INTO writes(op_id,target,expected_revision,action,logical_id,intent,state) VALUES(?,?,?,?,?,?,?)",
+            (OP,"/".join(target.values()),intent["before_state"]["element_microversion"],"experimental_source_extrude_populate",
+             intent["source_stage"]["logical_id"],json.dumps(intent),"unknown"))
+        if fault=="other_pending":db.execute("INSERT INTO writes(op_id,state) VALUES('other','sent')")
+    app=create_app({"token":TOKEN,"port":8766,"h2cad_journal":str(journal),"h2cad_create_target":target})
+    broker=app.state.broker;broker.extension=object();broker.unknown_write=True
+    broker.extension_info={"capabilities":["h2_native_extrude_recheck_page_v1","h2_source_extrude_page_v1"]}
+    dispatched=[]
+    async def dispatch(job):
+        dispatched.append(job)
+        assert job["kind"] in ("state","native")
+        if job["kind"]=="native":
+            assert job["command"]=="ui.GBTUiGetQueryDataCall"
+            return intent["region_query_evidence"]
+        state=copy.deepcopy(after)
+        if fault=="busy":state["editingFeatureId"]=intent["before_state"]["editingFeatureId"]
+        if fault=="changed":state["tree"]["children"][1]["nodeId"]="changed"
+        if job.get("retire_acknowledged_op_id"):
+            state["marker_retirement"]={"op_id":OP,"status":"blocked" if fault=="marker" else "retired"}
+            if fault=="unstable":state["element_microversion"]="2"*24
+        return state
+    broker.dispatch=dispatch
+    if fault=="persist":
+        from onshape_native.bridge import BridgeError
+        original_save=broker.save_guard
+        def fail_once():
+            broker.save_guard=original_save
+            raise BridgeError("simulated durable guard persistence failure")
+        broker.save_guard=fail_once
+    async with httpx.AsyncClient(transport=httpx.ASGITransport(app),base_url="http://127.0.0.1:8766",
+                                 headers={"Authorization":"Bearer "+TOKEN}) as client:
+        response=await client.post("/local/reconcile_saved_source_extrude",json={"op_id":OP,"tab_id":7})
+        if fault=="persist":
+            assert response.status_code==409 and broker.unknown_write
+            with sqlite3.connect(journal) as db:
+                assert db.execute("SELECT state FROM writes WHERE op_id=?",(OP,)).fetchone()[0]=="observed"
+            response=await client.post("/local/reconcile_saved_source_extrude",json={"op_id":OP,"tab_id":7})
+    failed=bool(fault and fault!="persist")
+    assert response.status_code==(409 if failed else 200),response.text
+    assert broker.unknown_write is failed
+    if not failed:
+        assert response.json()["evidence"]["depth_expression"]==intent["source_stage"]["depth_expression"]
+    if fault in ("busy","changed","source_journal","other_pending"):
+        assert not any(j.get("retire_acknowledged_op_id") for j in dispatched)
+    with sqlite3.connect(journal) as db:
+        assert db.execute("SELECT state FROM writes WHERE op_id=?",(OP,)).fetchone()[0]==("unknown" if failed else "observed")
