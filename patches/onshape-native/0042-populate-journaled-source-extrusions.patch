+test('source extrusion reuses depth editor with interleaved siblings and symbolic whole-sketch regions',async()=>{
+  const fixtures=JSON.parse(readFileSync(new URL('./fixtures/source_extrusion_intents.json',import.meta.url),'utf8'));
+  for(const fixture of fixtures){for(const fault of [null,'sketch','unrelated','region','rpc','marker']){
+    const intent=structuredClone(fixture.intent),before=intent.before_state,target=before.target;
+    const stage=intent.source_stage,sid=intent.sketch_feature_id,fid=before.editingFeatureId;
+    const expected=structuredClone(before.tree),expectedDepth=expected.children.find(n=>n.featureId===fid).parameters.find(p=>p.parameterId==='depth');
+    expectedDepth.expression=stage.depth_expression;expectedDepth.value=stage.depth_seed_mm;
+    const sketch=before.tree.children.find(n=>n.featureId===sid);
+    const specs={};
+    function collect(x){if(!x||typeof x!=='object')return;
+      if(x.$type)specs[x.$type]={...(specs[x.$type]||{}),...Object.fromEntries(Object.entries(x).filter(([k])=>k!=='$type'))};
+      for(const v of Object.values(x))collect(v);}
+    collect(before.tree);
+    Object.assign(specs,{'tree.GBTNodeReference':{nodeId:''},'diff.GBTTreeEditChange':{oldNode:null,newNode:null},
+      'ui.GBTUiSpecifyFeature':{elementId:'',featureNodeId:'',featureChange:null,sequenceId:0,selectionMicroversion:null,inContextEntitiesToAdd:null,editDescription:''},
+      'ui.GBTUiCommit':{elementId:'',featureNodeId:'',editDescription:''},
+      'ui.GBTUiGetQueryDataCall':{elementId:'',queries:[],qFunction:'',additionalArguments:[],queryNodeIdToInContextNodeId:{}}});
+    const types={};for(const [name,defaults]of Object.entries(specs))types[name]=class{
+      constructor(){for(const k of Object.keys(defaults))this[k]=undefined;}getMessageName(){return name;}getClassId(){return 1;}};
+    function typed(x){if(!x||typeof x!=='object')return x;if(Array.isArray(x))return x.map(typed);
+      const out=x.$type?Object.create(types[x.$type].prototype):{};
+      for(const[k,v]of Object.entries(x))if(k!=='$type')out[k]=typed(v);return out;}
+    const root=typed(before.tree);let revision=before.element_microversion,editing=fid;
+    if(fault==='unrelated')root.children[0].nodeId='changed';
+    const source={depth_expression:stage.depth_expression,before_tree:before.tree,expected_tree:expected,sketch_definition:sketch};
+    if(fault==='sketch')source.sketch_definition={...sketch,nodeId:'wrong'};
+    const modules=setup(undefined,false,revision,root,types,m=>{
+      if(m.getMessageName()==='ui.GBTUiGetQueryDataCall'){
+        const data=structuredClone(intent.region_query_evidence.result);if(fault==='region')data.queryData[0].featureId='wrong';return data;
+      }
+      if(fault==='rpc')return {errorEnum:1};
+      if(m.getMessageName()==='ui.GBTUiSpecifyFeature'){
+        const params=root.children.find(n=>n.featureId===fid).parameters;
+        params[params.findIndex(p=>p.parameterId==='depth')]=m.featureChange.newNode;
+      }
+      if(m.getMessageName()==='ui.GBTUiCommit'){revision='2'.repeat(24);editing=null;}
+      return {errorEnum:0};
+    },target);
+    modules.__controller.documentModel.get=k=>k==='microversionId'?{theId:micro}:{get:x=>x==='microversionId'?revision:x==='idEditingFeature'?editing:null};
+    if(fault==='marker')modules.__controller.__onshapeNativeIncompleteFeatureEdit={op_id:'prior'};
+    globalThis.document={querySelectorAll:()=>[]};
+    const result=await pageCommand(...pageCommandArgs({kind:'partstudio_populate_extrude',target,op_id:'extrude-'+'a'.repeat(32),
+      expected_element_microversion:before.element_microversion,extrude_edit:{feature_id:fid,sketch_feature_id:sid,
+      from_mm:intent.from_mm,to_mm:stage.depth_seed_mm},source_extrusion:source}));
+    if(fault){assert.ok(result.error,JSON.stringify(result));assert.equal(result.write_stage,fault==='rpc'?'submitted_or_uncertain':'pre_dispatch');
+      assert.equal(sent.length,fault==='region'?1:fault==='rpc'?2:0);
+    }else{
+      assert.equal(result.definition_candidate,true,JSON.stringify(result));assert.equal(result.completion_pending,true);
+      assert.equal(sent.length,3);assert.equal(modules.__controller.__onshapeNativeIncompleteFeatureEdit.stage,'await-saved-readback');
+      const saved=await pageCommand(...pageCommandArgs({kind:'state',target}));assert.deepEqual(JSON.parse(JSON.stringify(saved.tree)),expected);
+    }
+  }}
+});
