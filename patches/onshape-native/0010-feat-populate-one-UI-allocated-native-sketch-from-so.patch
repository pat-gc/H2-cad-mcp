         raise BridgeError("Unknown command kind.")
     if kind == "rest":
         path = job.get("path", "")
@@ -122,7 +122,7 @@ def validate_job(job):
         if args["action"] == "read" and any(not isinstance(args.get(k), str) for k in
                 ("expected_microversion", "full_element_id", "occurrence_path", "body_id")):
             raise BridgeError("Viewer mesh read requires exact part reference and revision.")
-    if kind in {"native", "state", "schema", "creation_probe", "open", "editor_tab", "ui_inspect", "ui_action", "display", "viewer_mesh", "partstudio_depth_edit"}:
+    if kind in {"native", "state", "schema", "creation_probe", "open", "editor_tab", "ui_inspect", "ui_action", "display", "viewer_mesh", "partstudio_depth_edit", "partstudio_populate_sketch"}:
         target = job.get("target", {})
         if not isinstance(target, dict) or set(target) != {"did", "wid", "eid"} or any(not isinstance(x, str) or not re.fullmatch(r"[a-f0-9]{24}", x) for x in target.values()):
             raise BridgeError("Native commands require exact did, wid, eid target IDs.")
@@ -183,6 +183,20 @@ def validate_job(job):
                 or any(type(edit[key]) not in (int, float) or not __import__("math").isfinite(edit[key]) or not 0 < edit[key] <= 1000 for key in ("from_mm", "to_mm"))
                 or edit["from_mm"] == edit["to_mm"]):
             raise BridgeError("Depth edit requires one exact feature ID and positive bounded millimeter values.")
+    if kind == "partstudio_populate_sketch":
+        if target != {"did": "4e078dec822b4e509616b1cb", "wid": "af0627de07264acf086e646a", "eid": "9a062f0eef8bb961f8c84f8e"}:
+            raise BridgeError("Sketch population is limited to the authorized temporary Part Studio.")
+        if not re.fullmatch(r"[a-f0-9]{24}", str(job.get("expected_element_microversion", ""))):
+            raise BridgeError("Sketch population requires an exact fresh element revision.")
+        edit = job.get("sketch_edit")
+        if (not isinstance(edit, dict) or set(edit) != {"feature_id", "entity_prefix", "rectangle_m"}
+                or not isinstance(edit["feature_id"], str) or not re.fullmatch(r"[A-Za-z0-9_]{4,80}", edit["feature_id"])
+                or not isinstance(edit["entity_prefix"], str) or not re.fullmatch(r"[A-Za-z][A-Za-z0-9_.]{0,63}", edit["entity_prefix"])
+                or not isinstance(edit["rectangle_m"], list) or len(edit["rectangle_m"]) != 4
+                or any(type(x) not in (int, float) or not __import__("math").isfinite(x) for x in edit["rectangle_m"])
+                or edit["rectangle_m"][0:2] != [0, 0]
+                or any(not 0 < x <= 1 for x in edit["rectangle_m"][2:])):
+            raise BridgeError("Sketch population requires one exact active feature and bounded origin rectangle.")
     return job
 
 
@@ -263,6 +277,8 @@ class Broker:
             if job.get("kind") == "display" and "display_v1" not in (self.extension_info or {}).get("capabilities", []):
                 raise BridgeError("Loaded extension lacks display_v1. Update/reload version 0.4.0; check bridge_status.")
             capabilities = (self.extension_info or {}).get("capabilities", [])
