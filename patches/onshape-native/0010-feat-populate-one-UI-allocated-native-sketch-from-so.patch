diff --git a/extension/page-adapter.js b/extension/page-adapter.js
index 15b1db4..6e9f839 100644
--- a/extension/page-adapter.js
+++ b/extension/page-adapter.js
@@ -324,6 +324,108 @@ export async function pageCommand(job) {
       generatedNodes,
       note:"Local constructor defaults only; no editor object traversal, allocator, query binding, or modeling RPC was invoked."});
   }
+  if (job.kind === "partstudio_populate_sketch") {
+    const edit = job.sketch_edit;
+    if (target.did !== "4e078dec822b4e509616b1cb" ||
+        target.wid !== "af0627de07264acf086e646a" ||
+        target.eid !== "9a062f0eef8bb961f8c84f8e")
+      throw new Error("Native sketch creation is limited to the authorized temporary Part Studio.");
+    if (!job.expected_element_microversion || getElementMicroversion() !== job.expected_element_microversion)
+      throw new Error("Native element revision changed. Read state again.");
+    if (controller.connection?.isClosed?.() !== false || controller.__onshapeNativeIncompleteFeatureEdit ||
+        elementModel?.get("idEditingFeature") !== edit?.feature_id)
+      throw new Error("Exact sketch is not the active connected editor feature.");
+    if (!/^[A-Za-z][A-Za-z0-9_.]{0,63}$/.test(edit?.entity_prefix || "") ||
+        !Array.isArray(edit?.rectangle_m) || edit.rectangle_m.length !== 4 ||
+        edit.rectangle_m.some(v => !Number.isFinite(v)) ||
+        edit.rectangle_m[0] !== 0 || edit.rectangle_m[1] !== 0 ||
+        !(edit.rectangle_m[2] > 0 && edit.rectangle_m[2] <= 1) ||
+        !(edit.rectangle_m[3] > 0 && edit.rectangle_m[3] <= 1))
+      throw new Error("Expected one bounded origin-anchored rectangle in meters.");
+    const [x0,y0,x1,y1] = edit.rectangle_m;
+    const cache = controller.documentClientCache;
+    const root = () => cache?.getModelTreeState(target.eid)?.diffableModelTree?.getRoot();
+    const tree = root();
+    const siblings = Array.isArray(tree?.children) ? tree.children : [];
+    const matches = siblings.filter(node => node?.featureId === edit.feature_id && node.featureType === "newSketch");
+    if (matches.length !== 1 || !matches[0].nodeId || matches[0].entities?.length || matches[0].constraints?.length)
+      throw new Error("Expected one empty, newly initiated native sketch.");
+    const sketch = matches[0];
+    const plane = sketch.parameters?.filter(p => p.parameterId === "sketchPlane");
+    if (plane?.length !== 1 || plane[0].getMessageName?.() !== "bsedit.GBTMParameterQueryList" ||
+        plane[0].queries?.length !== 1 || !plane[0].queries[0].deterministicIds?.length)
+      throw new Error("Sketch plane must be selected by the current editor.");
+    const make = (name, fields={}) => hydrate({$type:name, ...fields});
+    const prefix = edit.entity_prefix;
+    const line = (side, px, py, dx, dy, distance) => make("bsedit.GBTMSketchCurveSegment", {
+      entityId:`${prefix}.${side}`, startPointId:`${prefix}.${side}.start`,
+      endPointId:`${prefix}.${side}.end`, isConstruction:false,
+      startParam:-distance / 2, endParam:distance / 2,
+      geometry:make("bsedit.GBTCurveGeometryLine",{pntX:px,pntY:py,dirX:dx,dirY:dy})});
+    const entities = [line("bottom",(x0+x1)/2,y0,1,0,x1-x0), line("right",x1,(y0+y1)/2,0,1,y1-y0),
+      line("top",(x0+x1)/2,y1,1,0,x1-x0), line("left",x0,(y0+y1)/2,0,1,y1-y0)];
+    const str = (id,value) => make("bsedit.GBTMParameterString",{parameterId:id,value});
+    const enumParam = (id,enumName,value) => make("bsedit.GBTMParameterEnum",{parameterId:id,enumName,value});
+    const quantity = (id,value,units,expression="") => make("bsedit.GBTMParameterQuantity",{
+      parameterId:id,value,units,expression});
+    const constraint = (id,type,parameters) => make("bsedit.GBTMSketchConstraint",{
+      entityId:`${prefix}.${id}`,constraintType:type,parameters,index:1});
+    const local = side => `${prefix}.${side}`;
+    const pair = (first,second) => [str("localFirst",first),str("localSecond",second)];
+    const origin = make("bsedit.GBTMParameterQueryList",{parameterId:"externalSecond",
+      queries:[make("bsedit.GBTMIndividualQuery",{deterministicIds:[],queryString:""})]});
+    const dimension = (id,side,mm,labelDistance) => constraint(id,11,[str("localFirst",local(side)),
+      enumParam("direction","DimensionDirection","MINIMUM"),quantity("length",mm,"millimeter",`${mm} mm`),
+      enumParam("alignment","DimensionAlignment","ALIGNED"),quantity("labelRatio",0.5,""),
+      quantity("labelDistance",labelDistance,"meter")]);
+    const constraints = [
+      constraint("firstSnap0",1,[str("localFirst",local("bottom.start")),origin]),
+      constraint("perpendicular",5,pair(local("top"),local("left"))),
+      constraint("parallel.1",2,pair(local("bottom"),local("top"))),
+      constraint("parallel.2",2,pair(local("left"),local("right"))),
+      constraint("horizontal",4,[str("localFirst",local("top"))]),
+      constraint("corner0",1,pair(local("bottom.start"),local("left.start"))),
+      constraint("corner1",1,pair(local("bottom.end"),local("right.start"))),
+      constraint("corner2",1,pair(local("top.start"),local("left.end"))),
+      constraint("corner3",1,pair(local("top.end"),local("right.end"))),
+      dimension("width","top",x1*1000,-Math.max(y1,0.01)/2),
+      dimension("height","right",y1*1000,Math.max(x1,0.01)/2)];
+    const changed = hydrate({...plain(sketch),entities:entities.map(item=>plain(item)),
+      constraints:constraints.map(item=>plain(item))});
+    const change = make("diff.GBTTreeEditChange",{oldNode:make("tree.GBTNodeReference",{nodeId:sketch.nodeId}),
+      newNode:changed});
+    const message = make("ui.GBTUiSpecifyFeature",{elementId:target.eid,featureNodeId:sketch.nodeId,
+      featureChange:change,sequenceId:1,selectionMicroversion:null,
+      inContextEntitiesToAdd:null,editDescription:"Populate H2 rectangle sketch"});
+    const commit = make("ui.GBTUiCommit",{elementId:target.eid,featureNodeId:sketch.nodeId,
+      editDescription:"Insert feature : H2 rectangle sketch"});
+    if (typeof controller.elementConnection?.callAndPromise !== "function")
+      throw new Error("Native editor connection unavailable.");
+    controller.__onshapeNativeIncompleteFeatureEdit = {node_id:sketch.nodeId,stage:"prepared"};
+    for (const [index,command] of [message,commit].entries()) {
+      if (controller.connection?.isClosed?.() !== false || controller.getActiveElementTabId() !== target.eid ||
+          location.pathname !== `/documents/${target.did}/w/${target.wid}/e/${target.eid}`)
+        throw new Error("Sketch editor target changed; outcome unknown.");
+      controller.__onshapeNativeIncompleteFeatureEdit.stage = index === 0 ? "specify" : "commit";
+      const response = await controller.elementConnection.callAndPromise(command);
+      if (response?.error || response?.errorCode || response?.errorEnum)
+        throw new Error("Native sketch command rejected; inspect before another mutation.");
+    }
+    for (let attempt=0;attempt<10;attempt++) {
+      const after = root()?.children?.filter(node => node?.featureId === edit.feature_id);
+      if (after?.length === 1 && after[0].nodeId === sketch.nodeId &&
+          after[0].entities?.length === 4 && after[0].constraints?.length === 11 &&
+          elementModel?.get("idEditingFeature") == null && getElementMicroversion() !== job.expected_element_microversion) {
+        delete controller.__onshapeNativeIncompleteFeatureEdit;
+        return {feature_id:edit.feature_id,feature_node_id:sketch.nodeId,
+          element_microversion_before:job.expected_element_microversion,
+          element_microversion_after:getElementMicroversion(),
+          definition_candidate:true,verification:"Independent state and UI geometry checks required"};
+      }
+      await new Promise(resolve=>setTimeout(resolve,100));
+    }
+    throw new Error("Sketch command acknowledged but saved definition/idle state is unconfirmed; outcome unknown.");
+  }
   if (job.kind === "partstudio_depth_edit") {
     // Experimental isolated-target operation. Keep the whole native edit
     // lifecycle inside one editor invocation so no bridge call can interleave.
