+def test_sketch_population_is_exact_target_and_revision_bound():
+    target = {"did": "4e078dec822b4e509616b1cb", "wid": "af0627de07264acf086e646a", "eid": "9a062f0eef8bb961f8c84f8e"}
+    job = {"kind": "partstudio_populate_sketch", "target": target,
+           "expected_element_microversion": "a" * 24,
+           "sketch_edit": {"feature_id": "freshSketch_0", "entity_prefix": "box",
+                           "rectangle_m": [0, 0, 0.04, 0.02]}}
+    assert validate_job(job) == job
+    with pytest.raises(BridgeError):
+        validate_job({**job, "target": {**target, "eid": "b" * 24}})
+    with pytest.raises(BridgeError):
+        validate_job({**job, "expected_element_microversion": "stale"})
+    with pytest.raises(BridgeError):
+        validate_job({**job, "sketch_edit": {**job["sketch_edit"], "rectangle_m": [0, 0, float("nan"), 0.02]}})
+    assert not is_cad_read(job)
+
+
+@pytest.mark.asyncio
+async def test_sketch_population_broker_rejects_old_loaded_extension_before_send():
+    broker = Broker({"token": "x" * 32})
+    class Connection:
+        sent = []
+        async def send_json(self, data): self.sent.append(data)
+    broker.extension = Connection()
+    broker.extension_info = {"capabilities": []}
+    job = {"kind": "partstudio_populate_sketch",
+           "target": {"did": "4e078dec822b4e509616b1cb", "wid": "af0627de07264acf086e646a", "eid": "9a062f0eef8bb961f8c84f8e"},
+           "expected_element_microversion": "a" * 24,
+           "sketch_edit": {"feature_id": "freshSketch_0", "entity_prefix": "box", "rectangle_m": [0, 0, .04, .02]}}
+    with pytest.raises(BridgeError, match="h2_native_sketch_populate_page_v1"):
