+test('source rectangle populates an editor allocated blank sketch with typed native definitions',async()=>{
+  const temp={did:'4e078dec822b4e509616b1cb',wid:'af0627de07264acf086e646a',eid:'9a062f0eef8bb961f8c84f8e'};
+  const Type=(name,defaults)=>class {
+    constructor(){Object.assign(this,{nodeId:crypto.randomUUID(),...defaults});}
+    getMessageName(){return name;}
+    getClassId(){return 1;}
+  };
+  const Sketch=Type('bsedit.GBTMSketch',{featureId:'',featureType:'newSketch',name:'',parameters:[],entities:[],constraints:[]});
+  const Query=Type('bsedit.GBTMIndividualQuery',{deterministicIds:[],queryString:''});
+  const QueryList=Type('bsedit.GBTMParameterQueryList',{parameterId:'',queries:[]});
+  const Segment=Type('bsedit.GBTMSketchCurveSegment',{entityId:'',startPointId:'',endPointId:'',
+    isConstruction:false,startParam:0,endParam:0,geometry:null});
+  const Geometry=Type('bsedit.GBTCurveGeometryLine',{pntX:0,pntY:0,dirX:0,dirY:0});
+  const Constraint=Type('bsedit.GBTMSketchConstraint',{entityId:'',constraintType:0,parameters:[],index:0});
+  const StringParam=Type('bsedit.GBTMParameterString',{parameterId:'',value:''});
+  const EnumParam=Type('bsedit.GBTMParameterEnum',{parameterId:'',enumName:'',value:''});
+  const Quantity=Type('bsedit.GBTMParameterQuantity',{parameterId:'',value:0,units:'',expression:''});
+  const Change=Type('diff.GBTTreeEditChange',{oldNode:null,newNode:null});
+  const Reference=Type('tree.GBTNodeReference',{nodeId:''});
+  const Specify=Type('ui.GBTUiSpecifyFeature',{elementId:'',featureNodeId:'',featureChange:null,
+    sequenceId:0,selectionMicroversion:null,inContextEntitiesToAdd:null,editDescription:''});
+  const Commit=Type('ui.GBTUiCommit',{elementId:'',featureNodeId:'',editDescription:''});
+  const sketch=new Sketch();sketch.featureId='newlyAllocated_0';sketch.nodeId='fresh-sketch-node';
+  const plane=new QueryList();plane.parameterId='sketchPlane';
+  const query=new Query();query.deterministicIds=['editor-bound-top'];plane.queries=[query];sketch.parameters=[plane];
+  const root={children:[{featureId:'existing',nodeId:'prior',featureType:'datum'},sketch]};
+  let revision='a'.repeat(24), editing=sketch.featureId;
+  const types={Sketch,Query,QueryList,Segment,Geometry,Constraint,StringParam,EnumParam,Quantity,Change,Reference,Specify,Commit};
+  const modules=setup(undefined,false,revision,root,types,m=>{
+    if(m.getMessageName()==='ui.GBTUiSpecifyFeature') root.children[1]=m.featureChange.newNode;
+    if(m.getMessageName()==='ui.GBTUiCommit'){revision='b'.repeat(24);editing=null;}
+    return {errorEnum:0};
+  },temp);
+  modules.__controller.documentModel.get=k=>k==='microversionId'?{theId:micro}:
+    {get:x=>x==='microversionId'?revision:x==='idEditingFeature'?editing:null};
+  const result=await pageCommand({kind:'partstudio_populate_sketch',target:temp,
+    expected_element_microversion:'a'.repeat(24),sketch_edit:{feature_id:'newlyAllocated_0',
+      entity_prefix:'box',rectangle_m:[0,0,.04,.02]}});
+  assert.equal(result.definition_candidate,true,JSON.stringify(result));
+  assert.deepEqual(sent.map(m=>m.getMessageName()),['ui.GBTUiSpecifyFeature','ui.GBTUiCommit']);
+  assert.equal(root.children[0].featureId,'existing');
+  assert.equal(root.children[1].parameters[0].queries[0].deterministicIds[0],'editor-bound-top');
+  assert.deepEqual(root.children[1].entities.map(x=>x.entityId),
+    ['box.bottom','box.right','box.top','box.left']);
+  assert.equal(new Set(root.children[1].entities.map(x=>x.nodeId)).size,4);
+  assert.equal(root.children[1].constraints.length,11);
+  assert.deepEqual(root.children[1].constraints.filter(x=>x.constraintType===11)
+    .map(x=>x.parameters.find(p=>p.parameterId==='length').expression),['40 mm','20 mm']);
+});
+
+test('native sketch population rejects stale or unbound editor state before any RPC',async()=>{
+  const temp={did:'4e078dec822b4e509616b1cb',wid:'af0627de07264acf086e646a',eid:'9a062f0eef8bb961f8c84f8e'};
+  const sketch={featureId:'newlyAllocated_0',featureType:'newSketch',nodeId:'fresh-node',
+    entities:[],constraints:[],parameters:[]};
+  setup(undefined,false,'a'.repeat(24),{children:[sketch]}, {},null,temp);
+  const job={kind:'partstudio_populate_sketch',target:temp,expected_element_microversion:'b'.repeat(24),
+    sketch_edit:{feature_id:'newlyAllocated_0',entity_prefix:'box',rectangle_m:[0,0,.04,.02]}};
+  assert.match((await pageCommand(job)).error,/revision changed/);
+  assert.match((await pageCommand({...job,expected_element_microversion:'a'.repeat(24)})).error,/active connected editor/);
+  assert.equal(sent.length,0);
+});
+
 test('isolated native extrusion depth edit preserves exact feature identities and definition',async()=>{
