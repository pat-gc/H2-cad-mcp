             return JSONResponse({"message": str(error)}, 502)
 
-    app = Starlette(routes=[Route("/health", health), Route("/local/reconcile_known_sketch_rejection", reconcile_known_sketch_rejection, methods=["POST"]), Route("/artifacts/{handle}", artifact_download),
+    app = Starlette(routes=[Route("/health", health), Route("/local/reconcile_known_sketch_rejection", reconcile_known_sketch_rejection, methods=["POST"]), Route("/local/finalize_known_invalid_sketch_cancel", finalize_known_invalid_sketch_cancel, methods=["POST"]), Route("/artifacts/{handle}", artifact_download),
                            Route("/local/extension_reload", extension_reload, methods=["POST"]),
                            Route("/command", command, methods=["POST"]),
                            Route("/local/{tool}", local_tool, methods=["POST"]),
diff --git a/tests/test_bridge.py b/tests/test_bridge.py
index 60a17c4..d2c2a6b 100644
--- a/tests/test_bridge.py
+++ b/tests/test_bridge.py
@@ -118,6 +118,48 @@ async def test_known_pre_dispatch_recovery_requires_exact_idle_tree(tmp_path, ch
     assert broker.unknown_write is changed
 
 
+@pytest.mark.asyncio
+@pytest.mark.parametrize("changed", [False, True])
+async def test_applied_invalid_sketch_guard_releases_only_after_exact_rollback(tmp_path, changed):
+    op_id = "sketch-d9d02a9ba8b44bdea72b4bb67281c7e1"
+    target = {"did": "4e078dec822b4e509616b1cb", "wid": "af0627de07264acf086e646a", "eid": "9a062f0eef8bb961f8c84f8e"}
+    sketch = {"featureId": "sourceSketch_0", "featureType": "newSketch", "entities": [], "constraints": []}
+    rollback = {"$type": "bsedit.GBTMRollback", "nodeId": "rollback"}
+    before = {"target": target, "connected": True, "editingFeatureId": "sourceSketch_0",
+              "element_microversion": "c" * 24,
+              "tree": {"$type": "bsedit.GBTMModel", "children": [sketch, rollback]}}
+    applied = {"classification": "applied_invalid", "feature_id": "sourceSketch_0",
+               "revision_invalid": "97955554c86d659d57a74a68"}
+    journal = tmp_path / "intent.sqlite"
+    with sqlite3.connect(journal) as db:
+        db.execute("CREATE TABLE writes(op_id TEXT,target TEXT,expected_revision TEXT,action TEXT,logical_id TEXT,intent TEXT,state TEXT,receipt TEXT,observation TEXT,error TEXT,updated_at TEXT)")
+        db.execute("INSERT INTO writes(op_id,target,expected_revision,action,logical_id,intent,state,observation,error) VALUES(?,?,?,?,?,?,?,?,?)",
+                   (op_id, "/".join(target.values()), before["element_microversion"], "experimental_sketch_populate",
+                    "Outline", json.dumps({"before_state": before, "feature_id": "sourceSketch_0"}),
+                    "unknown", json.dumps(applied),
+                    "Sketch command acknowledged but saved definition/idle state is unconfirmed; outcome unknown."))
+    app = create_app({**CONFIG, "h2cad_journal": str(journal)})
+    broker = app.state.broker
+    broker.unknown_write = True
+    broker.save_guard()
+    broker.extension = object()
+    async def dispatch(job):
+        assert job["kind"] == "state" and job["target"] == target
+        tree = {"$type": "bsedit.GBTMModel", "children": [rollback]}
+        if changed:
+            tree["children"].append({"featureId": "unexpected"})
+        return {"target": target, "connected": True, "editingFeatureId": None,
+                "element_microversion": "e" * 24, "tree": tree}
+    broker.dispatch = dispatch
+    async with httpx.AsyncClient(transport=httpx.ASGITransport(app), base_url="http://127.0.0.1:8766", headers=AUTH) as client:
+        response = await client.post("/local/finalize_known_invalid_sketch_cancel", json={"op_id": op_id, "tab_id": 17})
+    assert response.status_code == (409 if changed else 200)
+    with sqlite3.connect(journal) as db:
+        state = db.execute("SELECT state FROM writes WHERE op_id=?", (op_id,)).fetchone()[0]
+    assert state == ("unknown" if changed else "rejected")
+    assert broker.unknown_write is changed
+
+
 def test_disposable_depth_edit_validation_is_exact_and_finite():
     target = {"did": "f5a8353dc826a9ec52106138", "wid": "a3baadfcc7e36a50134951d6", "eid": "a2761fa52794bee99354ae96"}
     job = {"kind": "partstudio_depth_edit", "target": target,
