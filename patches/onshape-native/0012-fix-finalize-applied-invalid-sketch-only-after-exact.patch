From a410adfa61e6c5af06b51c8aa854d2f45cd19934 Mon Sep 17 00:00:00 2001
From: patcybermind <pato.gonzalezcabrera@gmail.com>
Date: Fri, 13 Nov 2026 13:22:58 -0500
Subject: [PATCH] fix: finalize applied-invalid sketch only after exact UI
 rollback

---
 onshape_native/bridge.py | 77 +++++++++++++++++++++++++++++++++++++++-
 tests/test_bridge.py     | 42 ++++++++++++++++++++++
 2 files changed, 118 insertions(+), 1 deletion(-)

diff --git a/onshape_native/bridge.py b/onshape_native/bridge.py
index f68410d..a5cfdf3 100644
--- a/onshape_native/bridge.py
+++ b/onshape_native/bridge.py
@@ -664,6 +664,81 @@ def create_app(config=None):
             return JSONResponse({"status": "rejected_pre_dispatch", "op_id": op_id,
                                  "evidence": evidence})
 
+    async def finalize_known_invalid_sketch_cancel(request):
+        """Release one applied-invalid write only after its exact UI rollback."""
+        denied = await auth(request)
+        if denied is not None:
+            return denied
+        try:
+            body = await read_body(request)
+        except (ValueError, BridgeError):
+            return JSONResponse({"status": "blocked", "reason": "Invalid rollback request"}, 400)
+        op_id = "sketch-d9d02a9ba8b44bdea72b4bb67281c7e1"
+        target = {"did": "4e078dec822b4e509616b1cb", "wid": "af0627de07264acf086e646a", "eid": "9a062f0eef8bb961f8c84f8e"}
+        if (not isinstance(body, dict) or set(body) != {"op_id", "tab_id"}
+                or body["op_id"] != op_id or type(body["tab_id"]) is not int or body["tab_id"] < 0):
+            return JSONResponse({"status": "blocked", "reason": "Only the known failed sketch can be finalized"}, 400)
+        if not broker.unknown_write or broker.guard_invalid or broker.pending or broker.extension is None:
+            return JSONResponse({"status": "blocked", "reason": "Bridge safety state differs from known failed sketch"}, 409)
+        try:
+            live = await broker.dispatch({"kind": "state", "target": target, "tab_id": body["tab_id"]})
+        except BridgeError as error:
+            return JSONResponse({"status": "blocked", "reason": f"Read-only rollback state unavailable: {error}"}, 409)
+        path = config.get("h2cad_journal")
+        if not isinstance(path, str) or not Path(path).is_absolute():
+            return JSONResponse({"status": "blocked", "reason": "Pinned journal unavailable"}, 409)
+        async with broker.command_lock:
+            if not broker.unknown_write or broker.guard_invalid or broker.pending:
+                return JSONResponse({"status": "blocked", "reason": "Bridge safety state changed"}, 409)
+            try:
+                with sqlite3.connect(path, timeout=2, isolation_level=None) as db:
+                    db.execute("PRAGMA synchronous=FULL")
+                    db.execute("BEGIN IMMEDIATE")
+                    db.row_factory = sqlite3.Row
+                    rows = db.execute("SELECT * FROM writes WHERE state IN ('prepared','sent','unknown')").fetchall()
+                    if len(rows) != 1 or rows[0]["op_id"] != op_id:
+                        raise ValueError("Journal has another unresolved operation")
+                    row = rows[0]
+                    intent = json.loads(row["intent"])
+                    before = intent.get("before_state")
+                    applied = json.loads(row["observation"] or "{}")
+                    feature_id = intent.get("feature_id")
+                    if (row["action"] != "experimental_sketch_populate" or row["state"] != "unknown"
+                            or row["target"] != "/".join(target.values())
+                            or row["error"] != "Sketch command acknowledged but saved definition/idle state is unconfirmed; outcome unknown."
+                            or not isinstance(before, dict) or not isinstance(before.get("tree"), dict)
+                            or before.get("element_microversion") != row["expected_revision"]
+                            or before.get("editingFeatureId") != feature_id
+                            or applied.get("classification") != "applied_invalid"
+                            or applied.get("feature_id") != feature_id
+                            or applied.get("revision_invalid") != "97955554c86d659d57a74a68"
+                            or live.get("target") != target or live.get("connected") is not True
+                            or live.get("editingFeatureId") is not None
+                            or live.get("element_microversion") in {row["expected_revision"], applied["revision_invalid"]}):
+                        raise ValueError("Known applied-invalid journal or rollback state differs")
+                    expected_tree = json.loads(json.dumps(before["tree"]))
+                    expected_tree["children"] = [child for child in expected_tree.get("children", [])
+                                                 if child.get("featureId") != feature_id]
+                    if (len(expected_tree["children"]) != len(before["tree"].get("children", [])) - 1
+                            or live.get("tree") != expected_tree):
+                        raise ValueError("Normal editor did not restore the exact prior default tree")
+                    evidence = {**applied, "classification": "applied_invalid_rolled_back",
+                                "revision_rolled_back": live["element_microversion"],
+                                "default_tree_restored": True}
+                    db.execute("UPDATE writes SET state='rejected', observation=?, error=?, updated_at=CURRENT_TIMESTAMP WHERE op_id=? AND state='unknown'",
+                               (json.dumps(evidence, sort_keys=True), "Applied-invalid sketch canceled; exact default tree observed", op_id))
+                    db.execute("COMMIT")
+            except (OSError, sqlite3.Error, ValueError, KeyError, TypeError) as error:
+                return JSONResponse({"status": "blocked", "reason": str(error)}, 409)
+            broker.unknown_write = False
+            try:
+                broker.save_guard()
+            except BridgeError as error:
+                broker.unknown_write = True
+                return JSONResponse({"status": "blocked", "reason": str(error)}, 409)
+            return JSONResponse({"status": "rejected_after_rollback", "op_id": op_id,
+                                 "evidence": evidence})
+
     async def extension_reload(request):
         denied = await auth(request)
         if denied is not None:
@@ -844,7 +919,7 @@ def create_app(config=None):
