Subject: [PATCH] fix: bind REMOVE scope completeness to unchanged source
 sketch

---
 onshape_native/source_extrusion.py       | 5 +++++
 tests/fixtures/source_remove_intent.json | 2 +-
 tests/test_source_extrusion.py           | 9 +++++++++
 3 files changed, 15 insertions(+), 1 deletion(-)

diff --git a/onshape_native/source_extrusion.py b/onshape_native/source_extrusion.py
index b2fd643..5126fe5 100644
--- a/onshape_native/source_extrusion.py
+++ b/onshape_native/source_extrusion.py
@@ -87,6 +87,11 @@ def validate_source_extrusion_intent(intent, target, lookup):
         if (target_source.get("name")!=logical or target_source.get("featureType")!="extrude"
                 or next((p.get("value") for p in target_source.get("parameters",[]) if p.get("parameterId")=="operationType"),None)!="NEW"):
             raise ValueError("REMOVE target must be an observed source NEW extrusion")
+        target_sketch=ti.get("saved_sketch_definition")
+        if (not isinstance(target_sketch,dict) or target_sketch.get("featureType")!="newSketch"
+                or not target_sketch.get("nodeId") or target_sketch.get("featureId")!=ti.get("sketch_feature_id")
+                or [n for n in before["tree"]["children"] if n.get("featureId")==ti.get("sketch_feature_id")] != [target_sketch]):
+            raise ValueError("Target NEW source sketch changed since its observed creation")
         profile=ti.get("sketch_source_feature",{})
         entities=profile.get("entities",[])
         single_circle=(len(entities)==1 and entities[0].get("btType")=="BTMSketchCurve-4"
