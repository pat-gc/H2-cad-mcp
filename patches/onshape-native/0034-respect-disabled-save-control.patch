+  // Compatibility field normal_ui_finish means invocation only, never acceptance
+  // or saved state. Consumers should prefer the explicit new field.
+  const saveInvocation = invoked => ({normal_ui_save_invoked:invoked,normal_ui_finish:invoked});
   if (job.kind === "editor_health") {
     if (!elementModel || !getMicroversion()) throw new Error("Target editor is not ready.");
     const motion = controller.__onshapeNativeMotionV1;
@@ -332,7 +337,7 @@ export async function pageCommand(job) {
         parentTag: el.parentElement?.tagName?.toLowerCase() || null,
         parentClassName: String(el.parentElement?.className || "").slice(0, 180),
         visible: el.getClientRects().length > 0 && getComputedStyle(el).visibility !== "hidden",
-        enabled: !el.disabled && el.getAttribute("aria-disabled") !== "true",
+        enabled: featureSaveEnabled(el),
         centerHit: hit === el ? "self" : hit && el.contains(hit) ? "descendant" : hit ? "other" : "unavailable",
