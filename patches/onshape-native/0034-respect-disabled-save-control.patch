+            definition_candidate:true,active_constraint_graph:activeGraph,...saveInvocation(saveClicked),
             verification:"Independent saved state and editable UI checks required"};
         }
         if (!saveClicked && elementModel?.get("idEditingFeature") === edit.feature_id) {
           const buttons = [...document.querySelectorAll('.feature-dialog .ns-dialog-button-ok')]
-            .filter(node=>node.getClientRects().length>0 && !node.disabled &&
-              node.getAttribute("aria-disabled")!=="true");
+            .filter(node=>node.getClientRects().length>0 && featureSaveEnabled(node));
           if (buttons.length === 1) {
             if (controller.connection?.isClosed?.() !== false ||
                 controller.getActiveElementTabId() !== target.eid ||
@@ -754,7 +758,7 @@ export async function pageCommand(job) {
         location.pathname === `/documents/${target.did}/w/${target.wid}/e/${target.eid}`) {
       controller.__onshapeNativeIncompleteFeatureEdit.stage = "await-saved-readback";
       return {op_id:job.op_id,feature_id:edit.feature_id,definition_candidate:true,
-        active_constraint_graph:activeGraph,normal_ui_finish:saveClicked,completion_pending:true,
+        active_constraint_graph:activeGraph,...saveInvocation(saveClicked),completion_pending:true,
         verification:"Commit acknowledged; saved idle state requires independent readback"};
     }
     throw new Error("Sketch command acknowledged but saved definition/idle state is unconfirmed; outcome unknown.");
@@ -867,13 +871,12 @@ export async function pageCommand(job) {
           return {op_id:job.op_id,feature_id:edit.feature_id,sketch_feature_id:edit.sketch_feature_id,
             element_microversion_before:job.expected_element_microversion,
             element_microversion_after:getElementMicroversion(),definition_candidate:true,
-            region_source_verified:true,normal_ui_finish:saveClicked,
+            region_source_verified:true,...saveInvocation(saveClicked),
             verification:"Independent tree, regenerated solid, and editable UI inspection required"};
         }
         if (!saveClicked && elementModel?.get("idEditingFeature")===edit.feature_id) {
           const buttons = [...document.querySelectorAll('.feature-dialog .ns-dialog-button-ok')]
-            .filter(node=>node.getClientRects().length>0 && !node.disabled &&
-              node.getAttribute("aria-disabled")!=="true");
+            .filter(node=>node.getClientRects().length>0 && featureSaveEnabled(node));
           if (buttons.length===1) {
             if (controller.connection?.isClosed?.() !== false ||
                 controller.getActiveElementTabId() !== target.eid ||
@@ -890,7 +893,7 @@ export async function pageCommand(job) {
     }
     const candidate = root()?.children?.filter(node=>node?.featureId===edit.feature_id);
     const candidateDepth = candidate?.[0]?.parameters?.filter(p=>p?.parameterId==="depth");
-    if (saveClicked && candidate?.length===1 && candidate[0].nodeId===feature.nodeId &&
+    if (candidate?.length===1 && candidate[0].nodeId===feature.nodeId &&
         candidateDepth?.length===1 && candidateDepth[0].value===edit.to_mm &&
         candidateDepth[0].expression===`${edit.to_mm} mm` &&
         getElementMicroversion()!==job.expected_element_microversion &&
@@ -898,8 +901,8 @@ export async function pageCommand(job) {
         location.pathname===`/documents/${target.did}/w/${target.wid}/e/${target.eid}`) {
       controller.__onshapeNativeIncompleteFeatureEdit.stage="await-saved-readback";
       return {op_id:job.op_id,feature_id:edit.feature_id,sketch_feature_id:edit.sketch_feature_id,
-        definition_candidate:true,region_source_verified:true,normal_ui_finish:true,
-        completion_pending:true,verification:"Save invoked; saved idle state requires independent readback"};
+        definition_candidate:true,region_source_verified:true,...saveInvocation(saveClicked),
+        completion_pending:true,verification:"Commit acknowledged; saved idle state requires independent readback"};
     }
     throw new Error("Extrusion command acknowledged but saved definition/idle state is unconfirmed; outcome unknown.");
   }
diff --git a/skills/onshape-native-modeling/SKILL.md b/skills/onshape-native-modeling/SKILL.md
index d6cdd84..351175d 100644
--- a/skills/onshape-native-modeling/SKILL.md
+++ b/skills/onshape-native-modeling/SKILL.md
@@ -27,6 +27,11 @@ The result `h2_command_completed` reports H2 definition checks only. Independent
 verify saved solid geometry and human editability. If the tool returns
 `needs_readback`, inspect the pinned journal and exact editor state; never invoke
 the tool again on that target until the uncertain operation is reconciled.
+The receipt field `normal_ui_save_invoked` reports only whether the adapter
+invoked the Save control; legacy `normal_ui_finish` is an invocation-only alias.
+Neither proves that Onshape accepted Save or closed the editor. A CSS-disabled
+Save DIV is not invoked. `completion_pending` preserves the original operation
+for exact saved-state reconciliation, including when Save was not invoked.
 
 The standalone MCP plate command does not yet orchestrate the normal browser
 selection needed between saving the sketch and starting Extrude. For this H2
