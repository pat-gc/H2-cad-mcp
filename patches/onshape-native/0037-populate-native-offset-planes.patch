+      if (byId[k].expression!==expression || byId[k].value!==value || byId[k].units!==units)
+        throw new Error("Fresh native plane defaults required.");
+    }
+    if (["oppositeDirection","flipAlignment","flipNormal"].some(k=>byId[k].value!==false) ||
+        byId.entities.queries?.length!==1 || byId.entities.queries[0].deterministicIds?.length!==1)
+      throw new Error("Fresh reference-bound plane required.");
+    byId.offset.expression=edit.expression; byId.offset.value=edit.value;
+    byId.oppositeDirection.value=edit.opposite_direction;
+    if (!equal(expected,edit.expected_tree)) throw new Error("Plane edit changes unrelated fields.");
+    const make = (name,fields={}) => hydrate({$type:name,...plain(fields)});
