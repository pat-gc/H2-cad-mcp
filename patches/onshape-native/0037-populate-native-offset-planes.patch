+"""Definition-only plane evidence. Never allocate identities or infer a frame."""
+import copy
+import ast
+import json
+import math
+import re
+
+
+def validate_stage(stage):
+    """Recheck symbolic sign from positive source inputs without evaluating code."""
+    expression = stage["source_expression"]
+    literal = re.fullmatch(r"([+-]?(?:\d+(?:\.\d*)?|\.\d+))\s*mm", expression)
+    assumptions = stage["positive_variable_assumptions"]
+    if literal:
+        value = float(literal[1])
+        if stage["dependencies"] or assumptions:
+            raise ValueError("Literal plane has symbolic dependencies")
+    else:
+        names = re.findall(r"#[A-Za-z][A-Za-z0-9_]*", expression)
+        if set(names) != set(assumptions) or set(names) != set(stage["dependencies"]):
+            raise ValueError("Symbolic plane dependencies differ")
+        aliases = {name: "v" + str(i) for i, name in enumerate(dict.fromkeys(names))}
+        parsed = ast.parse(re.sub(r"#[A-Za-z][A-Za-z0-9_]*", lambda m: aliases[m[0]], expression), mode="eval")
+        def linear(node):
+            if isinstance(node, ast.Constant) and type(node.value) in (float, int):
+                return {}, float(node.value)
+            if isinstance(node, ast.Name) and node.id in aliases.values():
+                return {node.id: 1.0}, 0.0
+            if isinstance(node, ast.UnaryOp) and isinstance(node.op, (ast.UAdd, ast.USub)):
+                terms, constant = linear(node.operand)
+                sign = -1 if isinstance(node.op, ast.USub) else 1
+                return {k: v*sign for k,v in terms.items()}, constant*sign
+            if isinstance(node, ast.BinOp):
+                a, x = linear(node.left); b, y = linear(node.right)
+                if isinstance(node.op, (ast.Add, ast.Sub)):
+                    sign = -1 if isinstance(node.op, ast.Sub) else 1
+                    return {k: a.get(k,0)+sign*b.get(k,0) for k in a.keys()|b.keys()}, x+sign*y
+                if isinstance(node.op, ast.Mult) and not (a and b):
+                    return ({k:v*y for k,v in a.items()} if a else {k:v*x for k,v in b.items()}), x*y
+                if isinstance(node.op, ast.Div) and not b and y:
+                    return {k:v/y for k,v in a.items()}, x/y
+            raise ValueError("Unsupported plane expression")
+        terms, constant = linear(parsed.body)
+        if constant or not terms or not (all(v>0 for v in terms.values()) or all(v<0 for v in terms.values())):
+            raise ValueError("Symbolic sign cannot be proven")
+        value = 0.0
+        for name, alias in aliases.items():
+            assumption = assumptions[name]
+            text = assumption["expression"]
+            if not re.fullmatch(r"[+]?(?:\d+(?:\.\d*)?|\.\d+)\s*mm", text) or assumption["required_domain"] != "positive":
+                raise ValueError("Positive literal source domain required")
+            numeric = float(text.strip()[:-2])
+            if not numeric > 0 or numeric != assumption["value_mm"]:
+                raise ValueError("Positive variable value differs")
+            value += terms[alias]*numeric
+    opposite = value < 0
+    expected_expression = f"{abs(value):g} mm" if literal and opposite else f"-({expression})" if opposite else expression
+    if (not math.isfinite(value) or abs(value)>500000 or stage["magnitude_mm"] != abs(value)
+            or stage["magnitude_expression"] != expected_expression or stage["opposite_direction"] is not opposite):
+        raise ValueError("Source plane sign, magnitude or symbolic expression differs")
+
+
+def validate_plane_edit(edit, before_tree):
+    if (not isinstance(edit, dict) or set(edit) != {"feature_id", "expression", "value", "opposite_direction", "before_tree", "expected_tree"}
+            or edit["before_tree"] != before_tree or type(edit["opposite_direction"]) is not bool
+            or type(edit["value"]) not in (int, float) or not math.isfinite(edit["value"])
+            or not 0 <= edit["value"] <= 500000 or not isinstance(edit["expression"], str)
+            or not edit["expression"] or len(edit["expression"]) > 512):
+        raise ValueError("Bounded exact plane edit required")
+    expected = copy.deepcopy(before_tree)
+    nodes = [n for n in expected["children"] if n.get("featureId") == edit["feature_id"]]
+    if len(nodes) != 1 or nodes[0].get("featureType") != "cPlane" or not nodes[0].get("nodeId"):
+        raise ValueError("Exact plane draft identity required")
+    node = nodes[0]
+    if (node.get("$type") != "bsedit.GBTMFeature" or node.get("suppressed") is not False
+            or node.get("hasUserCode") is not False or node.get("namespace") != ""
+            or node.get("subFeatures") != [] or node.get("parameterLibraries") != []):
+        raise ValueError("Native default plane schema required")
+    params = node["parameters"]
+    p = {x["parameterId"]: x for x in params}
+    types = {"entities": "QueryList", "cplaneType": "Enum", "offset": "Quantity", "angle": "Quantity",
+             "oppositeDirection": "Boolean", "flipAlignment": "Boolean", "flipNormal": "Boolean", "width": "Quantity", "height": "Quantity"}
+    if len(p) != len(params) or set(p) != set(types):
+        raise ValueError("Plane parameter schema differs")
+    for key, kind in types.items():
+        if p[key].get("$type") != "bsedit.GBTMParameter" + kind or not p[key].get("nodeId") or p[key].get("hasUserCode") is not False:
+            raise ValueError("Plane parameter type or identity differs")
+    if p["cplaneType"].get("enumName") != "CPlaneType" or p["cplaneType"].get("value") != "OFFSET":
+        raise ValueError("OFFSET required")
+    for key, expr, value, units in (("offset", "25 mm", 25, "millimeter"), ("angle", "0 deg", 0, "degree"),
+                                    ("width", "150 mm", 150, "millimeter"), ("height", "150 mm", 150, "millimeter")):
+        if any(p[key].get(k) != v for k, v in {"expression": expr, "value": value, "units": units}.items()):
+            raise ValueError("Fresh default plane required")
+    if any(p[k].get("value") is not False for k in ("oppositeDirection", "flipAlignment", "flipNormal")):
+        raise ValueError("Fresh default plane direction required")
+    p["offset"].update(expression=edit["expression"], value=edit["value"])
+    p["oppositeDirection"]["value"] = edit["opposite_direction"]
+    if expected != edit["expected_tree"]:
+        raise ValueError("Plane edit changes unrelated fields")
+    return node
+
+
+def edit_from_intent(intent):
+    stage = intent["source_stages"][intent["source_index"]]
+    return {"feature_id": intent["before_state"]["editingFeatureId"],
+            "expression": stage["magnitude_expression"], "value": stage["magnitude_mm"],
+            "opposite_direction": stage["opposite_direction"],
+            "before_tree": intent["before_state"]["tree"], "expected_tree": intent["expected_tree"]}
+
+
+def validate_plane_intent(intent, target, lookup):
+    before, baseline = intent["before_state"], intent["baseline"]
+    index, stages = intent["source_index"], intent["source_stages"]
+    if type(index) is not int or not 0 <= index < len(stages):
+        raise ValueError("Source plane index differs")
+    edit = edit_from_intent(intent)
+    validate_stage(stages[index])
+    validate_plane_edit(edit, before["tree"])
+    fid = edit["feature_id"]
+    if (before.get("target") != target or baseline.get("target") != target
+            or before.get("connected") is not True or baseline.get("connected") is not True
+            or baseline.get("editingFeatureId", "missing") is not None
+            or baseline.get("h2Readback", {}).get("incompleteFeatureEdit")
+            or not re.fullmatch(r"[a-f0-9]{24}", str(baseline.get("element_microversion", "")))
+            or baseline.get("element_microversion") == before.get("element_microversion")):
+        raise ValueError("Exact saved idle pre-allocation baseline required")
+    stripped = copy.deepcopy(before["tree"])
+    stripped["children"] = [n for n in stripped["children"] if n.get("featureId") != fid]
+    if stripped != baseline["tree"] or any(n.get("featureId") == fid for n in baseline["tree"]["children"]):
+        raise ValueError("Unrelated baseline changed or draft already existed")
+    draft = next(n for n in before["tree"]["children"] if n.get("featureId") == fid)
+    queries = next(p for p in draft["parameters"] if p["parameterId"] == "entities").get("queries")
+    binding, stage = intent["reference_binding"], stages[index]
+    qdata = binding.get("query_data", {})
+    details = qdata.get("evaluationDetails", {})
+    if (not isinstance(queries, list) or len(queries) != 1 or binding.get("query") != queries[0]
+            or binding.get("target") != target or binding.get("element_microversion") != before["element_microversion"]
+            or queries[0].get("$type") != "bsedit.GBTMIndividualQuery" or not queries[0].get("nodeId")
+            or queries[0].get("hasUserCode") is not False or queries[0].get("queryString") != ""
+            or not queries[0].get("deterministicIds") or len(queries[0]["deterministicIds"]) != 1
+            or qdata.get("deterministicIds") != queries[0]["deterministicIds"]
+            or stage.get("reference_plane") not in ("Top", "Right")
+            or qdata.get("featureId") != stage["reference_plane"] or qdata.get("selectionName") != "Face"
+            or qdata.get("hasErrorEntity") is not False or qdata.get("isTemporaryFakeDataForSelection") is not False
+            or details.get("fullOperationId") != stage["reference_plane"] + ".planeOp"
+            or details.get("entityType") != 2 or details.get("status") != 0 or details.get("outsideExactDependencies") is not False):
+        raise ValueError("Same-revision reference query proof differs")
+    def prior(op_id, action, logical_id):
+        row = lookup(op_id)
+        if (not row or row["state"] != "observed" or row["action"] != action or row["logical_id"] != logical_id
+                or row["target"] != "/".join(target[k] for k in ("did", "wid", "eid"))):
+            raise ValueError("Observed source journal identity required")
+        pi, obs = json.loads(row["intent"]), json.loads(row["observation"] or "{}")
+        pfid = obs.get("feature_id")
+        if not pfid or obs.get("definition_observed") is not True or pi["before_state"].get("editingFeatureId") != pfid:
+            raise ValueError("Saved source identity unverified")
+        nodes = [n for n in pi["expected_tree"]["children"] if n.get("featureId") == pfid]
+        if len(nodes) != 1 or nodes != [n for n in baseline["tree"]["children"] if n.get("featureId") == pfid]:
+            raise ValueError("Previously saved feature changed")
+        return pi, pfid, nodes[0]
+    previous = intent["previous_op_ids"]
+    if len(previous) != index or len(set(previous)) != index:
+        raise ValueError("Every preceding source plane required")
+    identities = {}
+    for i, op_id in enumerate(previous):
+        pi, pfid, node = prior(op_id, "experimental_plane_populate", stages[i]["logical_id"])
+        if pi.get("source_stages") != stages or pi.get("source_index") != i:
+            raise ValueError("Preceding plane source differs")
+        identities[stages[i]["logical_id"]] = pfid
+    if identities != intent["identity_map"]:
+        raise ValueError("Plane identity map differs")
+    if set(intent["variable_op_ids"]) != set(stage["dependencies"]):
+        raise ValueError("Dependency journal map differs")
+    variables = {}
+    for name, op_id in intent["variable_op_ids"].items():
+        pi, pfid, node = prior(op_id, "experimental_variable_populate", name)
+        vs = intent["variable_stages"]
+        vi = next((i for i, v in enumerate(vs) if v["logical_id"] == name), None)
+        if vi is None or pi.get("source_stages") != vs or pi.get("source_index") != vi:
+            raise ValueError("Source variable provenance differs")
+        p = {p["parameterId"]: p for p in node["parameters"]}
+        assumption = stage["positive_variable_assumptions"][name]
+        if (node.get("featureType") != "assignVariable" or p["name"].get("value") != name[1:]
+                or p["mode"].get("value") != "ASSIGNED" or p["variableType"].get("value") != "LENGTH"
+                or not assumption["value_mm"] > 0
+                or any(p[k].get("expression") != assumption["expression"] or p[k].get("value") != assumption["value_mm"]
+                       or p[k].get("units") != "millimeter" for k in ("value", "lengthValue"))):
+            raise ValueError("Live positive source variable differs")
+        variables[name] = pfid
+    if variables != intent["variable_identity_map"]:
+        raise ValueError("Variable identity map differs")
+    return edit
+
+
+def verify_saved_source_plane(before, expected, after, target, stage):
+    if (after.get("target") != target or after.get("connected") is not True
+            or after.get("editingFeatureId", "missing") is not None
+            or after.get("h2Readback", {}).get("incompleteFeatureEdit")
+            or not re.fullmatch(r"[a-f0-9]{24}", str(after.get("element_microversion", "")))
+            or after["element_microversion"] == before["element_microversion"] or after.get("tree") != expected):
+        raise ValueError("Exact stable saved plane tree and idle revision required")
+    node = next(n for n in expected["children"] if n.get("featureId") == before["editingFeatureId"])
+    return {"feature_id": node["featureId"], "node_id": node["nodeId"], "logical_id": stage["logical_id"],
+            "definition_observed": True, "revision_before": before["element_microversion"],
+            "revision_after": after["element_microversion"], "frame_verified": False,
+            "regeneration_verified": False, "ui_editability_verified": False}
