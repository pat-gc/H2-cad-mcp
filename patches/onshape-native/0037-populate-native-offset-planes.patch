+          throw new Error("Plane editor changed before Save; outcome unknown.");
+        buttons[0].click(); invoked=true;
+      }
+    }
+    controller.__onshapeNativeIncompleteFeatureEdit.stage="await-saved-readback";
+    return {op_id:job.op_id,feature_id:edit.feature_id,definition_candidate:true,
+      completion_pending:true,...saveInvocation(invoked),regeneration_verified:false};
