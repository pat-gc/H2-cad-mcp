   }
+  if (job.kind === "partstudio_populate_plane") {
+    const edit = job.plane_edit;
+    if (!/^plane-[a-f0-9]{32}$/.test(job.op_id || "") ||
+        target.did !== "4e078dec822b4e509616b1cb" || target.wid !== "af0627de07264acf086e646a" ||
+        !/^[a-f0-9]{24}$/.test(target.eid) || ["45730d1931712e2c548fae00","39a2e2afc5bc43eea167e938"].includes(target.eid))
+      throw new Error("Journaled plane in authorized temporary studio required.");
+    if (!edit || typeof edit.expression !== "string" || !edit.expression || edit.expression.length>512 ||
+        !Number.isFinite(edit.value) || edit.value<0 || edit.value>500000 || typeof edit.opposite_direction!=="boolean")
+      throw new Error("Validated plane magnitude and direction required.");
+    const root = () => controller.documentClientCache?.getModelTreeState(target.eid)?.diffableModelTree?.getRoot();
+    const exactEditor = () => controller.connection?.isClosed?.() === false &&
+      controller.getActiveElementTabId() === target.eid &&
+      location.pathname === `/documents/${target.did}/w/${target.wid}/e/${target.eid}`;
+    if (!exactEditor() || controller.__onshapeNativeIncompleteFeatureEdit ||
+        elementModel?.get("idEditingFeature") !== edit.feature_id ||
+        !job.expected_element_microversion || getElementMicroversion() !== job.expected_element_microversion)
+      throw new Error("Exact fresh plane editor unavailable.");
+    const matches = root()?.children?.filter(n=>n?.featureId===edit.feature_id && n.featureType==="cPlane");
+    if (matches?.length!==1 || !matches[0].nodeId || matches[0].suppressed!==false)
+      throw new Error("One active unsuppressed plane required.");
+    const feature = matches[0];
+    const stableTree = x => Array.isArray(x) ? x.map(stableTree) : x && typeof x === "object"
