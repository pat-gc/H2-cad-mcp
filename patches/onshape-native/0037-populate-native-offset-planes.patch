+    const equal = (a,b) => JSON.stringify(stableTree(a))===JSON.stringify(stableTree(b));
+    if (!equal(plain(root()),edit.before_tree)) throw new Error("Plane baseline changed before dispatch.");
+    const expected = plain(root());
+    const newFeature = expected.children.find(n=>n.featureId===edit.feature_id);
+    const params = newFeature.parameters;
+    const byId = Object.fromEntries(params.map(p=>[p.parameterId,p]));
+    const types={entities:"QueryList",cplaneType:"Enum",offset:"Quantity",angle:"Quantity",
+      oppositeDirection:"Boolean",flipAlignment:"Boolean",flipNormal:"Boolean",width:"Quantity",height:"Quantity"};
+    if (params.length!==9 || Object.keys(byId).length!==9 || Object.keys(types).some(k=>
+      byId[k]?.$type!=="bsedit.GBTMParameter"+types[k] || !byId[k]?.nodeId || byId[k]?.hasUserCode!==false) ||
+      newFeature.$type!=="bsedit.GBTMFeature" || newFeature.hasUserCode!==false || newFeature.namespace!=="" ||
+      !equal(newFeature.subFeatures,[]) || !equal(newFeature.parameterLibraries,[]) ||
