+import copy
+import json
+import sqlite3
+from pathlib import Path
+
+import httpx
+import pytest
+
+from onshape_native.bridge import create_app, validate_job, BridgeError
+from onshape_native.plane_writer import validate_plane_intent, verify_saved_source_plane, edit_from_intent
+
+FIXTURES = json.loads((Path(__file__).parent / "fixtures/native_plane_intents.json").read_text())
+OP = "plane-" + "a" * 32
+TOKEN = "test-plane-token-" + "a" * 32
+
+
+def scenario(i=0):
+    fixture = copy.deepcopy(FIXTURES[i])
+    intent, rows = fixture["intent"], fixture["rows"]
+    before = intent["before_state"]
+    target = before["target"]
+    after = {**before, "tree": copy.deepcopy(intent["expected_tree"]), "editingFeatureId": None,
+             "element_microversion": "a" * 24}
+    return intent, rows, target, after
+
+
+@pytest.mark.parametrize("index", range(3))
+def test_definition_proof_preserves_symbolic_expressions(index):
+    intent, rows, target, after = scenario(index)
+    edit = validate_plane_intent(intent, target, rows.get)
+    stage = intent["source_stages"][intent["source_index"]]
+    proof = verify_saved_source_plane(intent["before_state"], intent["expected_tree"], after, target, stage)
+    assert proof["definition_observed"] and not proof["frame_verified"] and not proof["regeneration_verified"]
+    assert edit["expression"] == stage["magnitude_expression"]
+
+
+@pytest.mark.parametrize("fault", ["source", "source_sign", "source_value", "baseline", "query", "draft", "unrelated",
+    "variable_unknown", "variable_target", "variable_source", "variable_map", "previous", "prior_changed"])
+def test_native_rechecks_journal_and_source_before_population(fault):
+    intent, rows, target, _ = scenario(1)
+    stage = intent["source_stages"][3]
+    if fault == "source": stage["magnitude_expression"] = "57 mm"
+    if fault == "source_sign": stage["opposite_direction"] = False
+    if fault == "source_value": stage["magnitude_mm"] = 58
+    if fault == "baseline": intent["baseline"]["editingFeatureId"] = "busy"
+    if fault == "query": intent["reference_binding"]["query_data"]["featureId"] = "Top"
+    if fault == "draft": intent["before_state"]["tree"]["children"][-2]["parameters"][2]["expression"] = "24 mm"
+    if fault == "unrelated": intent["expected_tree"]["children"][0]["nodeId"] = "changed"
+    if fault.startswith("variable_"):
+        row = rows[intent["variable_op_ids"]["#width"]]
+        if fault == "variable_unknown": row["state"] = "unknown"
+        if fault == "variable_target": row["target"] = "other"
+        if fault == "variable_source":
+            pi = json.loads(row["intent"]); pi["source_stages"][1]["expression"] = "91 mm"; row["intent"] = json.dumps(pi)
+        if fault == "variable_map": intent["variable_identity_map"]["#width"] = "wrong"
+    if fault == "previous": intent["previous_op_ids"].pop()
+    if fault == "prior_changed":
+        row = rows[intent["previous_op_ids"][0]]; pi=json.loads(row["intent"])
+        pi["expected_tree"]["children"][0]["nodeId"] = "wrong"; row["intent"] = json.dumps(pi)
+    with pytest.raises(ValueError): validate_plane_intent(intent, target, rows.get)
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("fault", [None, "unstable", "busy", "changed", "other_pending", "source", "expected", "wrong_row", "marker_missing", "marker_blocked", "marker_wrong_op"])
+async def test_reconcile_is_read_only_and_retains_barrier_on_mismatch(tmp_path, fault):
+    intent, rows, target, after = scenario(0)
+    journal = tmp_path / "journal.sqlite"
+    if fault == "source": intent["source_stages"][0]["magnitude_expression"] = "21 mm"
+    if fault == "expected": intent["expected_tree"]["children"][0]["nodeId"] = "changed"
+    with sqlite3.connect(journal) as db:
+        db.execute("CREATE TABLE writes(op_id TEXT,target TEXT,expected_revision TEXT,action TEXT,logical_id TEXT,intent TEXT,state TEXT,receipt TEXT,observation TEXT,error TEXT,updated_at TEXT)")
+        db.execute("INSERT INTO writes(op_id,target,expected_revision,action,logical_id,intent,state) VALUES(?,?,?,?,?,?,?)",
+                   (OP, "/".join(target.values()), intent["before_state"]["element_microversion"],
+                    "wrong" if fault == "wrong_row" else "experimental_plane_populate", "Chassis height", json.dumps(intent), "unknown"))
+        if fault == "other_pending": db.execute("INSERT INTO writes(op_id,state) VALUES('other','sent')")
+    app = create_app({"token": TOKEN, "port": 8766, "h2cad_journal": str(journal), "h2cad_create_target": target})
+    broker = app.state.broker
+    broker.unknown_write = True
+    broker.extension = object()
+    broker.extension_info = {"capabilities": ["h2_native_plane_populate_page_v1"]}
+    dispatched = []
+    async def dispatch(job):
+        dispatched.append(job)
+        assert job["kind"] == "state"
+        live = copy.deepcopy(after)
+        if job.get("retire_acknowledged_op_id") and fault != "marker_missing":
+            live["marker_retirement"] = {"op_id": "other" if fault == "marker_wrong_op" else OP,
+                                         "status": "blocked" if fault == "marker_blocked" else "absent"}
+        if fault == "busy": live["editingFeatureId"] = intent["before_state"]["editingFeatureId"]
+        if fault == "changed": live["tree"]["children"][0]["nodeId"] = "changed"
+        if fault == "unstable" and len(dispatched) == 2: live["element_microversion"] = "c" * 24
+        return live
+    broker.dispatch = dispatch
+    async with httpx.AsyncClient(transport=httpx.ASGITransport(app), base_url="http://127.0.0.1:8766", headers={"Authorization": "Bearer " + TOKEN}) as client:
+        response = await client.post("/local/reconcile_saved_source_plane", json={"op_id": OP, "tab_id": 7})
+    assert response.status_code == (409 if fault else 200), response.text
+    assert len(dispatched) == (1 if fault in {"busy", "changed", "source", "expected", "wrong_row", "other_pending"} else 2)
+    assert broker.unknown_write is bool(fault)
+    with sqlite3.connect(journal) as db:
+        assert db.execute("SELECT state FROM writes WHERE op_id=?", (OP,)).fetchone()[0] == ("unknown" if fault else "observed")
+
+
+def test_plane_job_validation():
+    intent, rows, target, after = scenario()
+    job = {"kind": "partstudio_populate_plane", "target": target, "op_id": OP,
+           "expected_element_microversion": intent["before_state"]["element_microversion"],
+           "plane_edit": edit_from_intent(intent)}
+    assert validate_job(job) == job
+    for field, value in [("value", -20), ("feature_id", "wrong"), ("opposite_direction", "false")]:
+        with pytest.raises(BridgeError): validate_job({**job, "plane_edit": {**job["plane_edit"], field: value}})
