+    let candidate=false;
+    for (let attempt=0;attempt<30;attempt++) {
+      if (!exactEditor()) break;
+      if (JSON.stringify(stable(plain(root())))===expectedJSON && getElementMicroversion()!==job.expected_element_microversion) {
+        candidate=true; break;
+      }
+      await new Promise(resolve=>setTimeout(resolve,100));
+    }
+    if (!candidate)
+      throw new Error("Plane saved definition unconfirmed; outcome unknown.");
+    let invoked=false;
+    if (elementModel?.get("idEditingFeature")===edit.feature_id) {
+      const buttons=[...document.querySelectorAll('.feature-dialog .ns-dialog-button-ok')]
