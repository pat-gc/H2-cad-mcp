@@ -595,6 +664,81 @@ def create_app(config=None):
                              "reload": broker.reload_record,
                              "capabilities": ["ui_exports_v1", "chunked_upload_v1", "chunked_response_v1", "artifact_download_v1", "viewer_mesh_v1", "h2_depth_edit_server_v1", "h2_native_begin_top_sketch_server_v1", "h2_native_sketch_populate_server_v1", "h2_native_extrude_populate_server_v1", "h2_extension_reload_server_v1"]})
 
+    async def reconcile_completed_top_begin(request):
+        """Confirm a manually completed, journaled Top selection without replaying it."""
+        denied = await auth(request)
+        if denied is not None:
+            return denied
+        try:
+            body = await read_body(request)
+        except (ValueError, BridgeError):
+            return JSONResponse({"status": "blocked", "reason": "Invalid reconciliation request"}, 400)
+        target = {"did": "4e078dec822b4e509616b1cb", "wid": "af0627de07264acf086e646a", "eid": "9a062f0eef8bb961f8c84f8e"}
+        if (not isinstance(body, dict) or set(body) != {"op_id", "tab_id"}
+                or not isinstance(body["op_id"], str)
+                or not re.fullmatch(r"begin-sketch-[a-f0-9]{32}", body["op_id"])
+                or type(body["tab_id"]) is not int or body["tab_id"] < 0):
+            return JSONResponse({"status": "blocked", "reason": "Invalid begin operation or exact tab"}, 400)
+        if not broker.unknown_write or broker.guard_invalid or broker.pending or broker.extension is None:
+            return JSONResponse({"status": "blocked", "reason": "Bridge safety state is not a single unresolved write"}, 409)
+        path = config.get("h2cad_journal")
+        if not isinstance(path, str) or not Path(path).is_absolute():
+            return JSONResponse({"status": "blocked", "reason": "Pinned journal unavailable"}, 409)
+        try:
+            first = await broker.dispatch({"kind": "state", "target": target, "tab_id": body["tab_id"]})
+            sketch = next(node for node in first["tree"]["children"]
+                          if node.get("featureId") == first.get("editingFeatureId")
+                          and node.get("featureType") == "newSketch")
+            plane = next(item for item in sketch["parameters"] if item.get("parameterId") == "sketchPlane")
+            query = plane["queries"][0]
+            resolved = await broker.dispatch({"kind": "native", "target": target, "tab_id": body["tab_id"],
+                                              "command": "ui.GBTUiGetQueryDataCall",
+                                              "body": {"elementId": target["eid"], "queries": [query],
+                                                       "qFunction": "", "additionalArguments": [],
+                                                       "queryNodeIdToInContextNodeId": {}}})
+            live = await broker.dispatch({"kind": "state", "target": target, "tab_id": body["tab_id"]})
+            if (first.get("element_microversion") != live.get("element_microversion")
+                    or first.get("editingFeatureId") != live.get("editingFeatureId")
+                    or first.get("tree") != live.get("tree")):
+                raise ValueError("Editor changed during read-only reconciliation")
+        except (BridgeError, ValueError, KeyError, TypeError, StopIteration, IndexError) as error:
+            return JSONResponse({"status": "blocked", "reason": f"Read-only Top evidence unavailable: {error}"}, 409)
+        async with broker.command_lock:
+            if not broker.unknown_write or broker.guard_invalid or broker.pending or broker.extension is None:
+                return JSONResponse({"status": "blocked", "reason": "Bridge safety state changed"}, 409)
+            try:
+                with sqlite3.connect(path, timeout=2, isolation_level=None) as db:
+                    db.execute("PRAGMA synchronous=FULL")
+                    db.execute("BEGIN IMMEDIATE")
+                    db.row_factory = sqlite3.Row
+                    rows = db.execute("SELECT * FROM writes WHERE state IN ('prepared','sent','unknown')").fetchall()
+                    row = db.execute("SELECT * FROM writes WHERE op_id=?", (body["op_id"],)).fetchone()
+                    if row is None or (row["state"] == "unknown" and (len(rows) != 1 or rows[0]["op_id"] != body["op_id"])):
+                        raise ValueError("Journal has another unresolved operation")
+                    before = json.loads(row["intent"]).get("before_state")
+                    if (row["action"] != "experimental_begin_top_sketch" or row["state"] not in {"unknown", "observed"}
+                            or row["target"] != "/".join(target.values())
+                            or not isinstance(before, dict)
+                            or before.get("element_microversion") != row["expected_revision"]):
+                        raise ValueError("Journal intent is not this unresolved Top begin")
+                    evidence = verify_completed_top_begin(before, live, resolved, target)
+                    if row["state"] == "unknown":
+                        db.execute("UPDATE writes SET state='observed', observation=?, updated_at=CURRENT_TIMESTAMP WHERE op_id=? AND state='unknown'",
+                                   (json.dumps(evidence, sort_keys=True), body["op_id"]))
+                    elif rows or json.loads(row["observation"] or "{}") != evidence:
+                        raise ValueError("Previously observed Top completion or another journal write differs")
+                    db.execute("COMMIT")
+            except (OSError, sqlite3.Error, ValueError, KeyError, TypeError) as error:
+                return JSONResponse({"status": "blocked", "reason": str(error)}, 409)
+            broker.unknown_write = False
+            try:
+                broker.save_guard()
+            except BridgeError as error:
+                broker.unknown_write = True
+                return JSONResponse({"status": "blocked", "reason": str(error)}, 409)
+            return JSONResponse({"status": "observed_manual_top_completion", "op_id": body["op_id"],
+                                 "evidence": evidence})
+
