+@pytest.mark.asyncio
+@pytest.mark.parametrize("fault", [None, "wrong_plane", "unrelated", "unbound", "other_edit"])
+async def test_manual_top_begin_reconciliation_requires_exact_semantic_readback(tmp_path, fault):
+    target = {"did": "4e078dec822b4e509616b1cb", "wid": "af0627de07264acf086e646a", "eid": "9a062f0eef8bb961f8c84f8e"}
+    op_id = "begin-sketch-" + "a" * 32
+    rollback = {"$type": "bsedit.GBTMRollback", "nodeId": "rollback"}
+    before = {"target": target, "connected": True, "editingFeatureId": None,
+              "element_microversion": "a" * 24,
+              "tree": {"$type": "bsedit.GBTMModel", "children": [rollback], "name": "Temp"}}
+    plane = {"$type": "bsedit.GBTMIndividualQuery", "deterministicIds": ["live-plane-id"], "queryString": ""}
+    sketch = {"$type": "bsedit.GBTMSketch", "featureType": "newSketch", "featureId": "fresh_0",
+              "nodeId": "fresh-node", "entities": [], "constraints": [],
+              "parameters": [{"$type": "bsedit.GBTMParameterQueryList", "parameterId": "sketchPlane", "queries": [plane]}]}
+    live = {"target": target, "connected": True, "editingFeatureId": "fresh_0",
+            "element_microversion": "b" * 24,
+            "tree": {"$type": "bsedit.GBTMModel", "children": [sketch, rollback], "name": "Temp"}}
+    if fault == "unrelated":
+        live["tree"]["name"] = "Modified"
+    if fault == "unbound":
+        sketch["parameters"][0]["queries"] = []
+    if fault == "other_edit":
+        live["editingFeatureId"] = "another_0"
+    query = {"result": {"$type": "ui.GBTUiGetQueryDataResponse", "queryData": [
+        {"deterministicIds": ["live-plane-id"], "featureId": "Front" if fault == "wrong_plane" else "Top",
+         "evaluationDetails": {"fullOperationId": "Top.planeOp", "status": 0}, "hasErrorEntity": False}]}}
+    journal = tmp_path / "intent.sqlite"
+    with sqlite3.connect(journal) as db:
+        db.execute("CREATE TABLE writes(op_id TEXT,target TEXT,expected_revision TEXT,action TEXT,logical_id TEXT,intent TEXT,state TEXT,receipt TEXT,observation TEXT,error TEXT,updated_at TEXT)")
+        db.execute("INSERT INTO writes(op_id,target,expected_revision,action,logical_id,intent,state,error) VALUES(?,?,?,?,?,?,?,?)",
+                   (op_id, "/".join(target.values()), before["element_microversion"], "experimental_begin_top_sketch",
+                    "Top", json.dumps({"before_state": before}), "unknown", "Top sketch action may have changed the editor but its bound plane is unconfirmed; outcome unknown."))
+    app = create_app({**CONFIG, "h2cad_journal": str(journal)})
+    broker = app.state.broker
+    broker.unknown_write = True
+    broker.save_guard()
+    broker.extension = object()
+    async def dispatch(job):
+        if job["kind"] == "state":
+            return json.loads(json.dumps(live))
+        assert job["kind"] == "native" and job["command"] == "ui.GBTUiGetQueryDataCall"
+        assert job["body"]["queries"] == [plane]
+        return query
+    broker.dispatch = dispatch
+    async with httpx.AsyncClient(transport=httpx.ASGITransport(app), base_url="http://127.0.0.1:8766", headers=AUTH) as client:
+        response = await client.post("/local/reconcile_completed_top_begin", json={"op_id": op_id, "tab_id": 17})
+    assert response.status_code == (200 if fault is None else 409)
+    with sqlite3.connect(journal) as db:
+        state = db.execute("SELECT state FROM writes WHERE op_id=?", (op_id,)).fetchone()[0]
+    assert state == ("observed" if fault is None else "unknown")
+    assert broker.unknown_write is (fault is not None)
+    if fault is None:
+        assert response.json()["evidence"]["top_query_semantically_resolved"] is True
+        assert response.json()["evidence"]["manual_top_completion"] is True
+
+
