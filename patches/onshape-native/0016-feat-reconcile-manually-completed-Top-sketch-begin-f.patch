+def verify_completed_top_begin(before, after, query_response, target):
+    """Verify one manually completed Top selection for a journaled begin intent."""
+    if (not isinstance(before, dict) or not isinstance(after, dict)
+            or before.get("target") != target or after.get("target") != target
+            or before.get("connected") is not True or after.get("connected") is not True
+            or not before.get("element_microversion")
+            or after.get("element_microversion") == before["element_microversion"]
+            or before.get("editingFeatureId") is not None):
+        raise ValueError("Begin target, connection, edit state or revision differs")
+    prior = before.get("tree")
+    current = after.get("tree")
+    if (not isinstance(prior, dict) or not isinstance(current, dict)
+            or prior.get("$type") != "bsedit.GBTMModel"
+            or current.get("$type") != "bsedit.GBTMModel"):
+        raise ValueError("Native Part Studio tree unavailable")
+    old_children = prior.get("children")
+    new_children = current.get("children")
+    if (not isinstance(old_children, list) or len(old_children) != 1
+            or old_children[0].get("$type") != "bsedit.GBTMRollback"
+            or not isinstance(new_children, list) or len(new_children) != 2):
+        raise ValueError("Begin must add exactly one feature to default history")
+    sketches = [node for node in new_children if isinstance(node, dict)
+                and node.get("featureType") == "newSketch"]
+    if (len(sketches) != 1 or [node for node in new_children if node is not sketches[0]] != old_children):
+        raise ValueError("Begin changed unrelated feature history")
+    sketch = sketches[0]
+    feature_id = sketch.get("featureId")
+    if (not isinstance(feature_id, str) or not feature_id
+            or after.get("editingFeatureId") != feature_id
+            or sketch.get("$type") != "bsedit.GBTMSketch"
+            or not sketch.get("nodeId") or sketch.get("entities") != []
+            or sketch.get("constraints") != []):
+        raise ValueError("Begin did not leave one blank active native sketch")
+    def metadata(tree):
+        value = json.loads(json.dumps({key: item for key, item in tree.items() if key != "children"}))
+        tolerance = (value.get("modelAnnotations") or {}).get("toleranceSchemaForParts")
+        if isinstance(tolerance, dict) and isinstance(tolerance.get("nodeId"), str) and tolerance["nodeId"]:
+            tolerance["nodeId"] = "<per-tab-tolerance-schema-node>"
+        return value
+    if metadata(prior) != metadata(current):
+        raise ValueError("Begin changed unrelated model metadata")
+    plane = [item for item in sketch.get("parameters", []) if isinstance(item, dict)
+             and item.get("parameterId") == "sketchPlane"]
+    if len(plane) != 1 or plane[0].get("$type") != "bsedit.GBTMParameterQueryList":
+        raise ValueError("Sketch plane parameter unavailable")
+    queries = plane[0].get("queries")
+    if (not isinstance(queries, list) or len(queries) != 1
+            or queries[0].get("$type") != "bsedit.GBTMIndividualQuery"
+            or not isinstance(queries[0].get("deterministicIds"), list)
+            or not queries[0]["deterministicIds"]):
+        raise ValueError("Sketch plane is not bound")
+    result = query_response.get("result") if isinstance(query_response, dict) else None
+    data = result.get("queryData") if isinstance(result, dict) else None
+    if (not isinstance(result, dict) or result.get("$type") != "ui.GBTUiGetQueryDataResponse"
+            or not isinstance(data, list) or len(data) != 1 or not isinstance(data[0], dict)
+            or data[0].get("deterministicIds") != queries[0]["deterministicIds"]
+            or data[0].get("featureId") != "Top"
+            or data[0].get("evaluationDetails", {}).get("fullOperationId") != "Top.planeOp"
+            or data[0]["evaluationDetails"].get("status") != 0
+            or data[0].get("hasErrorEntity") is not False):
+        raise ValueError("Bound sketch query did not resolve the Top plane")
+    return {"feature_id": feature_id, "feature_node_id": sketch["nodeId"],
+            "plane_query_ids": queries[0]["deterministicIds"],
+            "revision_before": before["element_microversion"],
+            "revision_after": after["element_microversion"],
+            "manual_top_completion": True, "blank_sketch_observed": True,
+            "top_query_semantically_resolved": True}
+
