+test('plane compares the captured full state root and diagnoses exact field differences',async()=>{
+  const temp={did:'4e078dec822b4e509616b1cb',wid:'af0627de07264acf086e646a',eid:'e'.repeat(24)};
+  const captured=JSON.parse(readFileSync(new URL('./fixtures/captured_plane37_draft.json',import.meta.url),'utf8'));
+  const specs={};
+  function collect(x){
+    if(!x || typeof x!=='object')return;
+    if(x.$type)specs[x.$type]={...(specs[x.$type]||{}),...Object.fromEntries(Object.entries(x).filter(([k])=>k!=='$type'))};
+    for(const v of Object.values(x))collect(v);
+  }
+  collect(captured.tree);
+  Object.assign(specs,{'tree.GBTNodeReference':{nodeId:''},'diff.GBTTreeEditChange':{oldNode:null,newNode:null},
+    'ui.GBTUiSpecifyFeature':{elementId:'',featureNodeId:'',featureChange:null,sequenceId:0,selectionMicroversion:null,inContextEntitiesToAdd:null,editDescription:''},
+    'ui.GBTUiCommit':{elementId:'',featureNodeId:'',editDescription:''}});
+  const types={};
+  for(const [name,defaults] of Object.entries(specs))types[name]=class{
+    constructor(){Object.assign(this,structuredClone(defaults));}getMessageName(){return name;}getClassId(){return 1;}
+  };
+  function typed(x){
+    if(!x||typeof x!=='object')return x;
+    if(Array.isArray(x))return x.map(typed);
+    const out=x.$type?Object.create(types[x.$type].prototype):{};
+    for(const [k,v]of Object.entries(x))if(k!=='$type')out[k]=typed(v);
+    return out;
+  }
+  for(const fault of [null,'missing','null','value']){
+    let revision='a'.repeat(24),editing=captured.editingFeatureId;
+    const primary=typed(captured.tree),cache=typed(captured.tree);
+    cache.children[0].name='different cache root';
+    const expected=structuredClone(captured.tree);
+    const plane=expected.children.find(n=>n.featureId===editing);
+    plane.parameters.find(p=>p.parameterId==='offset').expression='20 mm';
+    plane.parameters.find(p=>p.parameterId==='offset').value=20;
+    const baseline=structuredClone(captured.tree);
+    if(fault==='missing')delete baseline.children[0].suppressionState;
+    if(fault==='null')primary.children[0].suppressionState=undefined;
+    if(fault==='value')baseline.children[0].name='changed';
+    const modules=setup(undefined,false,revision,cache,types,m=>{
+      if(m.getMessageName()==='ui.GBTUiSpecifyFeature'){
+        const i=primary.children.findIndex(n=>n.featureId===editing);primary.children[i]=m.featureChange.newNode;
+      }
+      if(m.getMessageName()==='ui.GBTUiCommit')revision='b'.repeat(24);
+      return {errorEnum:0};
+    },temp);
+    modules.__controller.documentModel.get=k=>k==='microversionId'?{theId:micro}:{definition:{assembly:primary},
+      get:x=>x==='microversionId'?revision:x==='idEditingFeature'?editing:null};
+    globalThis.document={querySelectorAll:()=>[{getClientRects:()=>[1],getAttribute:()=>null,classList:{contains:()=>false},click:()=>{editing=null;}}]};
+    const state=await pageCommand({kind:'state',target:temp});
+    assert.equal(state.native_root_source,'element_definition_assembly');
+    if(!fault)assert.deepEqual(JSON.parse(JSON.stringify(state.tree)),captured.tree);
+    const result=await pageCommand({kind:'partstudio_populate_plane',target:temp,op_id:'plane-'+'a'.repeat(32),
+      expected_element_microversion:'a'.repeat(24),plane_edit:{feature_id:captured.editingFeatureId,
+        expression:'20 mm',value:20,opposite_direction:false,before_tree:baseline,expected_tree:expected}});
+    if(fault){
+      assert.equal(result.write_stage,'pre_dispatch');assert.equal(sent.length,0);
+      assert.match(result.error,/Plane baseline changed before dispatch/);
+      assert.match(result.error,/root_source/);assert.ok(result.error.length<600);
+      if(fault==='missing'||fault==='null')assert.match(result.error,/suppressionState/);
+      if(fault==='null'){assert.match(result.error,/undefined/);assert.match(result.error,/null/);}
+    }else{
+      assert.equal(result.definition_candidate,true,JSON.stringify(result));assert.equal(sent.length,2);
+      assert.equal(cache.children[0].name,'different cache root');
+      const saved=await pageCommand({kind:'state',target:temp});assert.deepEqual(JSON.parse(JSON.stringify(saved.tree)),expected);
+    }
+  }
+});
