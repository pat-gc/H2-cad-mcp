+def verify_partial_top_begin(before, after, target):
+    """Resolve a journaled toolbar action that saved only a blank, unbound sketch."""
+    if (not isinstance(before, dict) or not isinstance(after, dict)
+            or before.get("target") != target or after.get("target") != target
+            or before.get("connected") is not True or after.get("connected") is not True
+            or before.get("editingFeatureId") is not None or after.get("editingFeatureId") is not None
+            or not before.get("element_microversion")
+            or before["element_microversion"] == after.get("element_microversion")):
+        raise ValueError("Partial Top begin target, connection, lifecycle or revision differs")
+    prior, current = before.get("tree"), after.get("tree")
+    if (not isinstance(prior, dict) or not isinstance(current, dict)
+            or prior.get("$type") != "bsedit.GBTMModel"
+            or current.get("$type") != "bsedit.GBTMModel"):
+        raise ValueError("Partial Top begin model tree unavailable")
+    old, new = prior.get("children"), current.get("children")
+    if (not isinstance(old, list) or len(old) != 1
+            or old[0].get("$type") != "bsedit.GBTMRollback"
+            or not isinstance(new, list) or len(new) != 2 or new[1] != old[0]):
+        raise ValueError("Partial Top begin changed default or unrelated history")
+    sketch = new[0]
+    if (not isinstance(sketch, dict) or sketch.get("$type") != "bsedit.GBTMSketch"
+            or sketch.get("featureType") != "newSketch"
+            or not isinstance(sketch.get("featureId"), str) or not sketch["featureId"]
+            or not isinstance(sketch.get("nodeId"), str) or not sketch["nodeId"]
+            or sketch.get("entities") != [] or sketch.get("constraints") != []
+            or sketch.get("suppressed") is not False):
+        raise ValueError("Partial Top begin is not one saved blank sketch")
+    plane = [p for p in sketch.get("parameters", []) if isinstance(p, dict)
+             and p.get("parameterId") == "sketchPlane"]
+    if (len(plane) != 1 or plane[0].get("$type") != "bsedit.GBTMParameterQueryList"
+            or plane[0].get("queries") != []):
+        raise ValueError("Partial Top begin plane was bound or changed")
+    if _tab_tolerance_node_normalized({k: v for k, v in prior.items() if k != "children"}) != \
+            _tab_tolerance_node_normalized({k: v for k, v in current.items() if k != "children"}):
+        raise ValueError("Partial Top begin changed unrelated model metadata")
+    return {"outcome": "partial_failed", "feature_id": sketch["featureId"],
+            "feature_node_id": sketch["nodeId"], "revision_before": before["element_microversion"],
+            "revision_after": after["element_microversion"], "blank_sketch_observed": True,
+            "top_query_semantically_resolved": False, "source_geometry_created": False,
+            "unrelated_tree_preserved": True}
