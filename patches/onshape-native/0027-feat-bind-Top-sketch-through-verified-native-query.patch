+  async function bindVerifiedTopPlane(sketch, modelRoot, expectedRevision) {
+    const current = modelRoot();
+    const top = current?.defaultFeatures?.children?.filter(node=>node?.featureId==="Top" &&
+      node?.featureType==="defaultPlane");
+    const plane = sketch?.parameters?.filter(p=>p?.parameterId==="sketchPlane");
+    if (top?.length!==1 || !top[0].nodeId || plane?.length!==1 ||
+        plane[0].getMessageName?.()!=="bsedit.GBTMParameterQueryList" ||
+        !plane[0].nodeId || plane[0].queries?.length!==0)
+      throw new Error("The active sketch lacks one empty plane field or exact default Top feature.");
+    const make = (name, fields={}) => hydrate({$type:name,...plain(fields)});
+    // JDC is a candidate observed for default Top, never a captured node ID.
+    // Resolve it in this exact current editor before it may enter a write.
+    const query = make("bsedit.GBTMIndividualQuery",{deterministicIds:["JDC"]});
+    if (!query.nodeId || query.deterministicIds?.length!==1)
+      throw new Error("Runtime did not allocate a fresh Top query node.");
+    const sameEditor = () => controller.connection?.isClosed?.()===false &&
+      controller.getActiveElementTabId()===target.eid &&
+      location.pathname===`/documents/${target.did}/w/${target.wid}/e/${target.eid}` &&
+      elementModel?.get("idEditingFeature")===sketch.featureId &&
+      getElementMicroversion()===expectedRevision;
+    if (!sameEditor()) throw new Error("Top editor changed before query resolution; outcome unknown.");
+    const resolved = plain(await controller.elementConnection.callAndPromise(make("ui.GBTUiGetQueryDataCall",{
+      elementId:target.eid,queries:[query],qFunction:"",additionalArguments:[],
+      queryNodeIdToInContextNodeId:{}})));
+    const item = resolved?.queryData?.[0];
+    if (resolved?.$type!=="ui.GBTUiGetQueryDataResponse" || resolved.queryData?.length!==1 ||
+        JSON.stringify(item?.deterministicIds)!==JSON.stringify(query.deterministicIds) ||
+        item?.featureId!=="Top" || item?.selectionName!=="Face" ||
+        item?.evaluationDetails?.fullOperationId!=="Top.planeOp" ||
+        item?.evaluationDetails?.entityType!==2 || item?.evaluationDetails?.status!==0 ||
+        item?.hasErrorEntity!==false || item?.outsideExactDependencies!==false)
+      throw new Error("Current candidate does not resolve the unique Top face; outcome unknown.");
+    if (!sameEditor() || modelRoot()?.children?.filter(node=>node?.featureId===sketch.featureId)?.length!==1)
+      throw new Error("Top editor changed during query resolution; outcome unknown.");
+    const changedPlane = hydrate({...plain(plane[0]),queries:[plain(query)]});
+    const changedSketch = hydrate({...plain(sketch),parameters:sketch.parameters.map(
+      p=>p===plane[0]?plain(changedPlane):plain(p))});
+    const change = make("diff.GBTTreeEditChange",{
+      oldNode:make("tree.GBTNodeReference",{nodeId:sketch.nodeId}),newNode:changedSketch});
+    controller.__onshapeNativeIncompleteFeatureEdit.stage="specify-top-plane";
+    h2CadRpcSent=true;
+    const reply = await controller.elementConnection.callAndPromise(make("ui.GBTUiSpecifyFeature",{
+      elementId:target.eid,featureNodeId:sketch.nodeId,featureChange:change,sequenceId:1,
+      selectionMicroversion:null,inContextEntitiesToAdd:null,
+      editDescription:"Bind H2 source sketch to verified Top plane"}));
+    if (reply?.error || reply?.errorCode || reply?.errorEnum)
+      throw new Error("Native Top-plane definition rejected; outcome unknown.");
+    for (let attempt=0;attempt<50;attempt++) {
+      const now = modelRoot()?.children?.filter(node=>node?.featureId===sketch.featureId);
+      const bound = now?.[0]?.parameters?.filter(p=>p?.parameterId==="sketchPlane");
+      const actual = bound?.[0]?.queries?.[0];
+      if (controller.connection?.isClosed?.()===false &&
+          controller.getActiveElementTabId()===target.eid &&
+          location.pathname===`/documents/${target.did}/w/${target.wid}/e/${target.eid}` &&
+          elementModel?.get("idEditingFeature")===sketch.featureId &&
+          now?.length===1 && now[0].nodeId===sketch.nodeId &&
+          now[0].entities?.length===0 && now[0].constraints?.length===0 &&
+          bound?.length===1 && bound[0].queries?.length===1 &&
+          actual?.deterministicIds?.length===1 && actual.deterministicIds[0]==="JDC" &&
+          getElementMicroversion()!==expectedRevision)
+        return {plane_query_ids:actual.deterministicIds,
+          plane_query_node_id:actual.nodeId,verified_top_feature_id:"Top"};
+      await new Promise(resolve=>setTimeout(resolve,100));
+    }
+    throw new Error("Typed Top-plane definition was sent but binding is unconfirmed; outcome unknown.");
+  }
   if (job.kind === "partstudio_begin_top_sketch") {
     if (target.did !== "4e078dec822b4e509616b1cb" ||
         target.wid !== "af0627de07264acf086e646a" ||
@@ -387,27 +453,13 @@ export async function pageCommand(job) {
