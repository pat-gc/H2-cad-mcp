-          element_microversion_before:job.expected_element_microversion,
-          element_microversion_after:getElementMicroversion(),
-          initiation_candidate:true,verification:"Independent editor state required"};
-      }
-      await new Promise(resolve=>setTimeout(resolve,100));
-    }
-    throw new Error("Top sketch action may have changed the editor but its bound plane is unconfirmed; outcome unknown.");
