+@pytest.mark.asyncio
+@pytest.mark.parametrize("fault", [None, "active", "wrong_plane", "wrong_fix", "wrong_depth", "unrelated"])
+async def test_saved_source_sketch_reconciliation_requires_exact_intent_and_definition(tmp_path, fault):
+    target = {"did": "4e078dec822b4e509616b1cb", "wid": "af0627de07264acf086e646a", "eid": "9a062f0eef8bb961f8c84f8e"}
+    op_id = "sketch-" + "a" * 32
+    rollback = {"$type": "bsedit.GBTMRollback", "nodeId": "rollback"}
+    plane = {"$type": "bsedit.GBTMParameterQueryList", "parameterId": "sketchPlane",
+             "queries": [{"$type": "bsedit.GBTMIndividualQuery", "deterministicIds": ["live-top"], "queryString": ""}]}
+    blank = {"$type": "bsedit.GBTMSketch", "featureType": "newSketch", "featureId": "fresh_0",
+             "nodeId": "fresh-node", "entities": [], "constraints": [], "parameters": [plane]}
+    before = {"target": target, "connected": True, "editingFeatureId": "fresh_0",
+              "element_microversion": "a" * 24,
+              "tree": {"$type": "bsedit.GBTMModel", "children": [blank, rollback], "name": "Temp"}}
+    sketch = json.loads(json.dumps(blank))
+    for side, px, py, dx, dy, size in (("bottom", .02, 0, 1, 0, .04),
+                                      ("right", .04, .01, 0, 1, .02),
+                                      ("top", .02, .02, 1, 0, .04),
+                                      ("left", 0, .01, 0, 1, .02)):
+        ident = "box." + side
+        sketch["entities"].append({"$type": "bsedit.GBTMSketchCurveSegment", "entityId": ident,
+                                   "startPointId": ident + ".start", "endPointId": ident + ".end",
+                                   "isConstruction": False, "startParam": -size/2, "endParam": size/2,
+                                   "geometry": {"$type": "bsedit.GBTCurveGeometryLine", "pntX": px,
+                                                "pntY": py, "dirX": dx, "dirY": dy}})
+    types = {"fixedOrigin": 16, "perpendicular": 5, "parallel.1": 2, "parallel.2": 2,
+             "horizontal": 4, **{f"corner{i}": 1 for i in range(4)}, "width": 11, "height": 11}
+    links = {"fixedOrigin": ("bottom.start", None), "perpendicular": ("top", "left"),
+             "parallel.1": ("bottom", "top"), "parallel.2": ("left", "right"),
+             "horizontal": ("top", None), "corner0": ("bottom.start", "left.start"),
+             "corner1": ("bottom.end", "right.start"), "corner2": ("top.start", "left.end"),
+             "corner3": ("top.end", "right.end"), "width": ("top", None), "height": ("right", None)}
+    for name, kind in types.items():
+        first, second = links[name]
+        params = [{"$type": "bsedit.GBTMParameterString", "parameterId": "localFirst",
+                   "value": "box." + first}]
+        if second:
+            params.append({"$type": "bsedit.GBTMParameterString", "parameterId": "localSecond",
+                           "value": "box." + second})
+        if name in {"width", "height"}:
+            mm = 40 if name == "width" else 20
+            params.extend([{"$type": "bsedit.GBTMParameterEnum", "parameterId": "direction", "value": "MINIMUM"},
+                           {"$type": "bsedit.GBTMParameterQuantity", "parameterId": "length",
+                            "value": mm, "units": "millimeter", "expression": f"{mm} mm"},
+                           {"$type": "bsedit.GBTMParameterEnum", "parameterId": "alignment", "value": "ALIGNED"},
+                           {"$type": "bsedit.GBTMParameterQuantity", "parameterId": "labelRatio", "value": .5},
+                           {"$type": "bsedit.GBTMParameterQuantity", "parameterId": "labelDistance", "value": .01}])
+        sketch["constraints"].append({"$type": "bsedit.GBTMSketchConstraint", "entityId": "box." + name,
+                                      "constraintType": kind, "parameters": params})
+    live = {"target": target, "connected": True, "editingFeatureId": None,
+            "element_microversion": "b" * 24,
+            "tree": {"$type": "bsedit.GBTMModel", "children": [sketch, rollback], "name": "Temp"}}
+    if fault == "active": live["editingFeatureId"] = "fresh_0"
+    if fault == "wrong_fix": sketch["constraints"][0]["parameters"][0]["value"] = "box.top.start"
+    if fault == "wrong_depth":
+        next(p for p in sketch["constraints"][-1]["parameters"] if p["parameterId"] == "length")["expression"] = "25 mm"
+    if fault == "unrelated": live["tree"]["name"] = "Other"
+    query = {"result": {"$type": "ui.GBTUiGetQueryDataResponse", "queryData": [
+        {"deterministicIds": ["live-top"], "featureId": "Front" if fault == "wrong_plane" else "Top",
+         "evaluationDetails": {"fullOperationId": "Top.planeOp", "status": 0}, "hasErrorEntity": False}]}}
+    journal = tmp_path / "intent.sqlite"
+    with sqlite3.connect(journal) as db:
+        db.execute("CREATE TABLE writes(op_id TEXT,target TEXT,expected_revision TEXT,action TEXT,logical_id TEXT,intent TEXT,state TEXT,receipt TEXT,observation TEXT,error TEXT,updated_at TEXT)")
+        db.execute("INSERT INTO writes(op_id,target,expected_revision,action,logical_id,intent,state,error) VALUES(?,?,?,?,?,?,?,?)",
+                   (op_id, "/".join(target.values()), before["element_microversion"], "experimental_sketch_populate",
+                    "Outline", json.dumps({"before_state": before, "feature_id": "fresh_0", "entity_prefix": "box",
+                                            "blueprint": {"plane_name": "Top", "rectangle_m": [0, 0, .04, .02]}}),
+                    "unknown", "Sketch command acknowledged but saved definition/idle state is unconfirmed; outcome unknown."))
+    app = create_app({**CONFIG, "h2cad_journal": str(journal)})
+    broker = app.state.broker
+    broker.unknown_write = True
+    broker.save_guard()
+    broker.extension = object()
+    broker.extension_info = {"capabilities": ["h2_native_fixed_origin_page_v1"]}
+    async def dispatch(job):
+        if job["kind"] == "state": return json.loads(json.dumps(live))
+        assert job["kind"] == "native" and job["body"]["queries"] == [plane["queries"][0]]
+        return query
+    broker.dispatch = dispatch
+    async with httpx.AsyncClient(transport=httpx.ASGITransport(app), base_url="http://127.0.0.1:8766", headers=AUTH) as client:
+        response = await client.post("/local/reconcile_completed_source_sketch", json={"op_id": op_id, "tab_id": 17})
+    assert response.status_code == (200 if fault is None else 409)
+    with sqlite3.connect(journal) as db:
+        state = db.execute("SELECT state FROM writes WHERE op_id=?", (op_id,)).fetchone()[0]
+    assert state == ("observed" if fault is None else "unknown")
+    assert broker.unknown_write is (fault is not None)
+    if fault is None:
+        assert response.json()["evidence"]["manual_commit_completion"] is True
+        assert response.json()["evidence"]["constraint_graph_evidence"].startswith("inferred_")
+
