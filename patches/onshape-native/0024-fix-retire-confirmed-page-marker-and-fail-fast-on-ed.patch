--- a/tests/test_bridge.py
+++ b/tests/test_bridge.py
@@ -368,7 +368,7 @@ def source_extrude_states():
     return target, before, expected, after, query
 
 
-@pytest.mark.parametrize("fault", [None, "active", "wrong_region", "wrong_depth", "unrelated", "same_revision"])
+@pytest.mark.parametrize("fault", [None, "tab_tolerance", "active", "wrong_region", "wrong_depth", "unrelated", "same_revision"])
