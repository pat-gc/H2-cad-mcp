diff --git a/extension/page-adapter.js b/extension/page-adapter.js
index f40b33c..36a5fb0 100644
--- a/extension/page-adapter.js
+++ b/extension/page-adapter.js
@@ -213,6 +213,10 @@ export async function pageCommand(job) {
     return value;
   }
   function state() {
+    // The loopback extension may be connected while the Onshape editor socket
+    // is not. Refuse before touching model-tree getters in that state.
+    if (controller.connection?.isClosed?.() !== false)
+      throw new Error("Onshape editor disconnected; native state unavailable. Wait for editor reconnect.");
     const cache = controller.documentClientCache;
     const definition = elementModel?.definition;
     const root = definition?.assembly || cache?.getModelTreeState(target.eid)?.diffableModelTree?.getRoot();
@@ -270,7 +274,21 @@ export async function pageCommand(job) {
         completeness: "Assembly definitions may be lazy. Use GBTUiAssemblyTreeItemDefinitionRequest or the full REST assembly for specific mate parameters."} : {}),
       revision_check: "client preflight only; not atomic against collaborators"});
   }
-  if (job.kind === "state") return state();
+  if (job.kind === "state") {
+    const marker = controller.__onshapeNativeIncompleteFeatureEdit;
+    if (job.retire_acknowledged_op_id && marker?.stage === "await-saved-readback" &&
+        marker.op_id === job.retire_acknowledged_op_id &&
+        controller.connection?.isClosed?.() === false &&
+        elementModel?.get("idEditingFeature") == null &&
+        getElementMicroversion() !== marker.expected_revision &&
+        location.pathname === `/documents/${target.did}/w/${target.wid}/e/${target.eid}`) {
+      const root = controller.documentClientCache?.getModelTreeState(target.eid)?.diffableModelTree?.getRoot();
+      const matches = root?.children?.filter(node=>node?.featureId===marker.feature_id);
+      if (matches?.length === 1 && matches[0].nodeId === marker.node_id)
+        delete controller.__onshapeNativeIncompleteFeatureEdit;
+    }
+    return state();
+  }
   if (job.kind === "ui_inspect") {
     const nodes = [...document.querySelectorAll('button,input,select,textarea,[role="button"],[role="tab"],[role="menuitem"],[contenteditable="true"]')]
       .filter(el => el.getClientRects().length && getComputedStyle(el).visibility !== "hidden").slice(0, 500);
@@ -469,7 +487,8 @@ export async function pageCommand(job) {
       editDescription:"Insert feature : H2 rectangle sketch"});
     if (typeof controller.elementConnection?.callAndPromise !== "function")
       throw new Error("Native editor connection unavailable.");
-    controller.__onshapeNativeIncompleteFeatureEdit = {node_id:sketch.nodeId,op_id:job.op_id,stage:"prepared"};
+    controller.__onshapeNativeIncompleteFeatureEdit = {node_id:sketch.nodeId,feature_id:edit.feature_id,
+      expected_revision:job.expected_element_microversion,op_id:job.op_id,stage:"prepared"};
     let activeGraph;
     for (const [index,command] of [message,graphCall,commit].entries()) {
       if (controller.connection?.isClosed?.() !== false || controller.getActiveElementTabId() !== target.eid ||
@@ -597,7 +616,8 @@ export async function pageCommand(job) {
       editDescription:"Insert feature : H2 source extrusion"});
     if (typeof controller.elementConnection?.callAndPromise !== "function")
       throw new Error("Native editor connection unavailable.");
-    controller.__onshapeNativeIncompleteFeatureEdit = {node_id:feature.nodeId,op_id:job.op_id,stage:"prepared"};
+    controller.__onshapeNativeIncompleteFeatureEdit = {node_id:feature.nodeId,feature_id:edit.feature_id,
+      expected_revision:job.expected_element_microversion,op_id:job.op_id,stage:"prepared"};
     for (const [index,command] of [specify,commit].entries()) {
       if (controller.connection?.isClosed?.() !== false || controller.getActiveElementTabId() !== target.eid ||
           location.pathname !== `/documents/${target.did}/w/${target.wid}/e/${target.eid}`)
