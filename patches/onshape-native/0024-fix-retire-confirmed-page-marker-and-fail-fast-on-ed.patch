             "solid_geometry_verified": False, "unrelated_tree_preserved": True}
 
 
+def _tab_tolerance_node_normalized(tree):
+    """Ignore only the observed per-tab tolerance schema node identity."""
+    value = json.loads(json.dumps(tree))
+    tolerance = (value.get("modelAnnotations") or {}).get("toleranceSchemaForParts")
+    if isinstance(tolerance, dict) and isinstance(tolerance.get("nodeId"), str) and tolerance["nodeId"]:
+        tolerance["nodeId"] = "<per-tab-tolerance-schema-node>"
+    return value
+
+
 def verify_saved_source_extrude(before, expected_tree, after, query_response,
                                 target, sketch_id, source_depth_mm):
     """Verify delayed saved native definition against one durable source intent."""
@@ -257,7 +266,8 @@ def verify_saved_source_extrude(before, expected_tree, after, query_response,
             or after.get("editingFeatureId") is not None
             or not before.get("element_microversion")
             or after.get("element_microversion") == before["element_microversion"]
-            or not isinstance(expected_tree, dict) or after.get("tree") != expected_tree):
+            or not isinstance(expected_tree, dict) or not isinstance(after.get("tree"), dict)
+            or _tab_tolerance_node_normalized(after["tree"]) != _tab_tolerance_node_normalized(expected_tree)):
         raise ValueError("Saved extrusion differs from exact journaled target or expected tree")
     prior = before.get("tree")
     if (not isinstance(prior, dict) or prior.get("$type") != "bsedit.GBTMModel"
@@ -998,7 +1008,8 @@ def create_app(config=None):
                                               "body": {"elementId": target["eid"], "queries": [query],
