     if fault == "active": after["editingFeatureId"] = "extrude_0"
@@ -376,7 +376,11 @@ def test_saved_source_extrusion_verifier_preserves_exact_tree_and_region(fault):
     if fault == "wrong_depth": after["tree"]["children"][1]["parameters"][-1]["value"] = 6
     if fault == "unrelated": after["tree"]["children"][0]["nodeId"] = "changed"
     if fault == "same_revision": after["element_microversion"] = before["element_microversion"]
-    if fault is None:
+    if fault == "tab_tolerance":
+        before["tree"]["modelAnnotations"] = {"toleranceSchemaForParts": {"nodeId": "old-tab", "items": [1]}}
+        expected["modelAnnotations"] = {"toleranceSchemaForParts": {"nodeId": "old-tab", "items": [1]}}
